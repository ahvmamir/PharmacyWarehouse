@page "/admin/roles"
@attribute [Authorize]
@inject UsersClient UsersApi
@inject ToastService Toasts

<PageTitle>نقش‌ها و مجوزها | انبار داروخانه</PageTitle>

<RequirePermission Permission="@Permissions.RolesManage">
<div class="page-head">
    <div>
        <h1>نقش‌ها و مجوزها</h1>
        <p>هر کاربر یک نقش دارد. نقش مدیر همه‌ی مجوزها را دارد و تغییر نمی‌کند.</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="NewRole"><AppIcon Name="plus" /> نقش جدید</button>
</div>

@if (_error is not null)
{
    <div class="form-alert" role="alert"><AppIcon Name="warning" /> <span>@_error</span></div>
}

@if (_roles is null)
{
    @if (_error is null)
    {
        <div class="loading-line">در حال بارگذاری…</div>
    }
}
else
{
    <div class="table-card">
        <table class="data-table">
            <thead><tr><th>نقش</th><th>کاربران</th><th>مجوزها</th><th></th></tr></thead>
            <tbody>
                @foreach (var role in _roles)
                {
                    <tr @key="role.Id">
                        <td style="font-weight:600;">@Roles.Label(role.Name)</td>
                        <td>@JalaliDate.ToPersianDigits(role.UserCount.ToString())</td>
                        <td>@(role.IsLocked ? "همه‌ی مجوزها" : $"{JalaliDate.ToPersianDigits(role.Permissions.Length.ToString())} از {JalaliDate.ToPersianDigits(Permissions.All.Count.ToString())}")</td>
                        <td style="text-align:left;white-space:nowrap;">
                            @if (!role.IsLocked)
                            {
                                <span class="row-actions">
                                    <button type="button" class="btn btn-sm btn-ghost" @onclick="() => EditRole(role)"><AppIcon Name="edit" Size="15" /> ویرایش</button>
                                    <button type="button" class="icon-button danger" title="حذف" aria-label="حذف @role.Name" @onclick="() => _deleting = role"><AppIcon Name="trash" Size="16" /></button>
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_editing)
{
    <ModalDialog Title="@(_editId is null ? "نقش جدید" : "ویرایش نقش")" Wide="true" OnClose="() => _editing = false">
        <EditForm Model="this" OnSubmit="SaveAsync">
            <div class="form-field mb-3">
                <label for="role-name">نام نقش <span class="required">*</span></label>
                <input id="role-name" class="form-control" style="max-width:320px;" @bind="_name" />
            </div>

            <div class="form-field mb-3">
                <label for="role-copy">شروع از مجوزهای یک نقش دیگر</label>
                <select id="role-copy" class="form-control" style="max-width:320px;" @onchange="CopyFrom">
                    <option value="">— بدون کپی —</option>
                    @foreach (var other in _roles!.Where(r => r.Id != _editId))
                    {
                        <option value="@other.Id" selected="@(_copyFrom == other.Id)">@Roles.Label(other.Name)</option>
                    }
                </select>
                <span class="cell-sub">مجوزهای انتخاب‌شده را جایگزین می‌کند؛ ذخیره نشده تا دکمه‌ی «ذخیره».</span>
            </div>

            @foreach (var group in Permissions.All.GroupBy(p => p.Group))
            {
                var keys = group.Select(p => p.Key).ToArray();
                var chosen = keys.Count(_selected.Contains);
                <div class="permission-group role-perm-group" @key="group.Key">
                    <div class="role-perm-head">
                        <h3>@group.Key <span class="muted">(@JalaliDate.ToPersianDigits(chosen.ToString()) از @JalaliDate.ToPersianDigits(keys.Length.ToString()))</span></h3>
                        <span class="row-actions">
                            <button type="button" class="btn btn-sm btn-ghost" disabled="@(chosen == keys.Length)" @onclick="() => SetGroup(keys, true)">انتخاب همه</button>
                            <button type="button" class="btn btn-sm btn-ghost" disabled="@(chosen == 0)" @onclick="() => SetGroup(keys, false)">هیچ‌کدام</button>
                        </span>
                    </div>
                    @foreach (var permission in group)
                    {
                        <div class="form-check role-perm-item" @key="permission.Key">
                            <input id="@permission.Key" class="form-check-input" type="checkbox" checked="@_selected.Contains(permission.Key)"
                                   @onchange="e => Toggle(permission.Key, e.Value is true)" />
                            <label class="form-check-label" for="@permission.Key">
                                @permission.Label
                                @if (permission.Description.Length > 0)
                                {
                                    <span class="cell-sub">@permission.Description</span>
                                }
                            </label>
                        </div>
                    }
                </div>
            }

            @{
                var added = Permissions.All.Where(p => _selected.Contains(p.Key) && !_original.Contains(p.Key)).ToList();
                var removed = Permissions.All.Where(p => !_selected.Contains(p.Key) && _original.Contains(p.Key)).ToList();
            }
            <div class="role-diff" aria-live="polite">
                <strong>تغییرات ذخیره‌نشده</strong>
                @if (added.Count == 0 && removed.Count == 0)
                {
                    <span class="muted">بدون تغییر.</span>
                }
                else
                {
                    @foreach (var p in added)
                    {
                        <div class="diff-added">+ @p.Label</div>
                    }
                    @foreach (var p in removed)
                    {
                        <div class="diff-removed">− @p.Label</div>
                    }
                }
            </div>

            @if (_dialogError is not null)
            {
                <div class="form-alert mt-3 mb-0" role="alert">@_dialogError</div>
            }

            <div class="modal-actions">
                <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "در حال ذخیره…" : "ذخیره")</button>
                <button type="button" class="btn btn-quiet" @onclick="() => _editing = false">انصراف</button>
            </div>
        </EditForm>
    </ModalDialog>
}

@if (_deleting is { } target)
{
    <DeleteDialog Title="حذف نقش" ItemName="@Roles.Label(target.Name)"
                  Load="() => UsersApi.RoleDependenciesAsync(target.Id)"
                  Delete="() => UsersApi.DeleteRoleAsync(target.Id)"
                  OnCancel="() => _deleting = null"
                  OnDeleted="OnDeletedAsync" />
}
</RequirePermission>

@code {
    private List<RoleItem>? _roles;
    private string? _error;
    private string? _dialogError;
    private bool _editing;
    private bool _busy;
    private Guid? _editId;
    private string _name = "";
    private HashSet<string> _selected = [];
    private HashSet<string> _original = [];
    private Guid? _copyFrom;
    private RoleItem? _deleting;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await UsersApi.RolesAsync();
        if (result.IsSuccess)
        {
            _roles = result.Value;
            _error = null;
        }
        else
        {
            _error = result.ErrorMessage;
        }
    }

    private void NewRole()
    {
        _editId = null;
        _name = "";
        _selected = [Permissions.StockView];
        _original = [];
        _copyFrom = null;
        _dialogError = null;
        _editing = true;
    }

    private void EditRole(RoleItem role)
    {
        _editId = role.Id;
        _name = role.Name;
        _selected = role.Permissions.ToHashSet();
        _original = role.Permissions.ToHashSet();
        _copyFrom = null;
        _dialogError = null;
        _editing = true;
    }

    private void SetGroup(string[] keys, bool on)
    {
        foreach (var key in keys)
        {
            if (on) _selected.Add(key);
            else _selected.Remove(key);
        }
    }

    private void CopyFrom(ChangeEventArgs e)
    {
        _copyFrom = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        var source = _roles?.FirstOrDefault(r => r.Id == _copyFrom);
        if (source is null) return;

        // نقش قفل‌شده (مدیر) همه‌ی مجوزها را دارد.
        _selected = (source.IsLocked ? Permissions.All.Select(p => p.Key) : source.Permissions).ToHashSet();
    }

    private void Toggle(string key, bool on)
    {
        if (on) _selected.Add(key);
        else _selected.Remove(key);
    }

    private async Task SaveAsync()
    {
        if (_busy) return;

        _busy = true;
        _dialogError = null;
        try
        {
            var result = await UsersApi.SaveRoleAsync(_editId, new SaveRoleRequest { Name = _name, Permissions = _selected.ToArray() });
            if (!result.IsSuccess)
            {
                _dialogError = result.ErrorMessage;
                return;
            }

            _editing = false;
            Toasts.Show("ذخیره شد.");
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnDeletedAsync()
    {
        Toasts.Show("نقش حذف شد.");
        _deleting = null;
        await LoadAsync();
    }
}
