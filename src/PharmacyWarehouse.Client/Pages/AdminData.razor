@page "/admin/data"
@attribute [Authorize]
@inject BackupClient BackupApi
@inject ApiAuthenticationStateProvider Session
@inject ToastService Toasts
@inject IJSRuntime JS

<PageTitle>پشتیبان | داروبار</PageTitle>

<div class="page-head">
    <div>
        <h1>پشتیبان</h1>
        <p>هر روز یک نسخه دانلود کنید و روی لپ‌تاپ خودتان نگه دارید. پشتیبان شبانه‌ی سرور جای آن را نمی‌گیرد.</p>
    </div>
</div>

<RequirePermission Permission="@Permissions.BackupDownload">
    <section class="card-emu">
        <div class="card-emu-body">
            <div class="linked-item">
                <span style="flex:1;">
                    <strong>فایل کامل دیتابیس (.db)</strong>
                    <span class="cell-sub">همه‌چیز، با تاریخچه و کاربران. جای امن نگهش دارید؛ hash رمزها در آن است. بازگردانی طبق <code>docs\deploy.md</code>.</span>
                </span>
                <button type="button" class="btn btn-quiet" disabled="@_busy" @onclick="SaveAsync"><AppIcon Name="download" /> دانلود</button>
            </div>
        </div>
    </section>
</RequirePermission>

@code {
    private bool _busy;

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var file = await BackupApi.BackupAsync();
            if (file.IsSuccess)
            {
                await FileSaver.SaveAsync(JS, file.Value!);
                Toasts.Show("پشتیبان دانلود شد.");
            }
            else
            {
                Toasts.Show(file.ErrorMessage, isWarning: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
