@page "/stock-io"
@attribute [Authorize]
@inject ApiAuthenticationStateProvider Session
@inject NavigationManager Navigation

<PageTitle>ورود و خروج | داروبار</PageTitle>

@if (!CanWithdraw && !CanReceive)
{
    <div class="empty-state">
        <h2>اجازه‌ی دیدن این صفحه را ندارید</h2>
        <p>برای دسترسی به این بخش با مدیر سیستم صحبت کنید.</p>
    </div>
}
else
{
    <div class="page-head">
        <div>
            <h1>ورود و خروج</h1>
            <p>برداشت جنس از انبار، ثبت ورود جنس تازه و سابقه‌ی برداشت‌های شما. فرم نیمه‌کاره با رفتن به زبانه‌ی دیگر پاک نمی‌شود.</p>
        </div>
    </div>

    @if (TabCount > 1)
    {
        <div class="tab-bar" role="tablist">
            @if (CanWithdraw)
            {
                <button type="button" role="tab" aria-selected="@(Active == "out" ? "true" : "false")" class="tab @(Active == "out" ? "active" : "")" @onclick='() => SelectTab("out")'>برداشت</button>
            }
            @if (CanReceive)
            {
                <button type="button" role="tab" aria-selected="@(Active == "in" ? "true" : "false")" class="tab @(Active == "in" ? "active" : "")" @onclick='() => SelectTab("in")'>ورود</button>
            }
            @if (CanWithdraw)
            {
                <button type="button" role="tab" aria-selected="@(Active == "mine" ? "true" : "false")" class="tab @(Active == "mine" ? "active" : "")" @onclick='() => SelectTab("mine")'>سابقه‌ی من</button>
            }
        </div>
    }

    @* دو فرم همیشه رندر می‌شوند و فقط پنهان می‌شوند تا حالتشان با جابه‌جایی زبانه حفظ شود.
       «سابقه‌ی من» فقط وقتی باز است رندر می‌شود تا هر بار تازه بارگذاری شود. *@
    @if (CanWithdraw)
    {
        <div style="@(Active == "out" ? null : "display:none")"><WithdrawForm ShowHistoryLink="false" /></div>
    }
    @if (CanReceive)
    {
        <div style="@(Active == "in" ? null : "display:none")">
            @* برای همه، حتی انباردار، فقط ورود ساده که انباردار بعداً تأیید و تکمیل می‌کند؛ ورود کامل در زبانه‌ی «ورود جنس» اقلام است
               [تصمیم امیر ۲۰۲۶-۱۱-۱۷، بخش ۱۵.۳ spec]. *@
            <QuickReceiptForm DraftKey="quick-receipt" />
        </div>
    }
    @if (CanWithdraw && Active == "mine")
    {
        <MyWithdrawals Embedded="true" />
    }
}

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private string? _selected;

    private bool CanWithdraw => Session.Can(Permissions.WithdrawalCreate);
    private bool CanReceive => Session.Can(Permissions.ReceiptSubmit);
    private int TabCount => (CanWithdraw ? 2 : 0) + (CanReceive ? 1 : 0);

    // زبانه‌ی انتخاب‌شده، سپس query؛ زبانه‌ی غیرمجاز به اولین زبانه‌ی مجاز برمی‌گردد.
    private string Active
    {
        get
        {
            var wanted = _selected ?? Tab switch { "in" => "in", "mine" => "mine", _ => "out" };
            if (wanted == "in" && CanReceive) return "in";
            if (wanted is "out" or "mine" && CanWithdraw) return wanted;
            return CanWithdraw ? "out" : "in";
        }
    }

    private void SelectTab(string tab)
    {
        _selected = tab;
        var uri = Navigation.GetUriWithQueryParameter("tab", tab == "out" ? null : tab);
        Navigation.NavigateTo(uri, replace: true);
    }
}
