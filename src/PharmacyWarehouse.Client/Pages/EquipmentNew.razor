@page "/equipment/new"
@attribute [Authorize]

<PageTitle>ثبت دستگاه | سامانه تجهیزات IT</PageTitle>

<RequirePermission Permission="@Permissions.EquipmentManage">
@if (_copyFrom is { } source)
{
    <EquipmentForm CopyFromId="source" />
}
else if (_type is { } type)
{
    <EquipmentForm Type="type" />
}
else
{
    <a class="breadcrumb-link" href=""><AppIcon Name="chevron" Size="14" /> تجهیزات</a>
    <div class="page-head">
        <div>
            <h1>ثبت دستگاه</h1>
            <p>نوع دستگاه را انتخاب کنید.</p>
        </div>
    </div>

    <div class="type-grid">
        @foreach (var (value, hint) in Choices)
        {
            <a class="type-tile" href="equipment/new?type=@value">
                <span class="type-chip"><AppIcon Name="@value.ToString()" /></span>
                <strong>@AuditLabels.Type(value)</strong>
                <small>@hint</small>
            </a>
        }
    </div>
}
</RequirePermission>

@code {
    private static readonly (EquipmentType Value, string Hint)[] Choices =
    [
        (EquipmentType.Case, "با قطعات، نام کامپیوتر و جانبی‌ها"),
        (EquipmentType.Laptop, "برند و مدل اجباری، با قطعات"),
        (EquipmentType.Monitor, "برند، مدل و سایز اینچ"),
        (EquipmentType.Printer, "برند و مدل، سایز اختیاری"),
        (EquipmentType.Scanner, "برند و مدل، سایز اختیاری"),
        (EquipmentType.Peripheral, "اسپیکر، بارکدخوان و مانند آن")
    ];

    [SupplyParameterFromQuery(Name = "type")] public string? TypeText { get; set; }
    [SupplyParameterFromQuery(Name = "copy")] public Guid? CopyFrom { get; set; }

    private EquipmentType? _type;
    private Guid? _copyFrom;

    protected override void OnParametersSet()
    {
        _copyFrom = CopyFrom;
        _type = Enum.TryParse<EquipmentType>(TypeText, out var parsed) && Enum.IsDefined(parsed) ? parsed : null;
    }
}
