@page "/dashboard"
@attribute [Authorize]
@inject DashboardClient DashboardApi
@inject ApiAuthenticationStateProvider Session

<PageTitle>داشبورد | انبار داروخانه</PageTitle>

<RequirePermission Permission="@Permissions.DashboardView">
<div class="page-head">
    <div>
        <h1>داشبورد</h1>
        <p>خلاصه‌ی وضعیت؛ روی هر کارت بزنید تا جزئیات را ببینید.</p>
    </div>
    <button type="button" class="btn btn-quiet" disabled="@_loading" @onclick="LoadAsync"><AppIcon Name="history" /> تازه‌سازی</button>
</div>

@if (_error is not null)
{
    <div class="form-alert" role="alert"><AppIcon Name="warning" /> <span>@_error</span></div>
}

@if (_data is { } data)
{
    var expiry = data.Expiry;
    var consumed7 = data.Consumption7Days.ByUser.Sum(u => u.Quantity);
    var corrections = data.Corrections30Days.Count;
    var maxBucket = Math.Max(1, new[] { expiry.Expired.Total, expiry.Near.Total, expiry.Far.Total }.Max());
    var top = data.Consumption7Days.TopProducts.Take(MaxListItems).ToList();
    var maxTop = Math.Max(1, top.Select(t => t.Quantity).DefaultIfEmpty(0).Max());
    var soonest = expiry.Near.Items.Take(MaxListItems).ToList();
    // بی‌خبرترین محل‌ها اول: انبارگردانی‌نشده، بعد قدیمی‌ترین.
    var stocktakes = data.LastStocktakes.OrderBy(s => s.CompletedAtUtc ?? DateTime.MinValue).Take(MaxListItems).ToList();

    <div class="dash-cards">
        @Card("منقضی‌شده", expiry.Expired.Total, "dashboard/expiry?bucket=expired", "alert-danger-soft")
        @Card($"انقضا تا {Num(expiry.NearMonths)} ماه", expiry.Near.Total, "dashboard/expiry?bucket=near", "alert-warning-soft")
        @Card("کمتر از حداقل", data.BelowMinimum.Count, "dashboard/below-min", "alert-warning-soft")
        @Card("تأییدنشده", data.Unreviewed.PendingCount, Session.Can(Permissions.WithdrawalReview) ? "review" : "dashboard/unreviewed", "alert-warning-soft")
        @Card("مصرف ۷ روز", consumed7, "dashboard/consumption", null)
        @Card("اصلاح ۳۰ روز", corrections, "dashboard/corrections", null)
    </div>

    <div class="dash-grid">
        <section class="card-emu">
            <h2>وضعیت انقضا</h2>
            <a class="bar-row" href="dashboard/expiry?bucket=expired">
                <span class="bar-label">منقضی‌شده</span>
                <span class="bar-track"><span class="bar-fill danger" style="width:@Percent(expiry.Expired.Total, maxBucket)"></span></span>
                <span class="bar-value">@Num(expiry.Expired.Total)</span>
            </a>
            <a class="bar-row" href="dashboard/expiry?bucket=near">
                <span class="bar-label">تا @Num(expiry.NearMonths) ماه</span>
                <span class="bar-track"><span class="bar-fill warning" style="width:@Percent(expiry.Near.Total, maxBucket)"></span></span>
                <span class="bar-value">@Num(expiry.Near.Total)</span>
            </a>
            <a class="bar-row" href="dashboard/expiry?bucket=far">
                <span class="bar-label">تا @Num(expiry.FarMonths) ماه</span>
                <span class="bar-track"><span class="bar-fill" style="width:@Percent(expiry.Far.Total, maxBucket)"></span></span>
                <span class="bar-value">@Num(expiry.Far.Total)</span>
            </a>
        </section>

        <section class="card-emu">
            <h2>پرمصرف‌ترین‌ها در ۷ روز</h2>
            @if (top.Count == 0)
            {
                <p class="form-hint">مصرفی ثبت نشده است.</p>
            }
            @foreach (var item in top)
            {
                <a class="bar-row" href="products/@item.Id" @key="item.Id">
                    <span class="bar-label" title="@item.Name">@item.Name</span>
                    <span class="bar-track"><span class="bar-fill" style="width:@Percent(item.Quantity, maxTop)"></span></span>
                    <span class="bar-value">@Num(item.Quantity)</span>
                </a>
            }
            <a class="dash-more" href="dashboard/consumption">همه‌ی مصرف‌ها</a>
        </section>

        <section class="card-emu">
            <h2>نزدیک‌ترین انقضاها</h2>
            @if (soonest.Count == 0)
            {
                <p class="form-hint">موردی نیست.</p>
            }
            @foreach (var item in soonest)
            {
                <a class="bar-row" href="products/@item.ProductId" @key="item.BatchId">
                    <span class="bar-label" title="@item.ProductName">@item.ProductName</span>
                    <span class="cell-sub d-inline"><bdi>@item.ExpiryText</bdi></span>
                    <span class="bar-value">@Num(item.OnHand)</span>
                </a>
            }
            <a class="dash-more" href="dashboard/expiry?bucket=near">همه</a>
        </section>

        <section class="card-emu">
            <h2>آخرین انبارگردانی</h2>
            @if (stocktakes.Count == 0)
            {
                <p class="form-hint">محلی تعریف نشده است.</p>
            }
            @foreach (var item in stocktakes)
            {
                <a class="bar-row" href="dashboard/corrections" @key="item.LocationId">
                    <span class="bar-label" title="@item.LocationName">@item.LocationName</span>
                    <span class="cell-sub d-inline"><bdi>@(item.CompletedAtUtc is { } at ? JalaliDate.Format(at) : "انبارگردانی نشده")</bdi></span>
                </a>
            }
            <a class="dash-more" href="dashboard/corrections">جزئیات</a>
        </section>
    </div>
}
else if (_error is null)
{
    <div class="loading-line">در حال بارگذاری…</div>
}
</RequirePermission>

@code {
    private const int MaxListItems = 5;

    private DashboardResponse? _data;
    private string? _error;
    private bool _loading;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await DashboardApi.GetAsync();
        _loading = false;
        if (result.IsSuccess)
        {
            _error = null;
            _data = result.Value;
        }
        else
        {
            _error = result.ErrorMessage;
        }
    }

    private static string Num(int value) => JalaliDate.ToPersianDigits(value.ToString());

    private static string Percent(int value, int max) => FormattableString.Invariant($"{value * 100.0 / max:0.#}%");

    // رنگ هشدار فقط وقتی عدد صفر نیست؛ کارت آرام یعنی چیزی برای نگرانی نیست.
    private static RenderFragment Card(string title, int value, string href, string? alertClass) => __builder =>
    {
        <a class="dash-card @(value > 0 ? alertClass : null)" href="@href">
            <strong>@Num(value)</strong>
            <span>@title</span>
        </a>
    };
}
