@page "/receipts/review"
@attribute [Authorize]
@using PharmacyWarehouse.Domain.Stock
@inject ReceiptsClient ReceiptsApi
@inject LocationsClient LocationsApi
@inject ToastService Toasts

<PageTitle>بررسی ورودها | انبار داروخانه</PageTitle>

<RequirePermission Permission="@Permissions.StockReceive">
<div class="page-head">
    <div>
        <h1>بررسی ورودها</h1>
        <p>ورودهای ثبت‌شده توسط پرسنل. موجودی از قبل زیاد شده است؛ اینجا مشخصات را تکمیل کنید، قلم موقت را با قلم موجود یکی کنید و تأیید یا رد کنید.</p>
    </div>
    <button type="button" class="btn btn-quiet" disabled="@_loading" @onclick="LoadAsync"><AppIcon Name="history" /> تازه‌سازی</button>
</div>

@if (_error is not null)
{
    <div class="form-alert" role="alert"><AppIcon Name="warning" /> <span>@_error</span></div>
}

@if (_items is null)
{
    <div class="loading-line">در حال بارگذاری…</div>
}
else if (_items.Count == 0)
{
    <div class="table-card"><div class="empty-state"><AppIcon Name="check" Size="40" /><h2>ورودی در انتظار نیست</h2></div></div>
}
else
{
    @foreach (var receipt in _items)
    {
        var edits = _edits[receipt.Id];
        var dirty = edits.Any(e => e.Changed);
        <section class="card-emu" @key="receipt.Id">
            <div class="d-flex align-items-center gap-2">
                <strong style="flex:1;"><bdi>@receipt.UserName</bdi> — <bdi>@JalaliDate.Format(receipt.AtUtc)</bdi></strong>
                <span class="status-badge status-pending">در انتظار</span>
            </div>
            @if (!string.IsNullOrEmpty(receipt.Note)) { <div class="cell-sub">یادداشت: @receipt.Note</div> }

            @foreach (var edit in edits)
            {
                var line = edit.Source;
                <div class="rv-line" @key="line.Id">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <strong>@line.ProductName</strong>
                        @if (line.IsProvisional) { <span class="status-badge status-pending" title="با نام آزاد ساخته شده؛ تکمیل یا ادغام کنید">قلم موقت</span> }
                        <span class="cell-sub">بچ <bdi>@line.BatchNumber</bdi> — انقضا: @(line.ExpiryText ?? "ثبت‌نشده") — موجودی فعلی بچ: @JalaliDate.ToPersianDigits(line.OnHand.ToString())</span>
                    </div>

                    <div class="rv-grid">
                        <div class="form-field">
                            <label for="n-@line.Id">نام</label>
                            <input id="n-@line.Id" class="form-control" autocomplete="off" @bind="edit.Name" @bind:event="oninput" disabled="@(edit.MergeId is not null)" />
                        </div>
                        <div class="form-field">
                            <label for="b-@line.Id">برند</label>
                            <input id="b-@line.Id" class="form-control" autocomplete="off" @bind="edit.Brand" @bind:event="oninput" disabled="@(edit.MergeId is not null)" />
                        </div>
                        <div class="form-field">
                            <label for="p-@line.Id">بسته‌بندی</label>
                            <input id="p-@line.Id" class="form-control" autocomplete="off" @bind="edit.Pack" @bind:event="oninput" disabled="@(edit.MergeId is not null)" />
                        </div>
                        <div class="form-field">
                            <label for="q-@line.Id">تعداد</label>
                            <input id="q-@line.Id" class="form-control" type="number" min="1" inputmode="numeric" @bind="edit.Quantity" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="rv-grid">
                        <div class="form-field">
                            <label for="pl-@line.Id">محل قلم</label>
                            <LocationPicker InputId="@("pl-" + line.Id)" Items="_locations" @bind-Value="edit.ProductLocationId" Disabled="@(edit.MergeId is not null)" />
                        </div>
                        <div class="form-field">
                            <label for="bl-@line.Id">محل این بچ (خالی = محل قلم)</label>
                            <LocationPicker InputId="@("bl-" + line.Id)" Items="_locations" @bind-Value="edit.BatchLocationId" />
                        </div>
                        <div class="form-field">
                            <label class="d-flex align-items-center gap-2">
                                <input type="checkbox" class="form-check-input" @bind="edit.RequiresExpiry" disabled="@(edit.MergeId is not null)" /> این قلم تاریخ انقضا دارد
                            </label>
                        </div>
                    </div>

                    <ExpiryFields IdPrefix="@("e-" + line.Id)" @bind-Value="edit.Expiry" Required="@edit.RequiresExpiry" />

                    @if (line.IsProvisional)
                    {
                        <div class="form-field">
                            <label>ادغام در قلم موجود</label>
                            @if (edit.MergeId is null)
                            {
                                <ProductCombobox InputId="@("m-" + line.Id)" AutoFocus="false" Placeholder="قلم موجود را جست‌وجو کنید (اختیاری)" OnPick="p => PickMerge(edit, p)" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <span>ادغام در: <strong>@edit.MergeName</strong></span>
                                    <button type="button" class="btn btn-quiet" @onclick="() => ClearMerge(edit)">لغو ادغام</button>
                                </div>
                            }
                        </div>
                    }

                    @foreach (var message in edit.Errors)
                    {
                        <div class="field-error" role="alert">@message</div>
                    }
                </div>
            }

            @if (_formErrors.TryGetValue(receipt.Id, out var formError))
            {
                <div class="form-alert mt-2" role="alert">@formError</div>
            }

            <div class="mt-2 d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-primary" disabled="@(_busy || !dirty)" @onclick="() => SaveAsync(receipt)">ذخیره‌ی تغییرات</button>
                <button type="button" class="btn btn-primary" disabled="@(_busy || dirty)" title="@(dirty ? "ابتدا تغییرات را ذخیره کنید" : "")" @onclick="() => ApproveAsync(receipt)">تأیید</button>
                <button type="button" class="btn btn-quiet" disabled="@(_busy || dirty)" @onclick="() => StartReject(receipt)">رد…</button>
            </div>
        </section>
    }
}

@if (_rejecting is { } target)
{
    <ModalDialog Title="رد ورود" OnClose="CancelReject">
        <p>ورود <bdi>@target.UserName</bdi> رد می‌شود و موجودی ردیف‌ها کم می‌شود. اگر بخشی از آن برداشته شده باشد، رد ممکن نیست.</p>
        <div class="form-field">
            <label for="reject-note">یادداشت (اجباری) <span class="required">*</span></label>
            <input id="reject-note" class="form-control" autocomplete="off" @bind="_rejectNote" @bind:event="oninput" />
        </div>
        @if (_rejectError is not null)
        {
            <div class="form-alert mt-2" role="alert">@_rejectError</div>
        }
        <div class="mt-3 d-flex gap-2">
            <button type="button" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_rejectNote))" @onclick="RejectAsync">رد و کم کردن موجودی</button>
            <button type="button" class="btn btn-quiet" disabled="@_busy" @onclick="CancelReject">انصراف</button>
        </div>
    </ModalDialog>
}
</RequirePermission>

@code {
    // حالت ویرایش یک ردیف؛ مقدارهای اولیه از ReceiptLineItem. Expiry خالی = بدون تغییر.
    private sealed class LineEdit
    {
        public LineEdit(ReceiptLineItem source)
        {
            Source = source;
            Name = source.ProductName;
            Brand = source.Brand ?? "";
            Pack = source.PackDescription ?? "";
            ProductLocationId = source.ProductLocationId;
            RequiresExpiry = source.RequiresExpiry;
            BatchLocationId = source.BatchLocationId;
            Quantity = source.Quantity;
        }

        public ReceiptLineItem Source { get; }
        public string Name { get; set; }
        public string Brand { get; set; }
        public string Pack { get; set; }
        public Guid? ProductLocationId { get; set; }
        public bool RequiresExpiry { get; set; }
        public Guid? BatchLocationId { get; set; }
        public int? Quantity { get; set; }
        public string? Expiry { get; set; }
        public Guid? MergeId { get; set; }
        public string? MergeName { get; set; }
        public List<string> Errors { get; } = [];

        public bool ProductChanged =>
            Name.Trim() != Source.ProductName || Brand.Trim() != (Source.Brand ?? "") || Pack.Trim() != (Source.PackDescription ?? "")
            || ProductLocationId != Source.ProductLocationId || RequiresExpiry != Source.RequiresExpiry;

        public bool Changed =>
            MergeId is not null || ProductChanged || Quantity != Source.Quantity || BatchLocationId != Source.BatchLocationId || !string.IsNullOrWhiteSpace(Expiry);
    }

    private List<ReceiptItem>? _items;
    private readonly Dictionary<Guid, List<LineEdit>> _edits = [];
    private readonly Dictionary<Guid, string> _formErrors = [];
    private List<StorageLocationItem> _locations = [];
    private string? _error;
    private bool _busy;
    private bool _loading;
    private ReceiptItem? _rejecting;
    private string _rejectNote = "";
    private string? _rejectError;

    protected override async Task OnInitializedAsync()
    {
        var locations = await LocationsApi.ListAsync();
        if (locations.IsSuccess) _locations = locations.Value!.Where(l => l.IsActive && l.IsUsable).ToList();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await ReceiptsApi.PendingAsync();
        _loading = false;
        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            _items ??= [];
            return;
        }

        _error = null;
        _items = result.Value!;
        _edits.Clear();
        _formErrors.Clear();
        foreach (var r in _items) _edits[r.Id] = r.Lines.Select(l => new LineEdit(l)).ToList();
    }

    private static void PickMerge(LineEdit edit, ProductListItem product)
    {
        edit.MergeId = product.Id;
        edit.MergeName = string.Join(" · ", new[] { product.Name, product.Brand, product.PackDescription }.Where(s => !string.IsNullOrEmpty(s)));
    }

    private static void ClearMerge(LineEdit edit)
    {
        edit.MergeId = null;
        edit.MergeName = null;
    }

    // فقط ردیف‌های تغییرکرده فرستاده می‌شوند؛ فهرست Sent برای برگرداندن خطای «Lines[i]» به ردیف درست است.
    private async Task SaveAsync(ReceiptItem receipt)
    {
        if (_busy) return;

        var edits = _edits[receipt.Id];
        foreach (var e in edits) e.Errors.Clear();
        _formErrors.Remove(receipt.Id);

        var sent = edits.Where(e => e.Changed).ToList();
        var request = sent.Select(e => new ReviewLineEdit
        {
            LineId = e.Source.Id,
            LineVersion = e.Source.Version,
            BatchVersion = e.Source.BatchVersion,
            Quantity = e.Quantity ?? 0,
            MergeIntoProductId = e.MergeId,
            Product = e.MergeId is null && e.ProductChanged
                ? new ReviewProductEdit { Name = e.Name, Brand = e.Brand, PackDescription = e.Pack, LocationId = e.ProductLocationId, RequiresExpiry = e.RequiresExpiry, Version = e.Source.ProductVersion }
                : null,
            Expiry = e.Expiry,
            BatchLocationId = e.BatchLocationId
        }).ToList();

        _busy = true;
        var result = await ReceiptsApi.SaveReviewAsync(receipt, request);
        _busy = false;

        if (result.IsSuccess)
        {
            Replace(result.Value!);
            Toasts.Show("تغییرات ذخیره شد.");
            return;
        }

        _formErrors[receipt.Id] = result.ErrorMessage;
        foreach (var (key, messages) in result.Problem?.Errors ?? [])
        {
            if (BulkReceiptErrors.TryParse(key, out var index, out _) && index >= 0 && index < sent.Count) sent[index].Errors.AddRange(messages);
        }

        if (result.Outcome == ApiOutcome.Conflict && result.Problem?.Type == ProblemTypes.VersionConflict)
        {
            Toasts.Show("این ورود در این فاصله تغییر کرده است؛ فهرست تازه شد.", isWarning: true);
            await LoadAsync();
        }
    }

    private async Task ApproveAsync(ReceiptItem receipt)
    {
        if (_busy) return;

        _busy = true;
        _formErrors.Remove(receipt.Id);
        foreach (var e in _edits[receipt.Id]) e.Errors.Clear();
        var result = await ReceiptsApi.ApproveAsync(receipt);
        _busy = false;

        if (result.IsSuccess)
        {
            Toasts.Show("تأیید شد.");
            await LoadAsync();
            return;
        }

        _formErrors[receipt.Id] = result.ErrorMessage;
        var lines = _edits[receipt.Id];
        foreach (var (key, messages) in result.Problem?.Errors ?? [])
        {
            if (BulkReceiptErrors.TryParse(key, out var index, out _) && index >= 0 && index < lines.Count) lines[index].Errors.AddRange(messages);
        }

        if (result.Outcome == ApiOutcome.Conflict) await LoadAsync(); // وضعیت عوض شده
    }

    private void Replace(ReceiptItem saved)
    {
        var index = _items!.FindIndex(r => r.Id == saved.Id);
        if (index < 0) return;

        _items[index] = saved;
        _edits[saved.Id] = saved.Lines.Select(l => new LineEdit(l)).ToList();
    }

    private void StartReject(ReceiptItem receipt)
    {
        _rejecting = receipt;
        _rejectNote = "";
        _rejectError = null;
    }

    private void CancelReject() => _rejecting = null;

    private async Task RejectAsync()
    {
        if (_busy || _rejecting is not { } receipt) return;

        _busy = true;
        var result = await ReceiptsApi.RejectAsync(receipt, _rejectNote);
        _busy = false;

        if (result.IsSuccess)
        {
            _rejecting = null;
            Toasts.Show("رد شد و موجودی کم شد.");
            await LoadAsync();
            return;
        }

        // ۴۰۹ مثل «بخشی برداشته شده» پنجره را باز نگه می‌دارد تا پیام دیده شود.
        _rejectError = result.ErrorMessage;
    }
}
