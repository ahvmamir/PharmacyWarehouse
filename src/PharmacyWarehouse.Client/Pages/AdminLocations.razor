@page "/admin/locations"
@attribute [Authorize]
@inject CatalogClient Catalog
@inject ToastService Toasts

<PageTitle>ساختمان و واحد | سامانه تجهیزات IT</PageTitle>

<RequirePermission Permission="@Permissions.LocationsManage">
<div class="page-head">
    <div>
        <h1>ساختمان و واحد</h1>
        <p>موردی که دستگاه دارد حذف نمی‌شود؛ غیرفعالش کنید.</p>
    </div>
</div>

@if (_error is not null)
{
    <div class="form-alert" role="alert">
        <AppIcon Name="warning" /> <span>@_error</span>
        <button type="button" class="btn btn-sm btn-quiet" @onclick="LoadAsync">تازه‌سازی</button>
    </div>
}

@if (!_loaded)
{
    <div class="loading-line">در حال بارگذاری…</div>
}
else
{
    <div class="device-grid" style="grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);">
        <section class="card-emu">
            <div class="card-emu-head">
                <h2>ساختمان‌ها و طبقه‌ها</h2>
                <button type="button" class="btn btn-sm btn-primary" @onclick="NewBuilding"><AppIcon Name="plus" Size="15" /> ساختمان</button>
            </div>
            @if (_buildings.Count == 0)
            {
                <div class="empty-state">
                    <AppIcon Name="building" Size="36" />
                    <p>هنوز ساختمانی تعریف نشده. از ساختمان شروع کنید، بعد طبقه‌هایش را بیفزایید.</p>
                </div>
            }
            @foreach (var building in _buildings)
            {
                <div class="card-emu-body" style="border-bottom:1px solid var(--line);" @key="building.Id">
                    <div class="linked-item" style="border:0;padding-top:0;">
                        <strong style="flex:1;">@building.Name</strong>
                        @if (!building.IsActive)
                        {
                            <span class="status-badge status-retired">غیرفعال</span>
                        }
                        <button type="button" class="icon-button" title="ویرایش" aria-label="ویرایش @building.Name" @onclick="() => EditBuilding(building)"><AppIcon Name="edit" Size="16" /></button>
                        <button type="button" class="btn btn-sm btn-ghost" @onclick="() => ToggleBuildingAsync(building)">@(building.IsActive ? "غیرفعال کن" : "فعال کن")</button>
                        <button type="button" class="icon-button danger" title="حذف" aria-label="حذف @building.Name" @onclick="@(() => AskDelete(ApiRoutes.Buildings, building.Id, $"ساختمان {building.Name}"))"><AppIcon Name="trash" Size="16" /></button>
                    </div>

                    @foreach (var floor in _floors.Where(f => f.BuildingId == building.Id))
                    {
                        <div class="linked-item" style="padding-right:14px;" @key="floor.Id">
                            <span style="flex:1;">@floor.Name</span>
                            @if (!floor.IsActive)
                            {
                                <span class="status-badge status-retired">غیرفعال</span>
                            }
                            <button type="button" class="icon-button" title="ویرایش" aria-label="ویرایش @floor.Name" @onclick="() => EditFloor(floor)"><AppIcon Name="edit" Size="16" /></button>
                            <button type="button" class="btn btn-sm btn-ghost" @onclick="() => ToggleFloorAsync(floor)">@(floor.IsActive ? "غیرفعال کن" : "فعال کن")</button>
                            <button type="button" class="icon-button danger" title="حذف" aria-label="حذف @floor.Name" @onclick="@(() => AskDelete(ApiRoutes.Floors, floor.Id, $"طبقه {floor.Name}"))"><AppIcon Name="trash" Size="16" /></button>
                        </div>
                    }

                    @if (building.IsActive)
                    {
                        <button type="button" class="chip-add mt-2" @onclick="() => NewFloor(building)"><AppIcon Name="plus" Size="13" /> طبقه</button>
                    }
                </div>
            }
        </section>

        <section class="card-emu">
            <div class="card-emu-head">
                <h2>واحدها</h2>
                <button type="button" class="btn btn-sm btn-primary" @onclick="NewUnit"><AppIcon Name="plus" Size="15" /> واحد</button>
            </div>
            <div class="card-emu-body">
                @if (_units.Count == 0)
                {
                    <div class="empty-state" style="padding:20px;">
                        <p>هنوز واحدی تعریف نشده. یک فهرست واحد هم برای مالکیت است و هم برای محل.</p>
                    </div>
                }
                @foreach (var unit in _units)
                {
                    <div class="linked-item" @key="unit.Id">
                        <span style="flex:1;">@unit.Name</span>
                        @if (!unit.IsActive)
                        {
                            <span class="status-badge status-retired">غیرفعال</span>
                        }
                        <button type="button" class="icon-button" title="ویرایش" aria-label="ویرایش @unit.Name" @onclick="() => EditUnit(unit)"><AppIcon Name="edit" Size="16" /></button>
                        <button type="button" class="btn btn-sm btn-ghost" @onclick="() => ToggleUnitAsync(unit)">@(unit.IsActive ? "غیرفعال کن" : "فعال کن")</button>
                        <button type="button" class="icon-button danger" title="حذف" aria-label="حذف @unit.Name" @onclick="@(() => AskDelete(ApiRoutes.Units, unit.Id, $"واحد {unit.Name}"))"><AppIcon Name="trash" Size="16" /></button>
                    </div>
                }
            </div>
        </section>
    </div>
}

@if (_deleteName is not null)
{
    <DeleteDialog Title="حذف" ItemName="@_deleteName"
                  Load="() => Catalog.DependenciesAsync(_deleteCollection, _deleteId)"
                  Delete="() => Catalog.DeleteAsync(_deleteCollection, _deleteId)"
                  OnCancel="() => _deleteName = null"
                  OnDeleted="OnDeletedAsync" />
}

@if (_dialogTitle is not null)
{
    <ModalDialog Title="@_dialogTitle" OnClose="CloseDialog">
        <EditForm Model="this" OnSubmit="SaveDialogAsync">
            <div class="form-field">
                <label for="location-name">نام <span class="required">*</span></label>
                <input id="location-name" class="form-control" @bind="_name" @ref="_nameInput" />
            </div>

            @if (_kind == "floor")
            {
                <div class="form-field mt-3">
                    <label for="floor-order">ترتیب نمایش</label>
                    <input id="floor-order" class="form-control" type="number" dir="ltr" @bind="_sortOrder" />
                    <div class="form-hint">عدد کوچک‌تر بالاتر می‌آید؛ زیرزمین را منفی بگذارید.</div>
                </div>
            }

            @if (_dialogError is not null)
            {
                <div class="form-alert mt-3 mb-0" role="alert">@_dialogError</div>
            }

            <div class="modal-actions">
                <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "در حال ذخیره…" : "ذخیره")</button>
                <button type="button" class="btn btn-quiet" @onclick="CloseDialog">انصراف</button>
            </div>
        </EditForm>
    </ModalDialog>
}
</RequirePermission>

@code {
    private List<BuildingItem> _buildings = [];
    private List<FloorItem> _floors = [];
    private List<UnitItem> _units = [];
    private bool _loaded;
    private bool _busy;
    private string? _error;

    private string? _dialogTitle;
    private string? _dialogError;
    private string _kind = "";
    private string _name = "";
    private int _sortOrder;
    private int _version;
    private Guid? _editId;
    private Guid _parentBuildingId;
    private bool _focusName;
    private ElementReference _nameInput;
    private string? _deleteName;
    private string _deleteCollection = "";
    private Guid _deleteId;

    private void AskDelete(string collection, Guid id, string name)
    {
        _deleteCollection = collection;
        _deleteId = id;
        _deleteName = name;
    }

    private async Task OnDeletedAsync()
    {
        Toasts.Show($"حذف شد: {_deleteName}");
        _deleteName = null;
        await LoadAsync();
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusName)
        {
            _focusName = false;
            await _nameInput.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        _error = null;

        var buildings = await Catalog.BuildingsAsync();
        var floors = await Catalog.FloorsAsync();
        var units = await Catalog.UnitsAsync();

        if (!buildings.IsSuccess || !floors.IsSuccess || !units.IsSuccess)
        {
            _error = buildings.IsSuccess ? floors.IsSuccess ? units.ErrorMessage : floors.ErrorMessage : buildings.ErrorMessage;
            return;
        }

        _buildings = buildings.Value!;
        _floors = floors.Value!;
        _units = units.Value!;
        _loaded = true;
    }

    private void Open(string kind, string title, string name, Guid? id, int version, int sortOrder = 0)
    {
        _kind = kind;
        _dialogTitle = title;
        _name = name;
        _editId = id;
        _version = version;
        _sortOrder = sortOrder;
        _dialogError = null;
        _focusName = true;
    }

    private void CloseDialog() => _dialogTitle = null;

    private void NewBuilding() => Open("building", "ساختمان جدید", "", null, 0);
    private void EditBuilding(BuildingItem b) => Open("building", "ویرایش ساختمان", b.Name, b.Id, b.Version);
    private void NewUnit() => Open("unit", "واحد جدید", "", null, 0);
    private void EditUnit(UnitItem u) => Open("unit", "ویرایش واحد", u.Name, u.Id, u.Version);

    private void NewFloor(BuildingItem b)
    {
        _parentBuildingId = b.Id;
        var next = _floors.Where(f => f.BuildingId == b.Id).Select(f => f.SortOrder + 1).DefaultIfEmpty(0).Max();
        Open("floor", $"طبقه‌ی جدید در {b.Name}", "", null, 0, next);
    }

    private void EditFloor(FloorItem f)
    {
        _parentBuildingId = f.BuildingId;
        Open("floor", "ویرایش طبقه", f.Name, f.Id, f.Version, f.SortOrder);
    }

    private async Task SaveDialogAsync()
    {
        if (_busy) return;

        _dialogError = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _dialogError = "نام را وارد کنید.";
            return;
        }

        _busy = true;
        try
        {
            string? failure = _kind switch
            {
                "building" => Failure(await Catalog.SaveBuildingAsync(_editId, new SaveBuildingRequest { Name = _name, Version = _version })),
                "floor" => Failure(await Catalog.SaveFloorAsync(_editId, new SaveFloorRequest
                {
                    BuildingId = _parentBuildingId,
                    Name = _name,
                    SortOrder = _sortOrder,
                    Version = _version
                })),
                _ => Failure(await Catalog.SaveUnitAsync(_editId, new SaveUnitRequest { Name = _name, Version = _version }))
            };

            if (failure is not null)
            {
                _dialogError = failure;
                return;
            }

            CloseDialog();
            Toasts.Show("ذخیره شد.");
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? Failure<T>(ApiResult<T> result) where T : class =>
        result.IsSuccess ? null : result.ErrorMessage;

    private async Task AfterToggleAsync<T>(ApiResult<T> result) where T : class
    {
        if (!result.IsSuccess) Toasts.Show(result.ErrorMessage, isWarning: true);
        await LoadAsync();
    }

    private async Task ToggleBuildingAsync(BuildingItem b) => await AfterToggleAsync(await Catalog.SetBuildingActiveAsync(b, !b.IsActive));
    private async Task ToggleFloorAsync(FloorItem f) => await AfterToggleAsync(await Catalog.SetFloorActiveAsync(f, !f.IsActive));
    private async Task ToggleUnitAsync(UnitItem u) => await AfterToggleAsync(await Catalog.SetUnitActiveAsync(u, !u.IsActive));
}
