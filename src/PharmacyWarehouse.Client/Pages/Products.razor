@page "/"
@page "/products"
@attribute [Authorize]
@using PharmacyWarehouse.Domain.Stock
@inject ProductsClient ProductsApi
@inject LocationsClient LocationsApi
@inject CategoriesClient CategoriesApi
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject ApiAuthenticationStateProvider Session

<PageTitle>اقلام | داروبار</PageTitle>

<RequirePermission Permission="@Permissions.StockView">
<div class="page-head">
    <div>
        <h1>اقلام</h1>
        <p>بارکد را اسکن کنید یا با نام قلم جست‌وجو کنید. موجودی به «جعبه» است.</p>
    </div>
    @if (CanManage)
    {
        <button type="button" class="btn btn-primary" @onclick="() => _creating = true"><AppIcon Name="plus" Size="15" /> قلم جدید</button>
    }
</div>

@* ورود جنس کامل زبانه‌ی همین صفحه است (بخش ۱۵.۳ spec، تصمیم ۲۰۲۶-۱۱-۱۷): فهرست و ورود کنار هم، و هر دو همیشه رندر می‌شوند
   تا فهرست ورود نیمه‌کاره با جابه‌جایی زبانه نماند. *@
@if (CanReceive)
{
    <div class="tab-bar" role="tablist">
        <button type="button" role="tab" aria-selected="@(!ReceiveActive ? "true" : "false")" class="tab @(!ReceiveActive ? "active" : "")" @onclick="() => SelectTabAsync(false)">فهرست</button>
        <button type="button" role="tab" aria-selected="@(ReceiveActive ? "true" : "false")" class="tab @(ReceiveActive ? "active" : "")" @onclick="() => SelectTabAsync(true)">
            ورود جنس@(_receiveCount > 0 ? $" ({JalaliDate.ToPersianDigits(_receiveCount.ToString())})" : "")
        </button>
    </div>
    <div style="@(ReceiveActive ? null : "display:none")">
        <Receive @ref="_receive" Embedded="true" OnCountChanged="n => _receiveCount = n" />
    </div>
}

<div style="@(ReceiveActive ? "display:none" : null)">
@* یک کادر برای نام و بارکد (بخش ۱۵.۳ spec): Enter روی بارکد کامل مستقیم به قلم می‌رود؛ بقیه فهرست را فیلتر می‌کند. *@
<form class="filters" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
    <div class="filters-search">
        <label for="product-q">جست‌وجو یا اسکن</label>
        <div class="d-flex gap-2">
            <input id="product-q" class="form-control" dir="auto" autocomplete="off" @ref="_queryInput" @bind="_query" @bind:event="oninput"
                   placeholder="نام، برند، بسته یا بارکد؛ بارکدخوان هم همین‌جا" />
            <button type="submit" class="btn btn-primary"><AppIcon Name="search" Size="15" /> جست‌وجو</button>
        </div>
    </div>
    <div>
        <label for="product-location">محل</label>
        <LocationPicker InputId="product-location" Items="_locations" EmptyLabel="— همه‌ی محل‌ها —" Value="_locationId" ValueChanged="OnLocationChangedAsync" />
    </div>
    @if (_categories.Count > 0)
    {
        <div>
            <label for="product-category-filter">دسته</label>
            <select id="product-category-filter" class="form-select" value="@(_categoryId?.ToString() ?? "")" @onchange="OnCategoryChangedAsync">
                <option value="">— همه‌ی دسته‌ها —</option>
                @foreach (var category in _categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </div>
    }
    <div>
        <label for="product-filter">وضعیت موجودی</label>
        <select id="product-filter" class="form-select" @bind="_filter" @bind:after="LoadAsync">
            <option value="">همه</option>
            <option value="zero">موجودی صفر</option>
            <option value="belowMin">کمتر از حداقل</option>
            <option value="expiring">نزدیک انقضا</option>
        </select>
    </div>
    <div class="filters-actions">
        @if (CanManage)
        {
            <label class="d-flex align-items-center gap-2 mb-0">
                <input type="checkbox" class="form-check-input" @bind="_includeInactive" @bind:after="LoadAsync" /> غیرفعال‌ها هم
            </label>
        }
    </div>
</form>

@if (_error is not null)
{
    <div class="form-alert" role="alert">
        <AppIcon Name="warning" /> <span>@_error</span>
        <button type="button" class="btn btn-sm btn-quiet" @onclick="LoadAsync">تازه‌سازی</button>
    </div>
}

@if (!_loaded)
{
    <div class="loading-line">در حال بارگذاری…</div>
}
else if (_items.Count == 0)
{
    <div class="empty-state">
        <AppIcon Name="box" Size="36" />
        <p>@(HasCriteria ? "قلمی با این شرایط پیدا نشد." : "هنوز قلمی تعریف نشده.")</p>
    </div>
}
else
{
    @if (CanBulk && _selected.Count > 0)
{
    @* دسته‌بندی سریع اقلام فعلی (بخش ۱۵.۳ spec): چند قلم انتخاب، یک دسته، یک کلیک. *@
    <div class="bulk-bar" role="region" aria-label="کار گروهی">
        <strong>@JalaliDate.ToPersianDigits(_selected.Count.ToString()) قلم انتخاب شد</strong>
        <label for="bulk-category" class="visually-hidden">دسته</label>
        <select id="bulk-category" class="form-select" @bind="_bulkCategory">
            <option value="">— بدون دسته —</option>
            @foreach (var category in _categories.Where(c => c.IsActive))
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
        <button type="button" class="btn btn-primary" disabled="@_bulkBusy" @onclick="AssignCategoryAsync">@(_bulkBusy ? "در حال ثبت…" : "تعیین دسته")</button>
        <button type="button" class="btn btn-quiet" @onclick="() => _selected.Clear()">لغو انتخاب</button>
    </div>
}

<section class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    @if (CanBulk)
                    {
                        <th class="select-col">
                            <input type="checkbox" class="form-check-input" aria-label="انتخاب همه"
                                   checked="@(_selected.Count > 0 && _selected.Count == _items.Count)" @onchange="ToggleAll" />
                        </th>
                    }
                    <th>نام</th>
                    <th>برند</th>
                    <th>بسته</th>
                    <th>محل</th>
                    @if (_categories.Count > 0)
                    {
                        <th>دسته</th>
                    }
                    <th>موجودی (جعبه)</th>
                    <th>نزدیک‌ترین انقضا</th>
                    @if (CanReceive)
                    {
                        <th><span class="visually-hidden">ورود</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr class="row-link @(_selected.Contains(item.Id) ? "row-selected" : null)" @key="item.Id">
                        @if (CanBulk)
                        {
                            <td class="select-col">
                                <input type="checkbox" class="form-check-input row-link-above" aria-label="انتخاب @item.Name"
                                       checked="@_selected.Contains(item.Id)" @onchange="() => ToggleOne(item.Id)" />
                            </td>
                        }
                        <td>
                            <a class="row-link-main" href="products/@item.Id">@item.Name</a>
                            @if (!item.IsActive)
                            {
                                <span class="status-badge status-retired">غیرفعال</span>
                            }
                        </td>
                        <td>@item.Brand</td>
                        <td>@item.PackDescription</td>
                        <td><bdi>@item.LocationPath</bdi></td>
                        @if (_categories.Count > 0)
                        {
                            <td><bdi>@item.CategoryName</bdi></td>
                        }
                        <td>
                            @JalaliDate.ToPersianDigits(item.OnHand.ToString())
                            @if (item.MinStock is { } min && item.UsableOnHand < min)
                            {
                                <span class="status-badge status-pending" title="موجودی منقضی‌نشده کمتر از حداقل (@JalaliDate.ToPersianDigits(min.ToString())) است">کم</span>
                            }
                            @if (item.OnHand > item.UsableOnHand)
                            {
                                <span class="status-badge status-expired" title="بخشی از موجودی منقضی شده است">منقضی دارد</span>
                            }
                        </td>
                        <td>
                            @if (item.NearestExpiry is { } expiry)
                            {
                                <span>@(item.NearestExpiryText ?? "—")</span>
                                @if (ExpiryDate.IsExpired(expiry, Today()))
                                {
                                    <span class="status-badge status-expired">منقضی</span>
                                }
                            }
                        </td>
                        @if (CanReceive)
                        {
                            <td>
                                @if (item.IsActive)
                                {
                                    <button type="button" class="btn btn-sm btn-quiet row-link-above" title="افزودن به فهرست ورود جنس" @onclick="() => ReceiveProductAsync(item.Id)">
                                        <AppIcon Name="plus" Size="14" /> ورود
                                    </button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </section>
}
</div>

@if (_creating)
{
    <ModalDialog Side="true" Title="تعریف قلم" OnClose="() => _creating = false">
        <ProductForm OnSaved="Created" OnCancel="() => _creating = false" OnAnySaved="_ => LoadAsync()" />
    </ModalDialog>
}

@if (_unknownCode is { } unknown)
{
    <ModalDialog Title="این بارکد مال کدام قلم است؟" OnClose="CloseUnknown">
        <p>بارکد <bdi class="mono">@unknown</bdi> هنوز به قلمی وصل نیست. قلم را پیدا کنید و ثبت کنید.</p>
        <div class="form-field">
            <label for="unknown-q">جست‌وجوی قلم</label>
            <input id="unknown-q" class="form-control" @bind="_pickQuery" @bind:event="oninput" @onkeydown="OnPickKeyDown" placeholder="نام قلم" />
        </div>
        <div class="mt-2">
            <button type="button" class="btn btn-sm btn-quiet" @onclick="SearchPickAsync">جست‌وجو</button>
        </div>

        @if (_pickResults is not null)
        {
            @if (_pickResults.Count == 0)
            {
                <div class="form-hint mt-2">قلمی پیدا نشد.</div>
            }
            else
            {
                <div class="mt-2" style="max-height:260px;overflow:auto;">
                    @foreach (var item in _pickResults)
                    {
                        <label class="linked-item" @key="item.Id">
                            <input type="radio" name="pick-product" class="form-check-input" checked="@(_pickId == item.Id)" @onchange="() => _pickId = item.Id" />
                            <span style="flex:1;">
                                <strong>@item.Name</strong>
                                <small class="cell-sub">@string.Join(" · ", new[] { item.Brand, item.PackDescription }.Where(s => !string.IsNullOrEmpty(s)))</small>
                            </span>
                        </label>
                    }
                </div>
            }
        }

        @if (_dialogError is not null)
        {
            <div class="form-alert mt-3 mb-0" role="alert">@_dialogError</div>
        }

        <div class="modal-actions">
            <button type="button" class="btn btn-primary" disabled="@(_busy || _pickId is null)" @onclick="RegisterBarcodeAsync">@(_busy ? "در حال ثبت…" : "ثبت بارکد")</button>
            @if (CanReceive)
            {
                <button type="button" class="btn btn-quiet" disabled="@_busy" @onclick="() => DefineAndReceiveAsync(unknown)"><AppIcon Name="plus" Size="15" /> قلم تازه است؛ تعریف و ورود جنس</button>
            }
            <button type="button" class="btn btn-quiet" @onclick="CloseUnknown">انصراف</button>
        </div>
    </ModalDialog>
}
</RequirePermission>

@code {
    // انتخاب گروهی برای تعیین دسته؛ فقط برای products.manage و وقتی دسته‌ای تعریف شده.
    private readonly HashSet<Guid> _selected = [];
    private string _bulkCategory = "";
    private bool _bulkBusy;

    private bool CanBulk => CanManage && _categories.Count > 0;

    private void ToggleOne(Guid id)
    {
        if (!_selected.Remove(id)) _selected.Add(id);
    }

    private void ToggleAll()
    {
        if (_selected.Count == _items.Count) _selected.Clear();
        else foreach (var item in _items) _selected.Add(item.Id);
    }

    private async Task AssignCategoryAsync()
    {
        if (_bulkBusy || _selected.Count == 0) return;

        _bulkBusy = true;
        var request = new BulkCategoryRequest
        {
            CategoryId = Guid.TryParse(_bulkCategory, out var id) ? id : null,
            Items = _items.Where(i => _selected.Contains(i.Id)).Select(i => new ReviewTarget { Id = i.Id, Version = i.Version }).ToList()
        };
        var result = await CategoriesApi.AssignAsync(request);
        _bulkBusy = false;

        if (!result.IsSuccess)
        {
            Toasts.Show(result.ErrorMessage ?? "ثبت نشد.", isWarning: true);
            return;
        }

        var done = result.Value!;
        var message = $"دسته‌ی {JalaliDate.ToPersianDigits(done.Updated.Count.ToString())} قلم تعیین شد.";
        if (done.Failed.Count > 0) message += " " + string.Join(" ", done.Failed.Select(f => f.Message));
        Toasts.Show(message, isWarning: done.Failed.Count > 0);
        _selected.Clear();
        await LoadAsync();
    }

    // پنجره‌ی «تعریف قلم» (بخش ۱۵.۳ spec)؛ «ذخیره» به جزئیات قلم تازه می‌رود، «ثبت و قلم بعدی» پنجره را باز نگه می‌دارد.
    private bool _creating;

    private void Created(ProductDetail detail)
    {
        _creating = false;
        Navigation.NavigateTo($"products/{detail.Summary.Id}");
    }

    private List<ProductListItem> _items = [];
    private List<StorageLocationItem> _locations = [];
    private bool _loaded;
    private string? _error;

    private string _query = "";
    private Guid? _locationId;
    private List<CategoryItem> _categories = [];
    // از /products?categoryId=… (پیوند صفحه‌ی دسته‌ها) هم پر می‌شود.
    [SupplyParameterFromQuery(Name = "categoryId")] public Guid? CategoryQuery { get; set; }
    private Guid? _categoryId;
    private string _filter = "";
    private bool _includeInactive;

    private ElementReference _queryInput;

    // جریان بارکد ناشناخته
    private string? _unknownCode;
    private string _pickQuery = "";
    private List<ProductListItem>? _pickResults;
    private Guid? _pickId;
    private string? _dialogError;
    private bool _busy;

    private bool CanManage => Session.Can(Permissions.ProductsManage);

    // ---------- زبانه‌ی «ورود جنس» ----------

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    private bool? _receiveSelected;
    private Receive? _receive;
    private int _receiveCount;

    private bool CanReceive => Session.Can(Permissions.StockReceive);
    private bool ReceiveActive => CanReceive && (_receiveSelected ?? Tab == "receive");

    private async Task SelectTabAsync(bool receive)
    {
        _receiveSelected = receive;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["tab"] = receive ? "receive" : null,
            ["productId"] = null
        }), replace: true);
        await Task.Yield();
        if (receive && _receive is not null) await _receive.FocusAsync();
        else await _queryInput.FocusAsync();
    }

    private async Task ReceiveProductAsync(Guid productId)
    {
        if (_receive is null) return;
        await _receive.AddProductAsync(productId);
        await SelectTabAsync(true);
    }

    private async Task DefineAndReceiveAsync(string code)
    {
        _unknownCode = null;
        if (_receive is null) return;
        await SelectTabAsync(true);
        await _receive.AddCodeAsync(code);
    }

    private bool HasCriteria => !string.IsNullOrWhiteSpace(_query) || _locationId is not null || _categoryId is not null || _filter != "";

    private static DateOnly Today() => LocalDay.Today(DateTime.UtcNow);

    protected override async Task OnInitializedAsync()
    {
        // صفحه‌ی اول کاربری که داشبورد ندارد ولی ثبت می‌کند، «ورود و خروج» است (بخش ۱۵.۲ spec).
        if (Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/') is "" && !Session.Can(Permissions.DashboardView)
            && (Session.Can(Permissions.WithdrawalCreate) || Session.Can(Permissions.ReceiptSubmit)))
        {
            Navigation.NavigateTo("stock-io", replace: true);
            return;
        }

        var locations = await LocationsApi.ListAsync();
        if (locations.IsSuccess) _locations = locations.Value!;
        _categories = (await CategoriesApi.ListAsync()).Value ?? [];
        _categoryId = CategoryQuery;
        await LoadAsync();
    }

    private Task OnCategoryChangedAsync(ChangeEventArgs e)
    {
        _categoryId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        return LoadAsync();
    }

    // متن بی‌فاصله‌ی بلند (بارکد یا کد GS1) اول با کد جست‌وجو می‌شود؛ تکه‌ی کوتاه بارکد همان فیلتر عادی است.
    private async Task SearchAsync()
    {
        var text = _query.Trim();
        if (text.Length >= 8 && !ProductLookup.LooksLikeName(text))
        {
            _query = "";
            await OnScanAsync(text);
            return;
        }

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (ReceiveActive && _receive is not null) await _receive.FocusAsync();
        else await _queryInput.FocusAsync();
    }

    private Task OnLocationChangedAsync(Guid? id)
    {
        _locationId = id;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        var result = await ProductsApi.ListAsync(
            _query, _locationId, _filter, CanManage && _includeInactive, _categoryId);
        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        _items = result.Value!;
        _loaded = true;
    }

    private async Task OnScanAsync(string text)
    {
        var lookup = await ProductLookup.ByCodeAsync(ProductsApi, text);
        if (lookup.Kind == LookupKind.Found)
        {
            Navigation.NavigateTo($"products/{lookup.Product!.Summary.Id}");
            return;
        }

        if (lookup.Kind == LookupKind.Error)
        {
            _error = lookup.Error;
            return;
        }

        if (ProductLookup.LooksLikeName(text))
        {
            _query = text;
            await LoadAsync();
            return;
        }

        if (CanManage)
        {
            _unknownCode = text;
            _pickQuery = "";
            _pickResults = null;
            _pickId = null;
            _dialogError = null;
        }
        else
        {
            Toasts.Show("بارکد ناشناخته؛ با نام جست‌وجو کنید و به انباردار بگویید", isWarning: true);
        }
    }

    private async Task OnPickKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchPickAsync();
    }

    private async Task SearchPickAsync()
    {
        _dialogError = null;
        var result = await ProductsApi.ListAsync(_pickQuery);
        if (!result.IsSuccess)
        {
            _dialogError = result.ErrorMessage;
            return;
        }

        _pickResults = result.Value!;
        if (_pickId is { } id && _pickResults.All(p => p.Id != id)) _pickId = null;
    }

    private async Task RegisterBarcodeAsync()
    {
        if (_unknownCode is not { } code || _pickId is not { } id) return;

        _busy = true;
        _dialogError = null;
        var result = await ProductsApi.AddBarcodeAsync(id, code);
        _busy = false;

        if (!result.IsSuccess)
        {
            _dialogError = result.ErrorMessage;
            return;
        }

        Toasts.Show($"بارکد ثبت شد: {result.Value!.Summary.Name}");
        CloseUnknown();
        Navigation.NavigateTo($"products/{id}");
    }

    private async Task CloseUnknownAsync()
    {
        _unknownCode = null;
        await _queryInput.FocusAsync();
    }

    private void CloseUnknown() => _ = CloseUnknownAsync();
}
