@page "/products/{Id:guid}"
@attribute [Authorize]
@using PharmacyWarehouse.Domain.Stock
@inject ProductsClient ProductsApi
@inject StockClient StockApi
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject ApiAuthenticationStateProvider Session

<PageTitle>@(_detail?.Summary.Name ?? "قلم") | انبار داروخانه</PageTitle>

<RequirePermission Permission="@Permissions.StockView">
<p><a href="" class="btn btn-sm btn-quiet">بازگشت به اقلام</a></p>

@if (_error is not null)
{
    <div class="form-alert" role="alert">
        <AppIcon Name="warning" /> <span>@_error</span>
        <button type="button" class="btn btn-sm btn-quiet" @onclick="LoadAsync">تازه‌سازی</button>
    </div>
}

@if (_detail is null)
{
    @if (_error is null)
    {
        <div class="loading-line">در حال بارگذاری…</div>
    }
}
else
{
    var summary = _detail.Summary;
    <div class="page-head">
        <div>
            <h1>
                @summary.Name
                @if (!summary.IsActive)
                {
                    <span class="status-badge status-retired">غیرفعال</span>
                }
            </h1>
            <p>@string.Join(" · ", new[] { summary.Brand, summary.PackDescription }.Where(s => !string.IsNullOrEmpty(s)))</p>
        </div>
        <div class="device-actions">
            @if (Session.Can(Permissions.StockReceive))
            {
                <a class="btn btn-primary" href="receive?productId=@summary.Id"><AppIcon Name="plus" Size="15" /> ورود جنس</a>
            }
            @if (CanManage)
            {
                <a class="btn btn-quiet" href="products/@summary.Id/edit"><AppIcon Name="edit" Size="15" /> ویرایش</a>
                <button type="button" class="btn btn-quiet" disabled="@_busy" @onclick="ToggleActiveAsync">@(summary.IsActive ? "غیرفعال کن" : "فعال کن")</button>
                <button type="button" class="btn btn-danger-quiet" @onclick="() => _showDelete = true"><AppIcon Name="trash" Size="15" /> حذف</button>
            }
        </div>
    </div>

    <section class="card-emu">
        <dl class="spec-list">
            <div><dt>موجودی</dt><dd>@JalaliDate.ToPersianDigits(summary.OnHand.ToString()) جعبه</dd></div>
            <div><dt>موجودی منقضی‌نشده</dt><dd>@JalaliDate.ToPersianDigits(summary.UsableOnHand.ToString()) جعبه</dd></div>
            <div><dt>حداقل موجودی</dt><dd>@(summary.MinStock is { } min ? JalaliDate.ToPersianDigits(min.ToString()) + " جعبه" : "—")</dd></div>
            <div><dt>محل</dt><dd><bdi>@(summary.LocationPath ?? "—")</bdi></dd></div>
            <div><dt>انقضا لازم است</dt><dd>@(_detail.RequiresExpiry ? "بله" : "خیر")</dd></div>
            <div>
                <dt>برداشت از بچ منقضی</dt>
                <dd>
                    @if (_detail.AllowExpiredWithdrawal)
                    {
                        <span class="status-badge status-expired">مجاز</span>
                    }
                    else
                    {
                        <span>مجاز نیست</span>
                    }
                </dd>
            </div>
        </dl>
    </section>

    <section class="card-emu">
        <h2>بچ‌ها</h2>
        @if (_detail.Batches.Count == 0)
        {
            <div class="empty-state"><p>هنوز بچی ثبت نشده. با «ورود جنس» اضافه می‌شود.</p></div>
        }
        else
        {
            <div class="table-card">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>شماره‌ی بچ</th><th>محل</th><th>انقضا</th><th>موجودی (جعبه)</th>
                            @if (CanAdjust)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in _detail.Batches)
                        {
                            <tr @key="batch.Id">
                                <td><bdi>@batch.BatchNumber</bdi></td>
                                <td><bdi>@(batch.LocationPath ?? "—")</bdi></td>
                                <td>
                                    @(batch.ExpiryText ?? "—")
                                    @if (batch.IsExpired)
                                    {
                                        <span class="status-badge status-expired">منقضی</span>
                                    }
                                </td>
                                <td>@JalaliDate.ToPersianDigits(batch.OnHand.ToString())</td>
                                @if (CanAdjust)
                                {
                                    <td>
                                        <button type="button" class="btn btn-sm btn-quiet" @onclick="() => OpenAdjust(batch)">اصلاح</button>
                                        <button type="button" class="btn btn-sm btn-danger-quiet" disabled="@(batch.OnHand == 0)" @onclick="() => OpenDispose(batch)">اسقاط</button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card-emu">
        <h2>بارکدها</h2>
        @if (_detail.Barcodes.Count == 0)
        {
            <div class="form-hint">بارکدی ثبت نشده.</div>
        }
        @foreach (var barcode in _detail.Barcodes)
        {
            <div class="linked-item" @key="barcode.Id">
                <span style="flex:1;"><bdi class="mono">@barcode.Code</bdi></span>
                @if (CanManage)
                {
                    <button type="button" class="icon-button danger" title="حذف بارکد" aria-label="حذف بارکد @barcode.Code" disabled="@_busy" @onclick="() => RemoveBarcodeAsync(barcode)"><AppIcon Name="trash" Size="16" /></button>
                }
            </div>
        }

        @if (CanManage)
        {
            <div class="mt-3" style="max-width:420px;">
                <label for="barcode-add" class="form-hint">افزودن بارکد: با بارکدخوان اسکن کنید یا تایپ کنید و Enter بزنید</label>
                <ScanInput @ref="_scan" OnScan="AddBarcodeAsync" Placeholder="بارکد جدید" AutoFocus="false" />
                @if (_barcodeError is not null)
                {
                    <div class="form-alert mt-2 mb-0" role="alert">@_barcodeError</div>
                }
            </div>
        }
    </section>

    <section class="card-emu">
        <h2>حرکت‌ها</h2>
        @if (_historyError is not null)
        {
            <div class="form-alert" role="alert"><span>@_historyError</span></div>
        }
        else if (_history is null)
        {
            <div class="loading-line">در حال بارگذاری…</div>
        }
        else if (_history.Movements.Count == 0)
        {
            <div class="empty-state"><p>هنوز حرکتی ثبت نشده.</p></div>
        }
        else
        {
            <div class="toolbar">
                <div>
                    <label for="movement-kind">نوع حرکت</label>
                    <select id="movement-kind" class="form-select" value="@_kindFilter?.ToString()" @onchange="OnKindFilterChanged">
                        <option value="">همه</option>
                        @foreach (var kind in Enum.GetValues<StockMovementKind>())
                        {
                            <option value="@kind">@MovementLabels.Kind(kind)</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="movement-sort">ترتیب</label>
                    <select id="movement-sort" class="form-select" value="@(_newestFirst ? "new" : "old")" @onchange="OnSortChanged">
                        <option value="new">جدیدترین اول</option>
                        <option value="old">قدیمی‌ترین اول</option>
                    </select>
                </div>
            </div>
            @if (VisibleMovements().Count == 0)
            {
                <div class="empty-state"><p>با این فیلتر حرکتی نیست.</p></div>
            }
            else
            {
            <div class="table-card">
                <table class="data-table">
                    <thead>
                        <tr><th>زمان</th><th>نوع</th><th>بچ</th><th>تعداد</th><th>موجودی قلم بعد از حرکت</th><th>موجودی بچ بعد از حرکت</th><th>کاربر</th><th>یادداشت</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var movement in VisibleMovements())
                        {
                            <tr @key="movement.Id">
                                <td>@JalaliDate.Format(movement.OccurredAtUtc)</td>
                                <td>@MovementLabels.Kind(movement.Kind)</td>
                                <td><bdi>@movement.BatchNumber</bdi></td>
                                <td dir="ltr" style="text-align:right;">@Signed(movement.Quantity)</td>
                                <td dir="ltr" style="text-align:right;">@Num(movement.BalanceAfter)</td>
                                <td dir="ltr" style="text-align:right;">@Num(movement.BatchBalanceAfter)</td>
                                <td>@movement.UserName</td>
                                <td>@movement.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            }
        }
    </section>

    <section class="card-emu">
        <h2>تغییرات</h2>
        @if (_history is null)
        {
            @if (_historyError is null)
            {
                <div class="loading-line">در حال بارگذاری…</div>
            }
        }
        else if (_history.Changes.Count == 0)
        {
            <div class="empty-state"><p>تغییری ثبت نشده.</p></div>
        }
        else
        {
            <ChangeList Changes="_history.Changes" />
        }
    </section>

    @if (_showDelete)
    {
        <DeleteDialog Title="حذف قلم" ItemName="@summary.Name"
                      Load="() => ProductsApi.DependenciesAsync(Id)"
                      Delete="() => ProductsApi.DeleteAsync(Id)"
                      OnCancel="() => _showDelete = false"
                      OnDeleted="OnDeletedAsync" />
    }

    @if (_adjusting is { } adjusting)
    {
        <ModalDialog Title="@($"اصلاح موجودی بچ {adjusting.BatchNumber}")" OnClose="CloseBatchDialog">
            <EditForm Model="this" OnSubmit="SaveAdjustAsync">
                <p class="form-hint">موجودی فعلی: @JalaliDate.ToPersianDigits(adjusting.OnHand.ToString()) جعبه. تعداد واقعی را وارد کنید؛ تفاوت به‌صورت یک حرکت اصلاح ثبت می‌شود.</p>
                <div class="form-field">
                    <label for="adjust-counted">تعداد شمرده‌شده <span class="required">*</span></label>
                    <input id="adjust-counted" class="form-control" type="number" min="0" dir="ltr" @bind="_counted" />
                </div>
                <div class="form-field mt-3">
                    <label for="adjust-note">یادداشت <span class="required">*</span></label>
                    <input id="adjust-note" class="form-control" maxlength="@ProductRules.MaxNote" @bind="_batchNote" />
                </div>
                @if (_batchError is not null)
                {
                    <div class="form-alert mt-3 mb-0" role="alert">@_batchError</div>
                }
                <div class="modal-actions">
                    <button type="submit" class="btn btn-primary" disabled="@_batchBusy">@(_batchBusy ? "در حال ثبت…" : "ثبت اصلاح")</button>
                    <button type="button" class="btn btn-quiet" @onclick="CloseBatchDialog">انصراف</button>
                </div>
            </EditForm>
        </ModalDialog>
    }

    @if (_disposing is { } disposing)
    {
        <ModalDialog Title="@($"اسقاط از بچ {disposing.BatchNumber}")" OnClose="CloseBatchDialog">
            <EditForm Model="this" OnSubmit="SaveDisposeAsync">
                <p class="form-hint">موجودی فعلی: @JalaliDate.ToPersianDigits(disposing.OnHand.ToString()) جعبه.</p>
                <div class="form-field">
                    <label for="dispose-quantity">تعداد <span class="required">*</span></label>
                    <input id="dispose-quantity" class="form-control" type="number" min="1" max="@disposing.OnHand" dir="ltr" @bind="_disposeQuantity" />
                </div>
                <div class="form-field mt-3">
                    <label for="dispose-reason">دلیل <span class="required">*</span></label>
                    <select id="dispose-reason" class="form-select" @bind="_disposeReason">
                        @foreach (var reason in Enum.GetValues<DisposalReason>())
                        {
                            <option value="@reason">@DisposalRules.Label(reason)</option>
                        }
                    </select>
                </div>
                <div class="form-field mt-3">
                    <label for="dispose-note">یادداشت <span class="required">*</span></label>
                    <input id="dispose-note" class="form-control" maxlength="@ProductRules.MaxNote" @bind="_batchNote" />
                </div>
                @if (_batchError is not null)
                {
                    <div class="form-alert mt-3 mb-0" role="alert">@_batchError</div>
                }
                <div class="modal-actions">
                    <button type="submit" class="btn btn-danger-quiet" disabled="@_batchBusy">@(_batchBusy ? "در حال ثبت…" : "ثبت اسقاط")</button>
                    <button type="button" class="btn btn-quiet" @onclick="CloseBatchDialog">انصراف</button>
                </div>
            </EditForm>
        </ModalDialog>
    }
}
</RequirePermission>

@code {
    [Parameter] public Guid Id { get; set; }

    private ProductDetail? _detail;
    private ProductHistory? _history;
    private string? _error;
    private string? _historyError;
    private string? _barcodeError;
    private bool _busy;
    private bool _showDelete;
    private Guid _loadedId;
    private ScanInput? _scan;
    private BatchItem? _adjusting;
    private BatchItem? _disposing;
    private int _counted;
    private int _disposeQuantity = 1;
    private DisposalReason _disposeReason = DisposalReason.Damaged;
    private string? _batchNote;
    private string? _batchError;
    private bool _batchBusy;
    private StockMovementKind? _kindFilter;
    private bool _newestFirst = true;

    private bool CanManage => Session.Can(Permissions.ProductsManage);
    private bool CanAdjust => Session.Can(Permissions.StockAdjust);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id) return;

        _loadedId = Id;
        _detail = null;
        _history = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        var result = await ProductsApi.GetAsync(Id);
        if (!result.IsSuccess)
        {
            _error = result.Outcome == ApiOutcome.NotFound ? "این قلم پیدا نشد؛ شاید حذف شده است." : result.ErrorMessage;
            return;
        }

        _detail = result.Value!;
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        _historyError = null;
        var result = await ProductsApi.HistoryAsync(Id);
        if (result.IsSuccess) _history = result.Value!;
        else _historyError = result.ErrorMessage;
    }

    private async Task ToggleActiveAsync()
    {
        if (_detail is null) return;

        _busy = true;
        var result = await ProductsApi.SetActiveAsync(_detail.Summary, !_detail.Summary.IsActive);
        _busy = false;

        if (!result.IsSuccess)
        {
            await HandleFailureAsync(result.Outcome, result.Problem, result.ErrorMessage, isBarcode: false);
            return;
        }

        // سرور ProductDetail تازه می‌دهد؛ Version هم عوض شده است.
        _detail = result.Value!;
        await LoadHistoryAsync();
    }

    private async Task AddBarcodeAsync(string code)
    {
        _barcodeError = null;
        var result = await ProductsApi.AddBarcodeAsync(Id, code);
        if (!result.IsSuccess)
        {
            await HandleFailureAsync(result.Outcome, result.Problem, result.ErrorMessage, isBarcode: true);
            return;
        }

        _detail = result.Value!;
        Toasts.Show("بارکد ثبت شد.");
        await LoadHistoryAsync();
    }

    private async Task RemoveBarcodeAsync(BarcodeItem barcode)
    {
        _busy = true;
        _barcodeError = null;
        var result = await ProductsApi.RemoveBarcodeAsync(Id, barcode.Id);
        _busy = false;

        if (!result.IsSuccess)
        {
            await HandleFailureAsync(result.Outcome, result.Problem, result.ErrorMessage, isBarcode: true);
            return;
        }

        _detail = result.Value!;
        await LoadHistoryAsync();
    }

    // ناسازگاری Version: صفحه خودکار تازه می‌شود و پیام سرور toast می‌شود. بقیه‌ی خطاها همان‌جا نشان داده می‌شوند.
    private async Task HandleFailureAsync(ApiOutcome outcome, ApiProblem? problem, string message, bool isBarcode)
    {
        if (outcome == ApiOutcome.Conflict && problem?.Type == ProblemTypes.VersionConflict)
        {
            Toasts.Show(message, isWarning: true);
            await LoadAsync();
            return;
        }

        if (isBarcode) _barcodeError = message;
        else _error = message;
    }

    private void OnDeletedAsync()
    {
        Toasts.Show($"حذف شد: {_detail?.Summary.Name}");
        _showDelete = false;
        Navigation.NavigateTo("");
    }

    private static string Signed(int quantity) =>
        JalaliDate.ToPersianDigits(quantity > 0 ? $"+{quantity}" : quantity.ToString());

    private static string Num(int value) => JalaliDate.ToPersianDigits(value.ToString());

    // فیلتر و ترتیب فقط روی فهرست کامل که سرور می‌دهد اعمال می‌شود؛ موجودی بعد از حرکت از قبل روی همه‌ی حرکت‌ها حساب شده.
    private List<MovementItem> VisibleMovements()
    {
        if (_history is null) return [];

        var items = _kindFilter is { } kind ? _history.Movements.Where(m => m.Kind == kind) : _history.Movements;
        // سرور از جدید به قدیم می‌فرستد؛ برای «قدیمی‌ترین اول» برعکس می‌کنیم.
        return (_newestFirst ? items : items.Reverse()).ToList();
    }

    private void OnKindFilterChanged(ChangeEventArgs e) =>
        _kindFilter = Enum.TryParse<StockMovementKind>(e.Value?.ToString(), out var kind) ? kind : null;

    private void OnSortChanged(ChangeEventArgs e) => _newestFirst = e.Value?.ToString() != "old";

    private void OpenAdjust(BatchItem batch)
    {
        _batchError = null;
        _counted = batch.OnHand;
        _batchNote = null;
        _adjusting = batch;
    }

    private void OpenDispose(BatchItem batch)
    {
        _batchError = null;
        _disposeQuantity = 1;
        _disposeReason = batch.IsExpired ? DisposalReason.Expired : DisposalReason.Damaged;
        _batchNote = null;
        _disposing = batch;
    }

    private void CloseBatchDialog()
    {
        _adjusting = null;
        _disposing = null;
    }

    private async Task SaveAdjustAsync()
    {
        if (_adjusting is not { } batch || _batchBusy) return;

        _batchBusy = true;
        _batchError = null;
        var result = await StockApi.AdjustAsync(batch.Id, new AdjustBatchRequest { Counted = _counted, Note = _batchNote, Version = batch.Version });
        _batchBusy = false;
        await FinishBatchActionAsync(result, "اصلاح ثبت شد.");
    }

    private async Task SaveDisposeAsync()
    {
        if (_disposing is not { } batch || _batchBusy) return;

        _batchBusy = true;
        _batchError = null;
        var result = await StockApi.DisposeAsync(batch.Id, new DisposeBatchRequest { Quantity = _disposeQuantity, Reason = _disposeReason, Note = _batchNote, Version = batch.Version });
        _batchBusy = false;
        await FinishBatchActionAsync(result, "اسقاط ثبت شد.");
    }

    // ۴۰۹: موجودی یا Version بچ عوض شده؛ پنجره بسته می‌شود و صفحه تازه تا کاربر عدد درست را ببیند.
    private async Task FinishBatchActionAsync(ApiResult<BatchItem> result, string success)
    {
        if (result.IsSuccess)
        {
            CloseBatchDialog();
            Toasts.Show(success);
            await LoadAsync();
        }
        else if (result.Outcome == ApiOutcome.Conflict)
        {
            CloseBatchDialog();
            Toasts.Show(result.ErrorMessage, isWarning: true);
            await LoadAsync();
        }
        else
        {
            _batchError = result.ErrorMessage;
        }
    }
}
