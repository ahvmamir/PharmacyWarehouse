@page "/products/{Id:guid}"
@attribute [Authorize]
@using PharmacyWarehouse.Domain.Stock
@inject ProductsClient ProductsApi
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject ApiAuthenticationStateProvider Session

<PageTitle>@(_detail?.Summary.Name ?? "قلم") | انبار داروخانه</PageTitle>

<RequirePermission Permission="@Permissions.StockView">
<p><a href="" class="btn btn-sm btn-quiet">بازگشت به اقلام</a></p>

@if (_error is not null)
{
    <div class="form-alert" role="alert">
        <AppIcon Name="warning" /> <span>@_error</span>
        <button type="button" class="btn btn-sm btn-quiet" @onclick="LoadAsync">تازه‌سازی</button>
    </div>
}

@if (_detail is null)
{
    @if (_error is null)
    {
        <div class="loading-line">در حال بارگذاری…</div>
    }
}
else
{
    var summary = _detail.Summary;
    <div class="page-head">
        <div>
            <h1>
                @summary.Name
                @if (!summary.IsActive)
                {
                    <span class="status-badge status-retired">غیرفعال</span>
                }
            </h1>
            <p>@string.Join(" · ", new[] { summary.Brand, summary.PackDescription }.Where(s => !string.IsNullOrEmpty(s)))</p>
        </div>
        <div class="device-actions">
            @if (Session.Can(Permissions.StockReceive))
            {
                <a class="btn btn-primary" href="receive?productId=@summary.Id"><AppIcon Name="plus" Size="15" /> ورود جنس</a>
            }
            @if (CanManage)
            {
                <a class="btn btn-primary" href="products/@summary.Id/edit"><AppIcon Name="edit" Size="15" /> ویرایش</a>
                <button type="button" class="btn btn-quiet" disabled="@_busy" @onclick="ToggleActiveAsync">@(summary.IsActive ? "غیرفعال کن" : "فعال کن")</button>
                <button type="button" class="btn btn-danger-quiet" @onclick="() => _showDelete = true"><AppIcon Name="trash" Size="15" /> حذف</button>
            }
        </div>
    </div>

    <section class="card-emu">
        <dl class="spec-list">
            <div><dt>موجودی</dt><dd>@JalaliDate.ToPersianDigits(summary.OnHand.ToString()) جعبه</dd></div>
            <div><dt>موجودی منقضی‌نشده</dt><dd>@JalaliDate.ToPersianDigits(summary.UsableOnHand.ToString()) جعبه</dd></div>
            <div><dt>حداقل موجودی</dt><dd>@(summary.MinStock is { } min ? JalaliDate.ToPersianDigits(min.ToString()) + " جعبه" : "—")</dd></div>
            <div><dt>محل</dt><dd><bdi>@(summary.LocationPath ?? "—")</bdi></dd></div>
            <div><dt>انقضا لازم است</dt><dd>@(_detail.RequiresExpiry ? "بله" : "خیر")</dd></div>
            <div>
                <dt>برداشت از بچ منقضی</dt>
                <dd>
                    @if (_detail.AllowExpiredWithdrawal)
                    {
                        <span class="status-badge status-expired">مجاز</span>
                    }
                    else
                    {
                        <span>مجاز نیست</span>
                    }
                </dd>
            </div>
        </dl>
    </section>

    <section class="card-emu">
        <h2>بچ‌ها</h2>
        @if (_detail.Batches.Count == 0)
        {
            <div class="empty-state"><p>هنوز بچی ثبت نشده. با «ورود جنس» اضافه می‌شود.</p></div>
        }
        else
        {
            <div class="table-card">
                <table class="data-table">
                    <thead>
                        <tr><th>شماره‌ی بچ</th><th>محل</th><th>انقضا</th><th>موجودی (جعبه)</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in _detail.Batches)
                        {
                            <tr @key="batch.Id">
                                <td><bdi>@batch.BatchNumber</bdi></td>
                                <td><bdi>@(batch.LocationPath ?? "—")</bdi></td>
                                <td>
                                    @(batch.ExpiryText ?? "—")
                                    @if (batch.IsExpired)
                                    {
                                        <span class="status-badge status-expired">منقضی</span>
                                    }
                                </td>
                                <td>@JalaliDate.ToPersianDigits(batch.OnHand.ToString())</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card-emu">
        <h2>بارکدها</h2>
        @if (_detail.Barcodes.Count == 0)
        {
            <div class="form-hint">بارکدی ثبت نشده.</div>
        }
        @foreach (var barcode in _detail.Barcodes)
        {
            <div class="linked-item" @key="barcode.Id">
                <span style="flex:1;"><bdi class="mono">@barcode.Code</bdi></span>
                @if (CanManage)
                {
                    <button type="button" class="icon-button danger" title="حذف بارکد" aria-label="حذف بارکد @barcode.Code" disabled="@_busy" @onclick="() => RemoveBarcodeAsync(barcode)"><AppIcon Name="trash" Size="16" /></button>
                }
            </div>
        }

        @if (CanManage)
        {
            <div class="mt-3" style="max-width:420px;">
                <label for="barcode-add" class="form-hint">افزودن بارکد: با بارکدخوان اسکن کنید یا تایپ کنید و Enter بزنید</label>
                <ScanInput @ref="_scan" OnScan="AddBarcodeAsync" Placeholder="بارکد جدید" AutoFocus="false" />
                @if (_barcodeError is not null)
                {
                    <div class="form-alert mt-2 mb-0" role="alert">@_barcodeError</div>
                }
            </div>
        }
    </section>

    <section class="card-emu">
        <h2>حرکت‌ها</h2>
        @if (_historyError is not null)
        {
            <div class="form-alert" role="alert"><span>@_historyError</span></div>
        }
        else if (_history is null)
        {
            <div class="loading-line">در حال بارگذاری…</div>
        }
        else if (_history.Movements.Count == 0)
        {
            <div class="empty-state"><p>هنوز حرکتی ثبت نشده.</p></div>
        }
        else
        {
            <div class="table-card">
                <table class="data-table">
                    <thead>
                        <tr><th>زمان</th><th>نوع</th><th>بچ</th><th>تعداد</th><th>کاربر</th><th>یادداشت</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var movement in _history.Movements)
                        {
                            <tr @key="movement.Id">
                                <td>@JalaliDate.Format(movement.OccurredAtUtc)</td>
                                <td>@KindLabel(movement.Kind)</td>
                                <td><bdi>@movement.BatchNumber</bdi></td>
                                <td dir="ltr" style="text-align:right;">@Signed(movement.Quantity)</td>
                                <td>@movement.UserName</td>
                                <td>@movement.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card-emu">
        <h2>تغییرات</h2>
        @if (_history is null)
        {
            @if (_historyError is null)
            {
                <div class="loading-line">در حال بارگذاری…</div>
            }
        }
        else if (_history.Changes.Count == 0)
        {
            <div class="empty-state"><p>تغییری ثبت نشده.</p></div>
        }
        else
        {
            <ChangeList Changes="_history.Changes" />
        }
    </section>

    @if (_showDelete)
    {
        <DeleteDialog Title="حذف قلم" ItemName="@summary.Name"
                      Load="() => ProductsApi.DependenciesAsync(Id)"
                      Delete="() => ProductsApi.DeleteAsync(Id)"
                      OnCancel="() => _showDelete = false"
                      OnDeleted="OnDeletedAsync" />
    }
}
</RequirePermission>

@code {
    [Parameter] public Guid Id { get; set; }

    private ProductDetail? _detail;
    private ProductHistory? _history;
    private string? _error;
    private string? _historyError;
    private string? _barcodeError;
    private bool _busy;
    private bool _showDelete;
    private Guid _loadedId;
    private ScanInput? _scan;

    private bool CanManage => Session.Can(Permissions.ProductsManage);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id) return;

        _loadedId = Id;
        _detail = null;
        _history = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        var result = await ProductsApi.GetAsync(Id);
        if (!result.IsSuccess)
        {
            _error = result.Outcome == ApiOutcome.NotFound ? "این قلم پیدا نشد؛ شاید حذف شده است." : result.ErrorMessage;
            return;
        }

        _detail = result.Value!;
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        _historyError = null;
        var result = await ProductsApi.HistoryAsync(Id);
        if (result.IsSuccess) _history = result.Value!;
        else _historyError = result.ErrorMessage;
    }

    private async Task ToggleActiveAsync()
    {
        if (_detail is null) return;

        _busy = true;
        var result = await ProductsApi.SetActiveAsync(_detail.Summary, !_detail.Summary.IsActive);
        _busy = false;

        if (!result.IsSuccess)
        {
            await HandleFailureAsync(result.Outcome, result.Problem, result.ErrorMessage, isBarcode: false);
            return;
        }

        // سرور ProductDetail تازه می‌دهد؛ Version هم عوض شده است.
        _detail = result.Value!;
        await LoadHistoryAsync();
    }

    private async Task AddBarcodeAsync(string code)
    {
        _barcodeError = null;
        var result = await ProductsApi.AddBarcodeAsync(Id, code);
        if (!result.IsSuccess)
        {
            await HandleFailureAsync(result.Outcome, result.Problem, result.ErrorMessage, isBarcode: true);
            return;
        }

        _detail = result.Value!;
        Toasts.Show("بارکد ثبت شد.");
        await LoadHistoryAsync();
    }

    private async Task RemoveBarcodeAsync(BarcodeItem barcode)
    {
        _busy = true;
        _barcodeError = null;
        var result = await ProductsApi.RemoveBarcodeAsync(Id, barcode.Id);
        _busy = false;

        if (!result.IsSuccess)
        {
            await HandleFailureAsync(result.Outcome, result.Problem, result.ErrorMessage, isBarcode: true);
            return;
        }

        _detail = result.Value!;
        await LoadHistoryAsync();
    }

    // ناسازگاری Version: صفحه خودکار تازه می‌شود و پیام سرور toast می‌شود. بقیه‌ی خطاها همان‌جا نشان داده می‌شوند.
    private async Task HandleFailureAsync(ApiOutcome outcome, ApiProblem? problem, string message, bool isBarcode)
    {
        if (outcome == ApiOutcome.Conflict && problem?.Type == ProblemTypes.VersionConflict)
        {
            Toasts.Show(message, isWarning: true);
            await LoadAsync();
            return;
        }

        if (isBarcode) _barcodeError = message;
        else _error = message;
    }

    private void OnDeletedAsync()
    {
        Toasts.Show($"حذف شد: {_detail?.Summary.Name}");
        _showDelete = false;
        Navigation.NavigateTo("");
    }

    private static string Signed(int quantity) =>
        JalaliDate.ToPersianDigits(quantity > 0 ? $"+{quantity}" : quantity.ToString());

    private static string KindLabel(StockMovementKind kind) => kind switch
    {
        StockMovementKind.Import => "ورود از Excel",
        StockMovementKind.Receipt => "ورود جنس",
        StockMovementKind.Withdrawal => "برداشت",
        StockMovementKind.Reversal => "برگشت",
        StockMovementKind.Adjustment => "اصلاح",
        StockMovementKind.Disposal => "اسقاط",
        _ => kind.ToString()
    };
}
