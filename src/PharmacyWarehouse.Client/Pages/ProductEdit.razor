@page "/products/new"
@page "/products/{Id:guid}/edit"
@attribute [Authorize]
@inject NavigationManager Navigation

@* پیوند مستقیم؛ رابط اصلی پنجره‌ی کناری در «اقلام» و «جزئیات قلم» است (بخش ۱۵.۳ spec). *@

<PageTitle>@(Id is null ? "قلم جدید" : "ویرایش قلم") | داروبار</PageTitle>

<RequirePermission Permission="@Permissions.ProductsManage">
<div class="page-head">
    <div>
        <h1>@(Id is null ? "تعریف قلم" : "ویرایش قلم")</h1>
        <p>قلم تعریف کالاست و با موجودی جداست؛ قلم بدون موجودی هم معتبر است. موجودی با «ورود جنس» اضافه می‌شود.</p>
    </div>
</div>

<ProductForm Id="Id" OnSaved="Saved" OnCancel="Cancel" />
</RequirePermission>

@code {
    [Parameter] public Guid? Id { get; set; }

    private void Saved(ProductDetail detail) => Navigation.NavigateTo($"products/{detail.Summary.Id}");

    private void Cancel() => Navigation.NavigateTo(Id is null ? "" : $"products/{Id}");
}
