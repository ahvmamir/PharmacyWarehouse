@page "/stocktake"
@attribute [Authorize]
@inject EquipmentClient EquipmentApi
@inject CatalogClient Catalog
@inject StocktakeState Round
@inject AlertsClient Server

<PageTitle>انبارگردانی | سامانه تجهیزات IT</PageTitle>

<RequirePermission Permission="@Permissions.EquipmentVerify">
<div class="page-head">
    <div>
        <h1>انبارگردانی</h1>
        <p>دستگاه‌ها را با بارکدخوان اسکن کنید؛ هر اسکن یعنی «دیدمش، همین‌جاست».</p>
    </div>
    @if (Round.StartedAtUtc is not null)
    {
        <button type="button" class="btn btn-quiet" @onclick="EndRound">پایان این نوبت</button>
    }
</div>

@if (Round.StartedAtUtc is null)
{
    <section class="card-emu">
        <div class="card-emu-head"><h2>محدوده‌ی این نوبت</h2></div>
        <div class="card-emu-body">
            <div class="form-grid">
                <div class="form-field">
                    <label for="st-unit">واحد محل</label>
                    <select id="st-unit" class="form-select" @bind="_unitId">
                        <option value="">همه‌ی واحدها</option>
                        @foreach (var unit in _units.Where(u => u.IsActive))
                        {
                            <option value="@unit.Id">@unit.Name</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="st-building">ساختمان</label>
                    <select id="st-building" class="form-select" @bind="_buildingId">
                        <option value="">همه‌ی ساختمان‌ها</option>
                        @foreach (var building in _buildings.Where(b => b.IsActive))
                        {
                            <option value="@building.Id">@building.Name</option>
                        }
                    </select>
                </div>
            </div>
            <button type="button" class="btn btn-primary mt-3" disabled="@_loading" @onclick="StartAsync"><AppIcon Name="scan" /> شروع انبارگردانی</button>
        </div>
    </section>
}
else
{
    <div class="stocktake-scan">
        <div class="search-box">
            <AppIcon Name="scan" Size="20" />
            <input type="search" placeholder="شماره اموال را اسکن یا تایپ کنید و Enter بزنید" aria-label="شماره اموال" autocomplete="off"
                   @bind="_scan" @bind:event="oninput" @onkeydown="OnScanKeyAsync" @ref="_scanInput" disabled="@_busy" />
        </div>
        <div class="stocktake-progress" aria-live="polite">
            <strong>@Number(SeenCount) از @Number(_expected.Count)</strong> دستگاه این محدوده دیده شد
            <span class="cell-sub">@ScopeText، شروع @JalaliDate.FormatTime(Round.StartedAtUtc.Value)</span>
            <div class="progress-track"><span style="width:@ProgressPercent%"></span></div>
        </div>
    </div>

    @if (Round.Log.Count > 0)
    {
        <section class="card-emu">
            <div class="card-emu-head"><h2>اسکن‌های این نوبت</h2></div>
            <ul class="scan-log">
                @foreach (var line in Round.Log.Take(30))
                {
                    <li class="scan-@line.Kind">
                        <AppIcon Name="@(line.Kind == "ok" ? "check" : "warning")" Size="16" />
                        @if (line.EquipmentId is { } id)
                        {
                            <a href="equipment/@id"><bdi>@line.Text</bdi></a>
                        }
                        else
                        {
                            <bdi>@line.Text</bdi>
                        }
                        @if (line.Note is not null)
                        {
                            <span class="cell-sub">@line.Note</span>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    <section class="card-emu">
        <div class="card-emu-head">
            <h2>هنوز دیده نشده (@Number(NotSeen.Count))</h2>
            <button type="button" class="btn btn-sm btn-quiet" disabled="@_loading" @onclick="LoadExpectedAsync">تازه کردن</button>
        </div>
        @if (NotSeen.Count == 0)
        {
            <div class="card-emu-body"><p class="muted mb-0">همه‌ی دستگاه‌های این محدوده دیده شدند.</p></div>
        }
        else
        {
            <table class="data-table">
                <thead><tr><th>شماره اموال</th><th>دستگاه</th><th>محل</th><th>آخرین تأیید حضور</th></tr></thead>
                <tbody>
                    @foreach (var item in NotSeen.Take(300))
                    {
                        <tr @key="item.Id">
                            <td><a href="equipment/@item.Id"><bdi class="asset-tag">@item.AssetNumber</bdi></a></td>
                            <td>@EquipmentText.Title(item)<span class="cell-sub">@AuditLabels.Type(item.Type)</span></td>
                            <td>@item.LocationUnitName<span class="cell-sub">@EquipmentText.Place(item.BuildingName, item.FloorName, item.Room)</span></td>
                            <td class="nowrap">@(item.LastVerifiedAtUtc is { } at ? JalaliDate.FormatDate(at) : "هرگز")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}
</RequirePermission>

@code {
    // بیشتر از این در یک نوبت معنی ندارد؛ محدوده را کوچک‌تر کنید.
    private const int MaxExpected = 2000;

    private List<UnitItem> _units = [];
    private List<BuildingItem> _buildings = [];
    private string? _unitId;
    private string? _buildingId;
    private List<EquipmentListItem> _expected = [];
    private string _scan = "";
    private bool _busy;
    private bool _loading;
    private ElementReference _scanInput;

    private static string Number(int value) => JalaliDate.ToPersianDigits(value.ToString());

    private bool Seen(EquipmentListItem item) => item.LastVerifiedAtUtc >= Round.StartedAtUtc;

    private int SeenCount => _expected.Count(Seen);

    private List<EquipmentListItem> NotSeen => _expected.Where(i => !Seen(i)).ToList();

    private int ProgressPercent => _expected.Count == 0 ? 0 : SeenCount * 100 / _expected.Count;

    private string ScopeText => string.Join("، ", new[]
    {
        _units.FirstOrDefault(u => u.Id == Round.UnitId)?.Name ?? "همه‌ی واحدها",
        _buildings.FirstOrDefault(b => b.Id == Round.BuildingId)?.Name
    }.Where(v => v is not null));

    protected override async Task OnInitializedAsync()
    {
        _units = (await Catalog.UnitsAsync()).Value ?? [];
        _buildings = (await Catalog.BuildingsAsync()).Value ?? [];
        if (Round.StartedAtUtc is not null) await LoadExpectedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Round.StartedAtUtc is not null && !_busy)
        {
            try { await _scanInput.FocusAsync(); } catch (InvalidOperationException) { }
        }
    }

    private async Task StartAsync()
    {
        var now = (await Server.HealthAsync()).Value?.ServerTimeUtc.UtcDateTime ?? DateTime.UtcNow;
        Round.Start(Guid.TryParse(_unitId, out var unit) ? unit : null, Guid.TryParse(_buildingId, out var building) ? building : null, now);
        await LoadExpectedAsync();
    }

    private void EndRound() => Round.End();

    // دستگاه‌های غیراسقاطی محدوده؛ «دیده‌شده» از زمان تأیید سرور می‌آید، پس با ترک صفحه از دست نمی‌رود.
    private async Task LoadExpectedAsync()
    {
        _loading = true;
        try
        {
            var all = new List<EquipmentListItem>();
            for (var page = 1; all.Count < MaxExpected; page++)
            {
                var result = await EquipmentApi.ListAsync(new EquipmentQuery
                {
                    LocationUnitId = Round.UnitId, BuildingId = Round.BuildingId, Page = page, PageSize = 200,
                    Sort = EquipmentSort.Location
                });
                if (!result.IsSuccess || result.Value!.Items.Count == 0) break;
                all.AddRange(result.Value.Items);
                if (all.Count >= result.Value.Total) break;
            }
            _expected = all;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnScanKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var text = _scan.Trim();
        _scan = "";
        if (text.Length == 0) return;

        _busy = true;
        try
        {
            await ScanAsync(text);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ScanAsync(string assetNumber)
    {
        var lookup = await EquipmentApi.LookupByAssetNumberAsync(assetNumber);
        if (!lookup.IsSuccess)
        {
            Round.Add("error", assetNumber, lookup.ErrorMessage, null);
            return;
        }

        if (lookup.Value is not [var device])
        {
            Round.Add("error", assetNumber, "این شماره در سامانه ثبت نشده است.", null);
            return;
        }

        var title = $"{device.AssetNumber}: {AuditLabels.Type(device.Type)} {EquipmentText.Title(device)}";
        if (device.Status == EquipmentStatus.Retired)
        {
            Round.Add("warn", title, "در سامانه اسقاط است ولی این‌جا دیده شد؛ بررسی کنید.", device.Id);
            return;
        }

        if (device.LastVerifiedAtUtc >= Round.StartedAtUtc)
        {
            Round.Add("ok", title, "در همین نوبت قبلاً اسکن شده بود.", device.Id);
            return;
        }

        var result = await EquipmentApi.VerifyAsync(device.Id, device.Version);
        if (!result.IsSuccess)
        {
            Round.Add("error", title, result.ErrorMessage, device.Id);
            return;
        }

        var verified = result.Value!;
        var inScope = (Round.UnitId is null || verified.LocationUnitId == Round.UnitId)
                      && (Round.BuildingId is null || verified.BuildingId == Round.BuildingId);
        Round.Add(inScope ? "ok" : "warn", title,
            inScope ? null : $"طبق سامانه در {verified.LocationUnitName} است؛ اگر جابه‌جا شده، محلش را در صفحه‌ی دستگاه درست کنید.",
            device.Id);

        // همان دستگاه در فهرست انتظار تازه می‌شود تا شمارنده جلو برود.
        var index = _expected.FindIndex(i => i.Id == device.Id);
        if (index >= 0)
        {
            var old = _expected[index];
            _expected[index] = new EquipmentListItem
            {
                Id = old.Id, Type = old.Type, Status = old.Status, AssetNumber = old.AssetNumber, HasTemporaryAssetNumber = old.HasTemporaryAssetNumber,
                Brand = old.Brand, Model = old.Model, PeripheralKind = old.PeripheralKind, ComputerName = old.ComputerName,
                OwnerUnitName = old.OwnerUnitName, BuildingName = old.BuildingName, FloorName = old.FloorName,
                LocationUnitName = old.LocationUnitName, Room = old.Room, UpdatedAtUtc = old.UpdatedAtUtc,
                LastVerifiedAtUtc = verified.LastVerifiedAtUtc, Version = verified.Version
            };
        }
    }
}
