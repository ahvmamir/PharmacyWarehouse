@page "/equipment/labels"
@attribute [Authorize]
@inject EquipmentClient EquipmentApi
@inject EquipmentListState State
@inject IJSRuntime JS
@inject AppInfoState AppInfo

<PageTitle>چاپ برچسب | سامانه تجهیزات IT</PageTitle>

@* اندازه‌ی صفحه‌ی چاپ به نوع برچسب بستگی دارد؛ این قاعده بعد از app.css می‌آید و @page آن را جایگزین می‌کند. *@
<HeadContent>
    <style>
        @(_layout == "roll"
            ? "@page { size: 50mm 30mm; margin: 0; }"
            : "@page { size: A4 portrait; margin: 8mm; }")
    </style>
</HeadContent>

<div class="no-print">
    <a class="breadcrumb-link" href="@(Id is { } id ? $"equipment/{id}" : "")"><AppIcon Name="chevron" Size="14" /> @(Id is null ? "تجهیزات" : "بازگشت به دستگاه")</a>
    <div class="page-head">
        <div>
            <h1>چاپ برچسب اموال</h1>
            @if (Id is null && string.IsNullOrEmpty(Ids))
            {
                <p>دستگاه‌های فهرست فعلی تجهیزات، با همان جست‌وجو و فیلتر.</p>
            }
        </div>
        <button type="button" class="btn btn-primary" disabled="@(_items.Count == 0)" @onclick="PrintAsync"><AppIcon Name="print" /> چاپ</button>
    </div>

    <div class="label-options">
        <div>
            <label class="form-label" for="l-layout">نوع برچسب</label>
            <select id="l-layout" class="form-select form-select-sm" @bind="_layout">
                <option value="sheet">برگه‌ی A4 (سه ستون)</option>
                <option value="roll">چاپگر برچسب ۵۰×۳۰ میلی‌متر</option>
            </select>
        </div>
        <div>
            <label class="form-label" for="l-title">عنوان بالای برچسب</label>
            <input id="l-title" class="form-control form-control-sm" maxlength="40" placeholder="مثلاً: اموال واحد IT" @bind="_title" @bind:event="oninput" />
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="form-alert" role="alert"><AppIcon Name="warning" /> <span>@_error</span></div>
    }
    else if (_loading)
    {
        <div class="loading-line">در حال بارگذاری…</div>
    }
    else if (_items.Count == 0)
    {
        <div class="empty-state"><AppIcon Name="barcode" Size="40" /><h2>دستگاهی برای چاپ نیست</h2><p>در صفحه‌ی تجهیزات جست‌وجو یا فیلتر را تغییر دهید.</p></div>
    }
    else
    {
        <p class="muted-line">
            @Number(_items.Count) برچسب
            @if (_total > _items.Count)
            {
                <span>(از @Number(_total) دستگاه؛ فقط @Number(MaxLabels) تای اول. فیلتر را دقیق‌تر کنید.)</span>
            }
            @if (_noBarcode > 0)
            {
                <span>؛ @Number(_noBarcode) شماره با نویسه‌ی غیرلاتین بارکد ندارد.</span>
            }
        </p>
    }
</div>

<div class="labels labels-@_layout">
    @foreach (var item in _items)
    {
        <div class="asset-label" @key="item.Id">
            @if (!string.IsNullOrWhiteSpace(_title))
            {
                <div class="asset-label-title">@_title</div>
            }
            <Barcode Value="@item.AssetNumber" />
            <div class="asset-label-number"><bdi>@item.AssetNumber</bdi></div>
            <div class="asset-label-meta">
                <span>@AuditLabels.Type(item.Type) @EquipmentText.Title(item)</span>
                <span>@item.OwnerUnitName</span>
            </div>
        </div>
    }
</div>

@code {
    private const int MaxLabels = 200;

    [SupplyParameterFromQuery(Name = "id")] public Guid? Id { get; set; }

    // دستگاه‌های انتخاب‌شده در فهرست (کار گروهی)، با کاما.
    [SupplyParameterFromQuery(Name = "ids")] public string? Ids { get; set; }

    private List<EquipmentListItem> _items = [];
    private int _total;
    private int _noBarcode;
    private bool _loading = true;
    private string? _error;
    private string _layout = "sheet";
    private string? _title;

    private static string Number(int value) => JalaliDate.ToPersianDigits(value.ToString());

    protected override async Task OnInitializedAsync()
    {
        // پیش‌فرض عنوان برچسب: نام بیمارستان از تنظیمات سرور، اگر تعریف شده باشد.
        _title ??= (await AppInfo.LoadAsync()).Organization;

        var selected = (Ids ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(v => Guid.TryParse(v, out var g) ? g : Guid.Empty).Where(g => g != Guid.Empty).Distinct().Take(MaxLabels).ToList();

        if (selected.Count > 0)
        {
            var details = await Task.WhenAll(selected.Select(EquipmentApi.GetAsync));
            _items = details.Where(r => r.IsSuccess).Select(r => r.Value!).Select(d => new EquipmentListItem
            {
                Id = d.Id, Type = d.Type, AssetNumber = d.AssetNumber, Brand = d.Brand, Model = d.Model,
                PeripheralKind = d.PeripheralKind, OwnerUnitName = d.OwnerUnitName
            }).OrderBy(i => i.AssetNumber).ToList();
            _total = _items.Count;
        }
        else if (Id is { } id)
        {
            var result = await EquipmentApi.GetAsync(id);
            if (result.IsSuccess)
            {
                var d = result.Value!;
                _items = [new EquipmentListItem
                {
                    Id = d.Id, Type = d.Type, AssetNumber = d.AssetNumber, Brand = d.Brand, Model = d.Model,
                    PeripheralKind = d.PeripheralKind, OwnerUnitName = d.OwnerUnitName
                }];
                _total = 1;
            }
            else
            {
                _error = result.ErrorMessage;
            }
        }
        else
        {
            // نسخه‌ی جدا از وضعیت فهرست، تا صفحه‌بندی فهرست عوض نشود.
            var source = State.Query;
            var query = new EquipmentQuery
            {
                Q = source.Q, Type = source.Type, Status = source.Status, OwnerUnitId = source.OwnerUnitId,
                BuildingId = source.BuildingId, FloorId = source.FloorId, LocationUnitId = source.LocationUnitId,
                NoAssetNumber = source.NoAssetNumber, IncludeRetired = source.IncludeRetired,
                Sort = source.Sort, Descending = source.Descending, Page = 1, PageSize = MaxLabels
            };

            var result = await EquipmentApi.ListAsync(query);
            if (result.IsSuccess)
            {
                _items = result.Value!.Items.ToList();
                _total = result.Value.Total;
            }
            else
            {
                _error = result.ErrorMessage;
            }
        }

        _noBarcode = _items.Count(i => Code128.Encode(i.AssetNumber) is null);
        _loading = false;
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");
}
