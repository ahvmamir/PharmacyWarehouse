@page "/locations"
@attribute [Authorize]
@inject LocationsClient LocationsApi
@inject ToastService Toasts
@inject DraftStore Drafts
@inject ApiAuthenticationStateProvider Session

<PageTitle>محل‌ها | انبار داروخانه</PageTitle>

<RequirePermission Permission="@Permissions.StockView">
<div class="page-head">
    <div>
        <h1>محل‌های انبار</h1>
        <p>مثل «ضلع جنوبی › قفسه ۲ › طبقه ۳ › قسمت B». محلی که زیرشاخه دارد حذف نمی‌شود؛ غیرفعالش کنید.</p>
    </div>
    @if (CanManage)
    {
        <button type="button" class="btn btn-primary" @onclick="() => OpenNew(null)"><AppIcon Name="plus" Size="15" /> محل سطح اول</button>
    }
</div>

@if (_error is not null)
{
    <div class="form-alert" role="alert">
        <AppIcon Name="warning" /> <span>@_error</span>
        <button type="button" class="btn btn-sm btn-quiet" @onclick="LoadAsync">تازه‌سازی</button>
    </div>
}

@if (!_loaded)
{
    <div class="loading-line">در حال بارگذاری…</div>
}
else if (_items.Count == 0)
{
    <div class="empty-state">
        <AppIcon Name="storage" Size="36" />
        <p>هنوز محلی تعریف نشده. از ضلع یا اتاق انبار شروع کنید، بعد قفسه‌ها و طبقه‌هایش را زیر آن بسازید.</p>
    </div>
}
else
{
    <section class="card-emu">
        @foreach (var (item, depth) in Ordered())
        {
            <div class="linked-item" style="padding-right:@(depth * 22)px;" @key="item.Id">
                <span style="flex:1;">
                    <strong>@item.Name</strong>
                    @if (depth > 0)
                    {
                        <small class="cell-sub d-block"><bdi>@item.Path</bdi></small>
                    }
                </span>
                @if (!item.IsActive)
                {
                    <span class="status-badge status-retired">غیرفعال</span>
                }
                @if (CanManage)
                {
                    @if (item.IsUsable)
                    {
                        <button type="button" class="btn btn-sm btn-ghost" @onclick="() => OpenNew(item)"><AppIcon Name="plus" Size="13" /> زیرشاخه</button>
                    }
                    <button type="button" class="icon-button" title="ویرایش" aria-label="ویرایش @item.Name" @onclick="() => OpenEdit(item)"><AppIcon Name="edit" Size="16" /></button>
                    <button type="button" class="btn btn-sm btn-ghost" @onclick="() => ToggleAsync(item)">@(item.IsActive ? "غیرفعال کن" : "فعال کن")</button>
                    <button type="button" class="icon-button danger" title="حذف" aria-label="حذف @item.Name" @onclick="() => _delete = item"><AppIcon Name="trash" Size="16" /></button>
                }
            </div>
        }
    </section>
}

@if (_delete is { } toDelete)
{
    <DeleteDialog Title="حذف محل" ItemName="@toDelete.Path"
                  Load="() => LocationsApi.DependenciesAsync(toDelete.Id)"
                  Delete="() => LocationsApi.DeleteAsync(toDelete.Id)"
                  OnCancel="() => _delete = null"
                  OnDeleted="OnDeletedAsync" />
}

@if (_dialogTitle is not null)
{
    <ModalDialog Title="@_dialogTitle" OnClose="CloseDialog">
        <EditForm Model="this" OnSubmit="SaveAsync">
            <div class="form-field">
                <label for="location-name">نام <span class="required">*</span></label>
                <input id="location-name" class="form-control" @bind="_name" @ref="_nameInput" maxlength="@LocationTree.MaxName" />
            </div>

            <div class="form-field mt-3">
                <label for="location-parent">زیرِ</label>
                <LocationPicker InputId="location-parent" Items="ParentOptions()" EmptyLabel="— سطح اول —" @bind-Value="_parentId" />
            </div>

            <div class="form-field mt-3">
                <label for="location-order">ترتیب نمایش</label>
                <input id="location-order" class="form-control" type="number" dir="ltr" @bind="_sortOrder" />
                <div class="form-hint">بین هم‌سطح‌ها؛ عدد کوچک‌تر بالاتر.</div>
            </div>

            @if (_dialogError is not null)
            {
                <div class="form-alert mt-3 mb-0" role="alert">@_dialogError</div>
            }

            <DraftBar State="_draft" OnClear="ClearDraftAsync" />
            <div class="modal-actions">
                <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "در حال ذخیره…" : "ذخیره")</button>
                <button type="button" class="btn btn-quiet" @onclick="CloseDialog">انصراف</button>
            </div>
        </EditForm>
    </ModalDialog>
}
</RequirePermission>

@code {
    private List<StorageLocationItem> _items = [];
    private bool _loaded;
    private string? _error;

    private StorageLocationItem? _delete;

    private string? _dialogTitle;
    private string? _dialogError;
    private bool _busy;
    private StorageLocationItem? _editing;
    private string _name = "";
    private Guid? _parentId;
    private int _sortOrder;
    private bool _focusName;
    private ElementReference _nameInput;

    private bool CanManage => Session.Can(Permissions.ProductsManage);

    private sealed class LocationDraft
    {
        public Guid? EditingId { get; set; }
        public string Name { get; set; } = "";
        public Guid? ParentId { get; set; }
        public int SortOrder { get; set; }
    }

    private Draft<LocationDraft>? _draft;
    private bool _draftChecked;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await RestoreDraftAsync();
    }

    // پنجره‌ی نیمه‌کاره بعد از reload دوباره باز می‌شود؛ «انصراف» و ثبت موفق پیش‌نویس را پاک می‌کنند.
    private async Task RestoreDraftAsync()
    {
        _draft = Drafts.Open<LocationDraft>("location-dialog");
        if (CanManage && await _draft.LoadAsync() is { } d)
        {
            var editing = d.EditingId is { } id ? _items.FirstOrDefault(i => i.Id == id) : null;
            if (d.EditingId is null || editing is not null)
            {
                _editing = editing;
                _name = d.Name;
                _parentId = d.ParentId;
                _sortOrder = d.SortOrder;
                _dialogTitle = editing is null ? "محل تازه (پیش‌نویس)" : $"ویرایش {editing.Name}";
            }
        }

        _draftChecked = true;
    }

    private async Task SaveDraftAsync()
    {
        if (!_draftChecked || _draft is null) return;

        var changed = _dialogTitle is not null && (_editing is null
            ? !string.IsNullOrWhiteSpace(_name)
            : _name != _editing.Name || _parentId != _editing.ParentId || _sortOrder != _editing.SortOrder);
        var before = _draft.Saved;
        await _draft.SaveAsync(changed ? new LocationDraft { EditingId = _editing?.Id, Name = _name, ParentId = _parentId, SortOrder = _sortOrder } : null);
        if (_draft.Saved != before) StateHasChanged();
    }

    private async Task ClearDraftAsync()
    {
        if (_draft is not null) await _draft.ClearAsync();
        if (_editing is { } e) { _name = e.Name; _parentId = e.ParentId; _sortOrder = e.SortOrder; }
        else { _name = ""; _parentId = null; _sortOrder = 0; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SaveDraftAsync();
        if (_focusName)
        {
            _focusName = false;
            await _nameInput.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        _error = null;
        var result = await LocationsApi.ListAsync();
        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        _items = result.Value!;
        _loaded = true;
    }

    // ترتیب درختی از Domain؛ همان منطق سرور.
    private IEnumerable<(StorageLocationItem Item, int Depth)> Ordered()
    {
        var byId = _items.ToDictionary(i => i.Id);
        return LocationTree.Ordered(_items.Select(i => new LocationNode(i.Id, i.ParentId, i.Name, i.SortOrder)))
            .Select(o => (byId[o.Node.Id], o.Depth));
    }

    // پدر ممکن: محل‌های قابل‌استفاده (خود و نیاکان فعال) و پدر فعلیِ ویرایش، به‌جز خودِ گره و نواده‌هایش.
    private IEnumerable<StorageLocationItem> ParentOptions()
    {
        var nodes = _items.Select(i => new LocationNode(i.Id, i.ParentId, i.Name, i.SortOrder)).ToList();
        return Ordered().Select(o => o.Item)
            .Where(i => i.IsUsable || i.Id == _editing?.ParentId)
            .Where(i => _editing is null || !LocationTree.WouldCreateCycle(nodes, _editing.Id, i.Id));
    }

    private void OpenNew(StorageLocationItem? parent)
    {
        _editing = null;
        _name = "";
        _parentId = parent?.Id;
        _sortOrder = 0;
        _dialogError = null;
        _dialogTitle = parent is null ? "محل سطح اول" : $"زیرشاخه‌ی {parent.Name}";
        _focusName = true;
    }

    private void OpenEdit(StorageLocationItem item)
    {
        _editing = item;
        _name = item.Name;
        _parentId = item.ParentId;
        _sortOrder = item.SortOrder;
        _dialogError = null;
        _dialogTitle = $"ویرایش {item.Name}";
        _focusName = true;
    }

    private void CloseDialog()
    {
        _dialogTitle = null;
        _ = _draft?.ClearAsync();
        _editing = null;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _dialogError = null;

        var request = new SaveStorageLocationRequest
        {
            Name = _name,
            ParentId = _parentId,
            SortOrder = _sortOrder,
            Version = _editing?.Version ?? 0
        };
        var result = await LocationsApi.SaveAsync(_editing?.Id, request);
        _busy = false;

        if (!result.IsSuccess)
        {
            _dialogError = result.ErrorMessage;
            return;
        }

        Toasts.Show($"ذخیره شد: {result.Value!.Path}");
        CloseDialog();
        await LoadAsync();
    }

    private async Task ToggleAsync(StorageLocationItem item)
    {
        var result = await LocationsApi.SetActiveAsync(item, !item.IsActive);
        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        await LoadAsync();
    }

    private async Task OnDeletedAsync()
    {
        Toasts.Show($"حذف شد: {_delete?.Path}");
        _delete = null;
        await LoadAsync();
    }
}
