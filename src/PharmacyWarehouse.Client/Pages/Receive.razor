@page "/receive"
@attribute [Authorize]
@using System.Text.Json
@using PharmacyWarehouse.Domain.Stock
@inject ProductsClient ProductsApi
@inject LocationsClient LocationsApi
@inject ToastService Toasts
@inject ApiAuthenticationStateProvider Session
@inject DraftStore Drafts
@inject CategoriesClient CategoriesApi
@inject CatalogClient CatalogApi
@inject NavigationManager Navigation

@* ورود جنس کامل (بخش ۱۵.۳ spec): زبانه‌ی «ورود جنس» در اقلام (Embedded)؛ /receive فقط به آن‌جا می‌رود.
   اول همه‌ی جعبه‌ها پشت‌سرهم اسکن می‌شوند و هیچ پنجره‌ای روند را قطع نمی‌کند؛ بارکد ناشناخته ردیف «قلم تازه» می‌شود.
   بعد «تکمیل ردیف‌ها» ردیف‌های ناقص را یکی‌یکی باز می‌کند. سرور قلم، بارکد، بچ و حرکت را در یک تراکنش می‌سازد. *@

@if (!Embedded)
{
    <PageTitle>ورود جنس | داروبار</PageTitle>
}

<RequirePermission Permission="@Permissions.StockReceive">
@if (!Embedded)
{
    <div class="page-head">
        <div>
            <h1>ورود جنس</h1>
            <p>قلم‌ها را اسکن یا جست‌وجو کنید تا به فهرست اضافه شوند؛ روی هر ردیف بزنید و بچ، تاریخ، تعداد و محل را کامل کنید. تعداد به «جعبه» است.</p>
        </div>
    </div>
}

<section class="card-emu">
    <div class="receive-search">
        <label for="receive-search" class="form-hint">قلم</label>
        <ProductCombobox @ref="_search" InputId="receive-search" OnPick="OnPickAsync" AutoFocus="true" OnEnterNoMatch="OnNoMatchAsync"
                         Placeholder="جعبه‌ها را پشت‌سرهم اسکن کنید یا نام قلم را بنویسید">
            <EmptyContent>
                <span>قلمی پیدا نشد.</span>
                @if (CanDefine)
                {
                    <button type="button" class="btn btn-sm btn-quiet ms-2" @onclick="() => { StartNewProduct(_search?.Text); }"><AppIcon Name="plus" Size="15" /> تعریف قلم تازه</button>
                }
            </EmptyContent>
        </ProductCombobox>
    </div>
    @if (_scanError is not null)
    {
        <div class="form-alert mt-3 mb-0" role="alert">@_scanError</div>
    }
    @if (CanDefine)
    {
        <div class="form-hint mt-2">
            بارکد ناشناخته بدون باز شدن پنجره ردیف «قلم تازه» می‌شود (نام از فهرست مرجع، اگر باشد). قلم بی‌بارکد؟
            <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => { StartNewProduct(null); }">همین‌جا تعریفش کنید</button>.
        </div>
    }
</section>

@if (_rows.Count == 0)
{
    <div class="empty-state">
        <AppIcon Name="box" Size="36" />
        <p>هنوز قلمی به فهرست اضافه نشده.</p>
    </div>
}
else
{
    <section class="card-emu receive-list">
        <h2>فهرست ورود (@JalaliDate.ToPersianDigits(_rows.Count.ToString()) ردیف)</h2>
        @foreach (var row in _rows)
        {
            <div class="receive-row @(row.HasError ? "has-error" : "")" @key="row.Key">
                <div class="receive-row-head">
                    <button type="button" class="receive-row-toggle" aria-haspopup="dialog" @onclick="() => Open(row)">
                        <AppIcon Name="edit" Size="16" />
                        <span class="combo-main">
                            <strong>@(string.IsNullOrWhiteSpace(row.ProductName) ? "قلم تازه (بی‌نام)" : row.ProductName)</strong>
                            <small class="cell-sub">@Summary(row)</small>
                        </span>
                        @if (row.IsNewProduct)
                        {
                            <span class="status-badge status-pending">قلم تازه</span>
                        }
                        @if (row.HasError)
                        {
                            <span class="status-badge status-expired">خطا</span>
                        }
                        else if (!row.IsComplete)
                        {
                            <span class="status-badge status-pending">ناقص</span>
                        }
                        <strong class="receive-row-qty">@JalaliDate.ToPersianDigits(row.Quantity.ToString()) جعبه</strong>
                    </button>
                    <button type="button" class="icon-button danger" title="حذف ردیف" aria-label="حذف ردیف @row.ProductName" disabled="@_busy" @onclick="() => Remove(row)"><AppIcon Name="trash" Size="16" /></button>
                </div>

                @if (row.RowError is not null)
                {
                    <div class="form-alert mt-2 mb-0" role="alert"><AppIcon Name="warning" /> <span>@row.RowError</span></div>
                }
                @foreach (var message in row.Errors.Values.SelectMany(m => m))
                {
                    <div class="field-error">@message</div>
                }
            </div>
        }

        @if (_formError is not null)
        {
            <div class="form-alert mt-3" role="alert"><AppIcon Name="warning" /> <span>@_formError</span></div>
        }

        <div class="mt-3 d-flex gap-2 flex-wrap">
            @if (NextIncomplete(null) is not null)
            {
                <button type="button" class="btn btn-primary" @onclick="() => OpenNextIncomplete(null)">
                    <AppIcon Name="edit" Size="15" /> تکمیل ردیف‌ها (@JalaliDate.ToPersianDigits(_rows.Count(NeedsWork).ToString()) ناقص)
                </button>
            }
            <button type="button" class="btn @(NextIncomplete(null) is null ? "btn-primary" : "btn-quiet")" disabled="@(_busy || _rows.Count == 0)" @onclick="SubmitAsync">@(_busy ? "در حال ثبت…" : "ثبت نهایی")</button>
        </div>
        <DraftBar State="_draft" OnClear="ClearDraftAsync" />
        <div class="form-hint mt-2">«ثبت نهایی» همه‌ی ردیف‌ها را با هم ثبت می‌کند؛ اگر یک ردیف خطا داشته باشد هیچ‌کدام ثبت نمی‌شود. این فهرست تا پیش از ثبت در همین مرورگر می‌ماند.</div>
    </section>
}

@if (OpenRow is { Detail: { } openProduct } openRow)
{
    <ModalDialog Side="true" Title="@(openRow.IsNewProduct ? "قلم تازه و بچ" : openRow.ProductName)" OnClose="CloseRow" AutoFocus="@(!_focusNewName)">
        @if (openRow.NewProduct is { } np)
        {
            @NewProductForm(openRow, np)
        }
        @RowForm(openRow, openProduct)
        <div class="modal-actions">
            @if (NextIncomplete(openRow) is not null)
            {
                <button type="button" class="btn btn-primary" @onclick="() => OpenNextIncomplete(openRow)">ردیف ناقص بعدی</button>
            }
            <button type="button" class="btn @(NextIncomplete(openRow) is null ? "btn-primary" : "btn-quiet")" @onclick="CloseRow">تمام؛ برگشت به فهرست</button>
            <button type="button" class="btn btn-danger-quiet" disabled="@_busy" @onclick="() => Remove(openRow)"><AppIcon Name="trash" Size="15" /> حذف ردیف</button>
        </div>
    </ModalDialog>
}
</RequirePermission>

@code {
    private RenderFragment RowForm(ReceiveRow row, ProductDetail product) => __builder =>
    {
        var summary = product.Summary;
        var prefix = "row-" + row.Key.ToString("N");
        var radio = "batch-" + prefix;

        @if (!row.IsNewProduct)
        {
            <p class="form-hint">
                @string.Join(" · ", new[] { summary.Brand, summary.PackDescription }.Where(s => !string.IsNullOrEmpty(s)))
                — موجودی فعلی: @JalaliDate.ToPersianDigits(summary.OnHand.ToString()) جعبه
            </p>
        }

        @if (!summary.IsActive)
        {
            <div class="form-alert" role="alert">این قلم غیرفعال است.</div>
        }

        <h3 class="mt-3">بچ</h3>
        @foreach (var batch in product.Batches)
        {
            <label class="linked-item" @key="batch.Id">
                <input type="radio" name="@radio" class="form-check-input" checked="@(row.BatchId == batch.Id)" @onchange="() => SelectBatch(row, batch.Id)" />
                <span style="flex:1;">
                    <bdi>@batch.BatchNumber</bdi>
                    — انقضا: @(batch.ExpiryText ?? "—")
                    @if (batch.IsExpired)
                    {
                        <span class="status-badge status-expired">منقضی</span>
                    }
                    — موجودی: @JalaliDate.ToPersianDigits(batch.OnHand.ToString())
                </span>
            </label>
        }
        @if (product.Batches.Count > 0)
        {
            <label class="linked-item">
                <input type="radio" name="@radio" class="form-check-input" checked="@(row.BatchId is null)" @onchange="() => SelectBatch(row, null)" />
                <span style="flex:1;">بچ تازه</span>
            </label>
        }

        <div class="mt-3">
            @if (row.BatchId is null)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label for="@(prefix)-number">شماره‌ی بچ <span class="required">*</span></label>
                        <input id="@(prefix)-number" class="form-control" dir="ltr" autocomplete="off" @bind="row.BatchNumber" />
                        <FieldError Field="BatchNumber" Errors="row.Errors" />
                    </div>
                    <div class="form-field">
                        <label for="@(prefix)-cost">قیمت واحد</label>
                        <input id="@(prefix)-cost" class="form-control" dir="ltr" inputmode="numeric" autocomplete="off" @bind="row.CostText" />
                        <FieldError Field="UnitCost" Errors="row.Errors" />
                    </div>
                </div>
                <div class="mt-3">
                    <ExpiryFields IdPrefix="@prefix" @bind-Value="row.Expiry" Required="@product.RequiresExpiry" />
                    <FieldError Field="Expiry" Errors="row.Errors" />
                    @if (PastExpiryWarning(row) is { } pastWarning)
                    {
                        <div class="form-alert mt-2 mb-0" role="alert"><AppIcon Name="warning" /> <span>@pastWarning</span></div>
                    }
                    @if (!product.RequiresExpiry)
                    {
                        <div class="form-hint">این قلم تاریخ انقضا لازم ندارد.</div>
                    }
                </div>
                <div class="form-field mt-3" hidden="@row.IsNewProduct">
                    <label for="@(prefix)-location">محل</label>
                    @if (row.ChangingLocation)
                    {
                        <LocationPicker InputId="@(prefix + "-location")" Items="_locations" @bind-Value="row.LocationId"
                                        EmptyLabel="@(summary.LocationPath is null ? "— بدون محل —" : $"— محل قلم: {summary.LocationPath} —")" />
                        <div class="form-hint">فقط محل همین بچ عوض می‌شود؛ محل پیش‌فرض قلم همان می‌ماند.</div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <bdi id="@(prefix)-location">@(summary.LocationPath ?? "— بدون محل —")</bdi>
                            <button type="button" class="btn btn-sm btn-quiet" @onclick="() => row.ChangingLocation = true"><AppIcon Name="location" Size="15" /> تغییر محل</button>
                        </div>
                    }
                    <FieldError Field="LocationId" Errors="row.Errors" />
                </div>
            }
            else if (row.SelectedBatch is { } selected)
            {
                <dl class="spec-list">
                    <div><dt>شماره‌ی بچ</dt><dd><bdi>@selected.BatchNumber</bdi></dd></div>
                    <div><dt>انقضا (ثبت‌شده)</dt><dd>@(selected.ExpiryText ?? "—")</dd></div>
                    <div><dt>محل</dt><dd><bdi>@(selected.LocationPath ?? "—")</bdi></dd></div>
                </dl>
                <div class="form-hint">برای بچ موجود فقط تعداد اضافه می‌شود.</div>
                <FieldError Field="BatchVersion" Errors="row.Errors" />
                <FieldError Field="BatchNumber" Errors="row.Errors" />
                <FieldError Field="Expiry" Errors="row.Errors" />
            }
        </div>

        <div class="form-grid mt-3">
            <div class="form-field">
                <label for="@(prefix)-qty">تعداد (جعبه) <span class="required">*</span></label>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-quiet" aria-label="کم کن" disabled="@(row.Quantity <= 1)" @onclick="() => row.Quantity = Math.Max(1, row.Quantity - 1)">−</button>
                    <input id="@(prefix)-qty" type="number" min="1" step="1" class="form-control" dir="ltr" style="max-width:110px;text-align:center;" @bind="row.Quantity" />
                    <button type="button" class="btn btn-quiet" aria-label="زیاد کن" @onclick="() => row.Quantity++">+</button>
                </div>
                <FieldError Field="Quantity" Errors="row.Errors" />
            </div>
            <div class="form-field">
                <label for="@(prefix)-note">یادداشت</label>
                <input id="@(prefix)-note" class="form-control" autocomplete="off" @bind="row.Note" />
                <FieldError Field="Note" Errors="row.Errors" />
            </div>
        </div>
        <FieldError Field="ProductId" Errors="row.Errors" />

        <div class="mt-3">
            <button type="button" class="btn btn-sm btn-quiet" @onclick="() => AddSiblingBatch(row)"><AppIcon Name="plus" Size="15" /> بچ دیگر از همین قلم</button>
        </div>
    };

    private RenderFragment NewProductForm(ReceiveRow row, SaveProductRequest np) => __builder =>
    {
        var prefix = "new-" + row.Key.ToString("N");

        <h3>مشخصات قلم</h3>
        <CatalogSuggest Barcode="@row.NewBarcode" Name="@np.Name" OnUse="item => UseCatalogAsync(row, item)" />
        @if (_similar.Count > 0)
        {
            <div class="form-alert warning">
                <AppIcon Name="warning" />
                <div>
                    <span>قلم‌های مشابه از قبل هست. اگر یکی از این‌هاست، همان را انتخاب کنید تا قلم تکراری ساخته نشود:</span>
                    <ul class="similar-list">
                        @foreach (var item in _similar)
                        {
                            <li @key="item.Id">
                                <bdi>@item.Name</bdi>
                                <small class="cell-sub">@string.Join(" · ", new[] { item.Brand, item.PackDescription }.Where(x => !string.IsNullOrEmpty(x)))</small>
                                <button type="button" class="btn btn-sm btn-quiet" @onclick="() => UseExistingAsync(row, item)">همین است</button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
        <div class="form-grid">
            <div class="form-field">
                <label for="@(prefix)-name">نام و دوز <span class="required">*</span></label>
                <input id="@(prefix)-name" class="form-control" @ref="_newNameInput" @bind="np.Name" @bind:after="() => NewProductChangedAsync(row)" maxlength="@ProductRules.MaxName" />
                <FieldError Field="NewProduct.Name" Errors="row.Errors" />
            </div>
            <div class="form-field">
                <label for="@(prefix)-brand">برند</label>
                <input id="@(prefix)-brand" class="form-control" @bind="np.Brand" @bind:after="() => NewProductChangedAsync(row)" maxlength="@ProductRules.MaxBrand" />
                <FieldError Field="NewProduct.Brand" Errors="row.Errors" />
            </div>
            <div class="form-field">
                <label for="@(prefix)-pack">محتوای بسته</label>
                <input id="@(prefix)-pack" class="form-control" @bind="np.PackDescription" @bind:after="() => NewProductChangedAsync(row)" maxlength="@ProductRules.MaxPack" />
                <div class="form-hint">مثلاً «۳۰ عدد».</div>
                <FieldError Field="NewProduct.PackDescription" Errors="row.Errors" />
            </div>
            <div class="form-field">
                <label for="@(prefix)-barcode">بارکد</label>
                <input id="@(prefix)-barcode" class="form-control" dir="ltr" autocomplete="off" @bind="row.NewBarcode" />
                <FieldError Field="NewBarcode" Errors="row.Errors" />
            </div>
            <div class="form-field">
                <label for="@(prefix)-location">محل</label>
                <LocationPicker InputId="@(prefix + "-location")" Items="_locations" Value="np.LocationId" ValueChanged="id => SetNewLocation(row, id)" />
                <FieldError Field="NewProduct.LocationId" Errors="row.Errors" />
            </div>
            <div class="form-field">
                <label for="@(prefix)-category">دسته</label>
                <select id="@(prefix)-category" class="form-select" value="@(np.CategoryId?.ToString() ?? "")"
                        @onchange="e => np.CategoryId = Guid.TryParse(e.Value?.ToString(), out var c) ? c : null">
                    <option value="">— بدون دسته —</option>
                    @foreach (var category in _categories.Where(c => c.IsActive))
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
                <FieldError Field="NewProduct.CategoryId" Errors="row.Errors" />
            </div>
        </div>
        <div class="form-check mt-2">
            <input id="@(prefix)-expiry" type="checkbox" class="form-check-input" checked="@np.RequiresExpiry" @onchange="e => SetRequiresExpiry(row, e.Value is true)" />
            <label for="@(prefix)-expiry" class="form-check-label">انقضا لازم است</label>
        </div>
        <FieldError Field="NewProduct" Errors="row.Errors" />
        <div class="form-hint">حداقل موجودی و بقیه‌ی تنظیم‌ها بعداً از «ویرایش قلم».</div>
    };

    [Parameter] public bool Embedded { get; set; }

    [SupplyParameterFromQuery(Name = "productId")] public Guid? ProductId { get; set; }

    private List<CategoryItem> _categories = [];
    private List<ProductListItem> _similar = [];
    private ElementReference _newNameInput;
    private bool _focusNewName;
    private int _similarSeq;

    private bool CanDefine => Session.Can(Permissions.ProductsManage);
    private ReceiveRow? OpenRow => _rows.FirstOrDefault(r => r.Key == _openKey);

    // جزئیات ساختگی برای ردیف قلم تازه: بچی ندارد و محلش همان محل انتخاب‌شده‌ی قلم است.
    private ProductDetail NewDetail(ReceiveRow row)
    {
        var np = row.NewProduct!;
        var path = np.LocationId is { } id ? _locations.FirstOrDefault(l => l.Id == id)?.Path : null;
        return new ProductDetail
        {
            Summary = new ProductListItem(Guid.Empty, np.Name, np.Brand, np.PackDescription, path, 0, 0, null, null, null, true, 0),
            RequiresExpiry = np.RequiresExpiry,
            LocationId = np.LocationId
        };
    }

    // بارکدخوان: فقط رقم و حرف لاتین بدون فاصله، بارکد حساب می‌شود؛ بقیه نام قلم.
    private static bool LooksLikeBarcode(string text) =>
        text.Length >= 6 && !text.Contains(' ') && TextNormalizer.ToAsciiDigits(text).All(c => char.IsAsciiLetterOrDigit(c) || c is '-' or '.');

    private async Task OnNoMatchAsync(string text)
    {
        var scan = Gs1Scan.Parse(text);
        if (IsDuplicateBox(scan)) return;

        // جعبه‌ی بعدیِ همان قلم تازه (همان GTIN و بچ، یا همان بارکد ساده): تعداد همان ردیف زیاد می‌شود، قلم تازه‌ی دوم ساخته نمی‌شود.
        var code = scan?.Gtin ?? text.Trim();
        if (_rows.LastOrDefault(r => r.IsNewProduct && r.NewBarcode == code
                && (scan is null || RowBatchKey(r) == TextNormalizer.ScanKey(scan.Batch))) is { } same)
        {
            Count(same, scan);
            Toasts.Show($"قلم تازه: تعداد {JalaliDate.ToPersianDigits(same.Quantity.ToString())} جعبه شد.");
            return;
        }

        if (!CanDefine)
        {
            _scanError = $"«{code}» پیدا نشد. با نام جست‌وجو کنید یا به انباردار بگویید.";
            return;
        }

        // متن نام‌مانند (نه بارکد) همان تعریف دستی با پنجره است؛ بارکد بی‌پنجره به فهرست می‌رود تا اسکن قطع نشود.
        if (scan is null && !LooksLikeBarcode(text.Trim()))
        {
            StartNewProduct(text);
            return;
        }

        var row = StartNewProduct(text, open: false);
        await FillFromCatalogAsync(row);
        Toasts.Show(string.IsNullOrWhiteSpace(row.ProductName)
            ? "بارکد تازه به فهرست اضافه شد؛ در پایان «تکمیل ردیف‌ها» را بزنید."
            : $"قلم تازه از فهرست مرجع: {row.ProductName}؛ در پایان تکمیلش کنید.");
    }

    // فقط وقتی فهرست مرجع دقیقاً یک قلمِ بی‌صاحب برای این GTIN دارد، نام و برند و بسته پر می‌شود؛ کاربر هنگام تکمیل می‌بیند و عوض می‌کند.
    private async Task FillFromCatalogAsync(ReceiveRow row)
    {
        if (row.NewBarcode is not { } code || row.NewProduct is not { } np || !string.IsNullOrWhiteSpace(np.Name)) return;

        var result = await CatalogApi.SearchAsync(code);
        if (result.Value is not [{ ExistingProductId: null } item]) return;

        np.Name = item.Name;
        np.Brand = item.Brand;
        np.PackDescription = item.PackDescription;
        row.ProductName = item.Name;
        row.Detail = NewDetail(row);
    }

    // ردیف ناقص: هنوز تکمیل نشده یا خطا دارد. «بعدی» بعد از ردیف جاری می‌گردد و از اول فهرست ادامه می‌دهد.
    private static bool NeedsWork(ReceiveRow row) => row.HasError || !row.IsComplete;

    private ReceiveRow? NextIncomplete(ReceiveRow? current)
    {
        var start = current is null ? 0 : _rows.IndexOf(current) + 1;
        return _rows.Skip(start).Concat(_rows.Take(start)).FirstOrDefault(r => r != current && NeedsWork(r));
    }

    private void OpenNextIncomplete(ReceiveRow? current)
    {
        if (NextIncomplete(current) is { } next) Open(next);
    }

    // ---------- برای زبانه‌ی «ورود جنس» اقلام ----------

    [Parameter] public EventCallback<int> OnCountChanged { get; set; }
    private int _reportedCount = -1;

    public ValueTask FocusAsync() => _search?.FocusAsync() ?? ValueTask.CompletedTask;

    // «+ ورود» روی ردیف اقلام: ردیف تازه بی‌پنجره؛ اگر قلم از قبل در فهرست است فقط اعلام می‌شود (تعداد با اسکن زیاد می‌شود).
    public async Task AddProductAsync(Guid productId)
    {
        if (_rows.Any(r => r.ProductId == productId && !r.IsNewProduct))
        {
            Toasts.Show("این قلم از قبل در فهرست ورود است.");
            return;
        }

        var result = await ProductsApi.GetAsync(productId);
        if (!result.IsSuccess)
        {
            _scanError = result.Outcome == ApiOutcome.NotFound ? "این قلم پیدا نشد." : result.ErrorMessage;
            return;
        }

        AddRow(result.Value!);
        StateHasChanged();
    }

    // «تعریف و ورود» از بارکد ناشناخته‌ی اقلام: همان مسیر اسکن ناشناخته.
    public async Task AddCodeAsync(string code)
    {
        await OnNoMatchAsync(code);
        StateHasChanged();
    }

    private ReceiveRow StartNewProduct(string? text, bool open = true)
    {
        _scanError = null;
        text = text?.Trim() ?? "";
        var scan = Gs1Scan.Parse(text);
        if (scan is not null) text = scan.Gtin;
        var barcode = scan is not null || LooksLikeBarcode(text);
        var last = _rows.LastOrDefault(r => r.NewProduct is not null)?.NewProduct;
        var row = new ReceiveRow
        {
            NewProduct = new SaveProductRequest
            {
                Name = barcode ? "" : text,
                RequiresExpiry = true,
                // محل و دسته‌ی قلم تازه‌ی قبلی برای ورود پشت‌سرهم می‌ماند.
                LocationId = last?.LocationId,
                CategoryId = last?.CategoryId
            },
            NewBarcode = barcode ? text : null
        };
        row.ProductName = row.NewProduct.Name;
        row.Detail = NewDetail(row);
        if (scan is not null) ApplyScan(row, scan);
        _rows.Add(row);
        _similar = [];
        if (!open) return row;

        _openKey = row.Key;
        _focusNewName = true;
        _ = NewProductChangedAsync(row);
        return row;
    }

    // فهرست مرجع فقط فیلدها را پر می‌کند؛ بارکدِ اسکن‌شده عوض نمی‌شود و ذخیره با کاربر است.
    private async Task UseCatalogAsync(ReceiveRow row, CatalogSuggestion item)
    {
        var np = row.NewProduct!;
        np.Name = item.Name;
        np.Brand = item.Brand;
        np.PackDescription = item.PackDescription;
        if (string.IsNullOrWhiteSpace(row.NewBarcode)) row.NewBarcode = item.Gtin;
        await NewProductChangedAsync(row);
    }

    private void SetNewLocation(ReceiveRow row, Guid? id)
    {
        row.NewProduct!.LocationId = id;
        row.Detail = NewDetail(row);
    }

    private void SetRequiresExpiry(ReceiveRow row, bool value)
    {
        row.NewProduct!.RequiresExpiry = value;
        row.Detail = NewDetail(row);
    }

    // مشابه‌ها با همان جست‌وجوی قلم (غلط املایی هم): قبل از ساختن قلم تازه، تا قلم تکراری ساخته نشود.
    private async Task NewProductChangedAsync(ReceiveRow row)
    {
        if (row.NewProduct is not { } np) return;
        row.ProductName = np.Name;
        row.Detail = NewDetail(row);

        var seq = ++_similarSeq;
        var query = string.Join(' ', new[] { np.Name, np.Brand }.Where(x => !string.IsNullOrWhiteSpace(x)));
        if (TextNormalizer.Clean(query) is not { Length: >= 2 })
        {
            _similar = [];
            return;
        }

        var result = await ProductsApi.SearchAsync(query);
        if (seq != _similarSeq) return;
        _similar = result.Value?.Items.Where(i => i.IsActive).Take(5).ToList() ?? [];
        StateHasChanged();
    }

    // «همین است»: ردیف به قلم موجود تبدیل می‌شود و بچ، تاریخ و تعدادِ واردشده می‌ماند.
    private async Task UseExistingAsync(ReceiveRow row, ProductListItem item)
    {
        var result = await ProductsApi.GetAsync(item.Id);
        if (!result.IsSuccess)
        {
            row.RowError = result.ErrorMessage;
            return;
        }

        row.NewProduct = null;
        row.NewBarcode = null;
        row.ProductId = item.Id;
        row.ProductName = item.Name;
        row.Detail = result.Value!;
        row.ClearErrors();
        _similar = [];
    }

    private void Open(ReceiveRow row)
    {
        _openKey = row.Key;
        _similar = [];
        if (row.IsNewProduct) _ = NewProductChangedAsync(row);
    }

    // بعد از بستن، فوکوس به فیلد اسکن برمی‌گردد تا بارکدخوان بی‌کلیک ادامه دهد.
    private void CloseRow()
    {
        _openKey = null;
        _similar = [];
        _focusSearch = true;
    }

    private bool _focusSearch;

    private ProductCombobox? _search;
    private readonly List<ReceiveRow> _rows = [];
    private List<StorageLocationItem> _locations = [];
    private Guid? _openKey;
    private Guid? _loadedProductId;
    private string? _scanError;
    private string? _formError;
    private bool _busy;
    private bool _draftLoaded;
    private Draft<List<ReceiveRow>>? _draft;


    // تاریخ انقضای گذشته خطا نیست (ممکن است داده‌ی قدیمی را ثبت کنند) ولی بی‌صدا هم نمی‌ماند.
    private static string? PastExpiryWarning(ReceiveRow row) =>
        ExpiryDate.Parse(row.Expiry) is { Value: { } value } && ExpiryDate.IsExpired(value.Date, LocalDay.Today(DateTime.UtcNow))
            ? "تاریخ انقضا گذشته است؛ این بچ منقضی ثبت می‌شود و فقط با اسقاط خارج می‌شود."
            : null;

    private static string Summary(ReceiveRow row)
    {
        if (row.Detail is null) return "در حال بارگذاری…";

        if (row.SelectedBatch is { } batch)
        {
            return string.Join(" · ", new[] { batch.BatchNumber, batch.ExpiryText, batch.LocationPath }.Where(s => !string.IsNullOrEmpty(s)));
        }

        var batchText = string.IsNullOrWhiteSpace(row.BatchNumber) ? "بچ وارد نشده" : row.BatchNumber;
        var expiry = ExpiryDate.Parse(row.Expiry) is { Value: { } value } ? ExpiryDate.Display(value) : row.Detail.RequiresExpiry ? "بدون تاریخ" : null;
        return string.Join(" · ", new[] { batchText, expiry, row.Detail.Summary.LocationPath }.Where(s => !string.IsNullOrEmpty(s)));
    }

    protected override async Task OnInitializedAsync()
    {
        // /receive قدیمی: ورود کامل حالا زبانه‌ی «ورود جنس» اقلام است.
        if (!Embedded)
        {
            Navigation.NavigateTo("products?tab=receive" + (ProductId is { } pid ? $"&productId={pid}" : ""), replace: true);
            return;
        }

        var locations = await LocationsApi.ListAsync();
        if (locations.IsSuccess) _locations = locations.Value!.Where(l => l.IsActive && l.IsUsable).ToList();
        _categories = (await CategoriesApi.ListAsync()).Value ?? [];
        await LoadDraftAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Embedded || ProductId is not { } id || id == _loadedProductId) return;

        // آمدن از جزئیات قلم: ردیف موجود باز می‌شود و تعدادش زیاد نمی‌شود.
        _loadedProductId = id;
        if (_rows.FirstOrDefault(r => r.ProductId == id) is { } existing)
        {
            _openKey = existing.Key;
            return;
        }

        var result = await ProductsApi.GetAsync(id);
        if (!result.IsSuccess)
        {
            _scanError = result.Outcome == ApiOutcome.NotFound ? "این قلم پیدا نشد." : result.ErrorMessage;
            return;
        }

        _openKey = AddRow(result.Value!).Key;
    }

    // فهرست هر بار که عوض شود ذخیره می‌شود؛ مقایسه‌ی متن در Draft جلوی نوشتن بی‌دلیل را می‌گیرد.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // قلم تازه: فوکوس از فیلد جست‌وجو به نام قلم در کشو می‌رود تا بارکدخوان چیزی را به جست‌وجو نچسباند.
        if (_focusNewName && OpenRow is { IsNewProduct: true })
        {
            _focusNewName = false;
            try { await _newNameInput.FocusAsync(); } catch (InvalidOperationException) { }
        }

        if (_focusSearch && OpenRow is null)
        {
            _focusSearch = false;
            await FocusAsync();
        }

        if (_rows.Count != _reportedCount)
        {
            _reportedCount = _rows.Count;
            await OnCountChanged.InvokeAsync(_rows.Count);
        }

        if (!_draftLoaded || _draft is null) return;

        var before = _draft.Saved;
        await _draft.SaveAsync(_rows.Count == 0 ? null : _rows);
        if (_draft.Saved != before) StateHasChanged();
    }

    private async Task LoadDraftAsync()
    {
        _draft = Drafts.Open<List<ReceiveRow>>("receive", legacyKey: $"pw-receive-draft-{Session.CurrentUser?.Id}");
        if (await _draft.LoadAsync() is { } rows) _rows.AddRange(rows);

        foreach (var row in _rows) await RefreshRowAsync(row);
        _draftLoaded = true;
    }

    private async Task ClearDraftAsync()
    {
        ClearAll();
        if (_draft is not null) await _draft.ClearAsync();
    }

    // Version و موجودی بچ‌ها همیشه از سرور تازه می‌شود؛ پیش‌نویس فقط ورودی کاربر را نگه می‌دارد.
    private async Task RefreshRowAsync(ReceiveRow row)
    {
        if (row.IsNewProduct)
        {
            row.Detail = NewDetail(row);
            return;
        }

        var result = await ProductsApi.GetAsync(row.ProductId);
        if (!result.IsSuccess)
        {
            row.RowError = result.Outcome == ApiOutcome.NotFound ? "این قلم دیگر وجود ندارد؛ ردیف را حذف کنید." : result.ErrorMessage;
            return;
        }

        row.Detail = result.Value!;
        row.ProductName = row.Detail.Summary.Name;
        if (row.BatchId is { } id && row.Detail.Batches.All(b => b.Id != id)) row.BatchId = null;
    }

    private async Task OnPickAsync(ProductListItem item)
    {
        _scanError = null;
        _formError = null;
        var scan = _search?.TakeScan(item.Id);

        if (!item.IsActive)
        {
            _scanError = $"«{item.Name}» غیرفعال است و ورود جنس ندارد.";
            return;
        }

        if (IsDuplicateBox(scan)) return;

        // اسکن پشت‌سرهم یک جعبه: تعداد ردیف همان قلم (و با کد GS1، همان بچ) زیاد می‌شود.
        if (FindRow(item.Id, scan) is { } existing)
        {
            Count(existing, scan);
            Toasts.Show($"{item.Name}: تعداد {JalaliDate.ToPersianDigits(existing.Quantity.ToString())} جعبه شد.");
            return;
        }

        var result = await ProductsApi.GetAsync(item.Id);
        if (!result.IsSuccess)
        {
            _scanError = result.Outcome == ApiOutcome.NotFound ? "این قلم پیدا نشد." : result.ErrorMessage;
            return;
        }

        // میان این انتظار ممکن است اسکن دیگری همین قلم را اضافه کرده باشد.
        if (FindRow(item.Id, scan) is { } added)
        {
            Count(added, scan);
            return;
        }

        var row = AddRow(result.Value!);
        if (scan is not null) ApplyScan(row, scan);
    }

    // UID تکراری: همان جعبه دوباره اسکن شده است (بخش ۹.۲ spec).
    private bool IsDuplicateBox(Gs1Data? scan)
    {
        if (scan?.Serial is not { } serial || !_rows.Any(r => r.Serials.Contains(serial))) return false;
        Toasts.Show("این جعبه (همین UID) قبلاً اسکن شده است و دوباره شمرده نشد.");
        return true;
    }

    private static string? RowBatchKey(ReceiveRow row) =>
        TextNormalizer.ScanKey(row.SelectedBatch?.BatchNumber ?? row.BatchNumber);

    // بدون کد GS1 آخرین ردیف همان قلم؛ با کد GS1 فقط ردیفِ همان بچ.
    private ReceiveRow? FindRow(Guid productId, Gs1Data? scan)
    {
        var rows = _rows.Where(r => r.ProductId == productId && !r.IsNewProduct);
        if (scan?.Batch is { } batch)
        {
            var key = TextNormalizer.ScanKey(batch);
            return rows.LastOrDefault(r => RowBatchKey(r) == key);
        }

        return rows.LastOrDefault();
    }

    private static void Count(ReceiveRow row, Gs1Data? scan)
    {
        row.Quantity++;
        if (scan?.Serial is { } serial) row.Serials.Add(serial);
    }

    // بچ و انقضای خوانده‌شده از کد: بچ موجود انتخاب می‌شود؛ وگرنه «بچ تازه» با همان شماره و تاریخ پر می‌شود.
    private void ApplyScan(ReceiveRow row, Gs1Data scan)
    {
        if (scan.Serial is { } serial) row.Serials.Add(serial);
        if (scan.Batch is not { } batch) return;

        var key = TextNormalizer.ScanKey(batch);
        if (row.Detail?.Batches.FirstOrDefault(b => TextNormalizer.ScanKey(b.BatchNumber) == key) is { } existing)
        {
            row.BatchId = existing.Id;
            if (scan.Expiry is { } expiry && existing.ExpiryDate is { } stored && stored != expiry && !scan.ExpiryMonthOnly)
            {
                Toasts.Show($"تاریخ روی کد ({scan.ExpiryText}) با تاریخ ثبت‌شده‌ی بچ {existing.BatchNumber} فرق دارد؛ بچ را بررسی کنید.");
            }

            return;
        }

        row.BatchId = null;
        row.BatchNumber = batch;
        row.Expiry = scan.ExpiryText;
    }

    private ReceiveRow AddRow(ProductDetail detail)
    {
        var row = new ReceiveRow { ProductId = detail.Summary.Id, ProductName = detail.Summary.Name, Detail = detail };
        _rows.Add(row);
        return row;
    }

    private void AddSiblingBatch(ReceiveRow source)
    {
        // بچ دوم از قلم تازه همان مشخصات را دارد؛ سرور هر دو ردیف را یک قلم می‌کند.
        var row = new ReceiveRow
        {
            ProductId = source.ProductId, ProductName = source.ProductName, Detail = source.Detail,
            NewProduct = source.NewProduct, NewBarcode = source.NewBarcode, Quantity = 1
        };
        _rows.Insert(_rows.IndexOf(source) + 1, row);
        _openKey = row.Key;
    }

    private void SelectBatch(ReceiveRow row, Guid? id)
    {
        row.BatchId = id;
        row.ClearErrors();
    }

    private void Remove(ReceiveRow row)
    {
        _rows.Remove(row);
        if (_openKey == row.Key) _openKey = null;
    }

    private void ClearAll()
    {
        _rows.Clear();
        _openKey = null;
        _formError = null;
    }

    // خطای قابل‌تشخیص پیش از ارسال: تعداد، قیمت و شماره‌ی بچی که قبلاً هست. false یعنی ارسال نشود.
    private static bool PrepareLine(ReceiveRow row, out ReceiptRequest request)
    {
        request = new ReceiptRequest
        {
            ProductId = row.IsNewProduct ? Guid.Empty : row.ProductId,
            NewProduct = row.NewProduct,
            NewBarcode = row.IsNewProduct && !string.IsNullOrWhiteSpace(row.NewBarcode) ? row.NewBarcode : null,
            Quantity = row.Quantity,
            Note = string.IsNullOrWhiteSpace(row.Note) ? null : row.Note
        };

        if (row.NewProduct is { } np && string.IsNullOrWhiteSpace(np.Name))
        {
            row.Errors["NewProduct.Name"] = ["نام قلم تازه را وارد کنید."];
            return false;
        }

        if (row.Detail is null)
        {
            row.RowError ??= "این ردیف بارگذاری نشده است.";
            return false;
        }

        if (row.Quantity < 1)
        {
            row.Errors["Quantity"] = ["تعداد باید حداقل ۱ باشد."];
            return false;
        }

        if (row.SelectedBatch is { } existing)
        {
            // بچ موجود: تاریخ، محل و قیمت نمی‌رود؛ سرور هم نادیده می‌گیرد.
            request.BatchNumber = existing.BatchNumber;
            request.BatchVersion = existing.Version;
            return true;
        }

        // شماره‌ی بچ موجود در حالت «بچ تازه»: فقط اگر تاریخ خالی یا برابر باشد به بچ موجود می‌رویم، بدون ثبت خودکار
        // تا کاربر تأیید کند؛ تاریخ متفاوت هرگز بی‌صدا دور ریخته نمی‌شود (ReceiptBatchMatcher در Domain).
        var match = ReceiptBatchMatcher.Resolve(row.BatchNumber, row.Expiry, row.Detail.Batches);
        switch (match.Kind)
        {
            case BatchMatchKind.UseExisting:
                row.BatchId = match.Batch!.Id;
                row.BatchNumber = "";
                row.Expiry = null;
                row.RowError = "این بچ قبلاً ثبت شده؛ فقط تعداد به آن اضافه می‌شود. بررسی کنید و دوباره ثبت کنید.";
                return false;
            case BatchMatchKind.DateMismatch:
                row.RowError = match.Message;
                return false;
            case BatchMatchKind.InvalidExpiry:
                row.Errors["Expiry"] = [match.Message!];
                return false;
        }

        request.BatchNumber = row.BatchNumber;
        request.Expiry = row.Expiry;
        request.LocationId = row.LocationId;

        var cost = TextNormalizer.ToAsciiDigits(row.CostText).Replace(",", "").Replace("٬", "").Trim();
        if (cost.Length > 0)
        {
            if (!long.TryParse(cost, out var parsed) || parsed < 0)
            {
                row.Errors["UnitCost"] = ["قیمت باید عدد باشد."];
                return false;
            }

            request.UnitCost = parsed;
        }

        return true;
    }

    private async Task SubmitAsync()
    {
        if (_busy || _rows.Count == 0) return;

        _formError = null;
        foreach (var row in _rows) row.ClearErrors();

        var lines = new List<ReceiptRequest>(_rows.Count);
        foreach (var row in _rows)
        {
            if (PrepareLine(row, out var line)) lines.Add(line);
        }

        if (lines.Count != _rows.Count)
        {
            _openKey = _rows.First(r => r.HasError).Key;
            _formError = "ردیف‌های مشخص‌شده را اصلاح کنید؛ چیزی ثبت نشد.";
            return;
        }

        _busy = true;
        var result = await ProductsApi.ReceiveBulkAsync(new BulkReceiptRequest { Lines = lines });
        _busy = false;

        if (result.IsSuccess)
        {
            var saved = result.Value!.Lines;
            var message = $"ثبت شد: {JalaliDate.ToPersianDigits(saved.Count.ToString())} ردیف، {JalaliDate.ToPersianDigits(lines.Sum(l => l.Quantity).ToString())} جعبه";
            var warnings = saved.SelectMany(l => l.Warnings).Distinct().Select(WarningText).ToList();
            if (warnings.Count > 0) message += " — " + string.Join(" ", warnings);
            Toasts.Show(message);
            ClearAll();
            if (_search is not null) await _search.FocusAsync();
            return;
        }

        _formError = result.ErrorMessage;
        ApplyErrors(result.Problem);

        if (result.Problem?.Type == ProblemTypes.VersionConflict)
        {
            // بچ را کس دیگری عوض کرده: Version ها تازه می‌شوند و ورودی کاربر می‌ماند.
            foreach (var row in _rows) await RefreshRowAsync(row);
        }

        if (_rows.FirstOrDefault(r => r.HasError) is { } first) _openKey = first.Key;
    }

    private void ApplyErrors(ApiProblem? problem)
    {
        if (problem is null) return;

        foreach (var (key, messages) in problem.Errors)
        {
            if (BulkReceiptErrors.TryParse(key, out var line, out var field) && line >= 0 && line < _rows.Count)
            {
                _rows[line].Errors[field] = messages;
            }
        }
    }

    private static string WarningText(ExpiryWarning warning) => warning switch
    {
        ExpiryWarning.ConvertedFromJalali => "تاریخ شمسی به میلادی تبدیل شد.",
        ExpiryWarning.MonthOnly => "تاریخ فقط ماه داشت؛ آخر ماه ثبت شد.",
        ExpiryWarning.DayClampedToMonthEnd => "روز از طول ماه بیشتر بود؛ آخر ماه ثبت شد.",
        _ => ""
    };
}
