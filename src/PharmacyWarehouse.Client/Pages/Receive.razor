@page "/receive"
@attribute [Authorize]
@using System.Text.Json
@using PharmacyWarehouse.Domain.Stock
@inject ProductsClient ProductsApi
@inject LocationsClient LocationsApi
@inject ToastService Toasts
@inject ApiAuthenticationStateProvider Session
@inject DraftStore Drafts

<PageTitle>ورود جنس | داروبار</PageTitle>

<RequirePermission Permission="@Permissions.StockReceive">
<div class="page-head">
    <div>
        <h1>ورود جنس</h1>
        <p>قلم‌ها را اسکن یا جست‌وجو کنید تا به فهرست اضافه شوند؛ روی هر ردیف بزنید و بچ، تاریخ، تعداد و محل را کامل کنید. تعداد به «جعبه» است.</p>
    </div>
</div>

<section class="card-emu">
    <div class="receive-search">
        <label for="receive-search" class="form-hint">قلم</label>
        <ProductCombobox @ref="_search" InputId="receive-search" OnPick="OnPickAsync">
            <EmptyContent>
                <span>قلمی پیدا نشد.</span>
                @if (Session.Can(Permissions.ProductsManage))
                {
                    <a class="btn btn-sm btn-quiet ms-2" href="products/new"><AppIcon Name="plus" Size="15" /> قلم جدید</a>
                }
            </EmptyContent>
        </ProductCombobox>
    </div>
    @if (_scanError is not null)
    {
        <div class="form-alert mt-3 mb-0" role="alert">@_scanError</div>
    }
</section>

@if (_rows.Count == 0)
{
    <div class="empty-state">
        <AppIcon Name="box" Size="36" />
        <p>هنوز قلمی به فهرست اضافه نشده.</p>
    </div>
}
else
{
    <section class="card-emu receive-list">
        <h2>فهرست ورود (@JalaliDate.ToPersianDigits(_rows.Count.ToString()) ردیف)</h2>
        @foreach (var row in _rows)
        {
            var isOpen = _openKey == row.Key;
            <div class="receive-row @(isOpen ? "open" : "") @(row.HasError ? "has-error" : "")" @key="row.Key">
                <div class="receive-row-head">
                    <button type="button" class="receive-row-toggle" aria-expanded="@(isOpen ? "true" : "false")" @onclick="() => Toggle(row)">
                        <AppIcon Name="chevron" Size="16" Class="fold-chevron" />
                        <span class="combo-main">
                            <strong>@row.ProductName</strong>
                            <small class="cell-sub">@Summary(row)</small>
                        </span>
                        @if (row.HasError)
                        {
                            <span class="status-badge status-expired">خطا</span>
                        }
                        else if (!row.IsComplete)
                        {
                            <span class="status-badge status-pending">ناقص</span>
                        }
                        <strong class="receive-row-qty">@JalaliDate.ToPersianDigits(row.Quantity.ToString()) جعبه</strong>
                    </button>
                    <button type="button" class="icon-button danger" title="حذف ردیف" aria-label="حذف ردیف @row.ProductName" disabled="@_busy" @onclick="() => Remove(row)"><AppIcon Name="trash" Size="16" /></button>
                </div>

                @if (row.RowError is not null)
                {
                    <div class="form-alert mt-2 mb-0" role="alert"><AppIcon Name="warning" /> <span>@row.RowError</span></div>
                }
                @if (!isOpen)
                {
                    @foreach (var message in row.Errors.Values.SelectMany(m => m))
                    {
                        <div class="field-error">@message</div>
                    }
                }

                @if (isOpen && row.Detail is { } product)
                {
                    <div class="receive-row-body">@RowForm(row, product)</div>
                }
            </div>
        }

        @if (_formError is not null)
        {
            <div class="form-alert mt-3" role="alert"><AppIcon Name="warning" /> <span>@_formError</span></div>
        }

        <div class="mt-3 d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-primary" disabled="@(_busy || _rows.Count == 0)" @onclick="SubmitAsync">@(_busy ? "در حال ثبت…" : "ثبت نهایی")</button>
            <button type="button" class="btn btn-quiet" disabled="@_busy" @onclick="ClearDraftAsync">پاک کردن پیش‌نویس</button>
        </div>
        <DraftBar State="_draft" OnClear="ClearDraftAsync" />
        <div class="form-hint mt-2">«ثبت نهایی» همه‌ی ردیف‌ها را با هم ثبت می‌کند؛ اگر یک ردیف خطا داشته باشد هیچ‌کدام ثبت نمی‌شود. این فهرست تا پیش از ثبت در همین مرورگر می‌ماند.</div>
    </section>
}
</RequirePermission>

@code {
    private RenderFragment RowForm(ReceiveRow row, ProductDetail product) => __builder =>
    {
        var summary = product.Summary;
        var prefix = "row-" + row.Key.ToString("N");
        var radio = "batch-" + prefix;

        <p class="form-hint">
            @string.Join(" · ", new[] { summary.Brand, summary.PackDescription }.Where(s => !string.IsNullOrEmpty(s)))
            — موجودی فعلی: @JalaliDate.ToPersianDigits(summary.OnHand.ToString()) جعبه
        </p>

        @if (!summary.IsActive)
        {
            <div class="form-alert" role="alert">این قلم غیرفعال است.</div>
        }

        <h3>بچ</h3>
        @foreach (var batch in product.Batches)
        {
            <label class="linked-item" @key="batch.Id">
                <input type="radio" name="@radio" class="form-check-input" checked="@(row.BatchId == batch.Id)" @onchange="() => SelectBatch(row, batch.Id)" />
                <span style="flex:1;">
                    <bdi>@batch.BatchNumber</bdi>
                    — انقضا: @(batch.ExpiryText ?? "—")
                    @if (batch.IsExpired)
                    {
                        <span class="status-badge status-expired">منقضی</span>
                    }
                    — موجودی: @JalaliDate.ToPersianDigits(batch.OnHand.ToString())
                </span>
            </label>
        }
        <label class="linked-item">
            <input type="radio" name="@radio" class="form-check-input" checked="@(row.BatchId is null)" @onchange="() => SelectBatch(row, null)" />
            <span style="flex:1;">بچ تازه</span>
        </label>

        <div class="mt-3">
            @if (row.BatchId is null)
            {
                <div class="form-grid">
                    <div class="form-field">
                        <label for="@(prefix)-number">شماره‌ی بچ <span class="required">*</span></label>
                        <input id="@(prefix)-number" class="form-control" dir="ltr" autocomplete="off" @bind="row.BatchNumber" />
                        <FieldError Field="BatchNumber" Errors="row.Errors" />
                    </div>
                    <div class="form-field">
                        <label for="@(prefix)-cost">قیمت واحد</label>
                        <input id="@(prefix)-cost" class="form-control" dir="ltr" inputmode="numeric" autocomplete="off" @bind="row.CostText" />
                        <FieldError Field="UnitCost" Errors="row.Errors" />
                    </div>
                </div>
                <div class="mt-3">
                    <ExpiryFields IdPrefix="@prefix" @bind-Value="row.Expiry" Required="@product.RequiresExpiry" />
                    <FieldError Field="Expiry" Errors="row.Errors" />
                    @if (PastExpiryWarning(row) is { } pastWarning)
                    {
                        <div class="form-alert mt-2 mb-0" role="alert"><AppIcon Name="warning" /> <span>@pastWarning</span></div>
                    }
                    @if (!product.RequiresExpiry)
                    {
                        <div class="form-hint">این قلم تاریخ انقضا لازم ندارد.</div>
                    }
                </div>
                <div class="form-field mt-3">
                    <label for="@(prefix)-location">محل</label>
                    @if (row.ChangingLocation)
                    {
                        <LocationPicker InputId="@(prefix + "-location")" Items="_locations" @bind-Value="row.LocationId"
                                        EmptyLabel="@(summary.LocationPath is null ? "— بدون محل —" : $"— محل قلم: {summary.LocationPath} —")" />
                        <div class="form-hint">فقط محل همین بچ عوض می‌شود؛ محل پیش‌فرض قلم همان می‌ماند.</div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <bdi id="@(prefix)-location">@(summary.LocationPath ?? "— بدون محل —")</bdi>
                            <button type="button" class="btn btn-sm btn-quiet" @onclick="() => row.ChangingLocation = true"><AppIcon Name="location" Size="15" /> تغییر محل</button>
                        </div>
                    }
                    <FieldError Field="LocationId" Errors="row.Errors" />
                </div>
            }
            else if (row.SelectedBatch is { } selected)
            {
                <dl class="spec-list">
                    <div><dt>شماره‌ی بچ</dt><dd><bdi>@selected.BatchNumber</bdi></dd></div>
                    <div><dt>انقضا (ثبت‌شده)</dt><dd>@(selected.ExpiryText ?? "—")</dd></div>
                    <div><dt>محل</dt><dd><bdi>@(selected.LocationPath ?? "—")</bdi></dd></div>
                </dl>
                <div class="form-hint">برای بچ موجود فقط تعداد اضافه می‌شود.</div>
                <FieldError Field="BatchVersion" Errors="row.Errors" />
                <FieldError Field="BatchNumber" Errors="row.Errors" />
                <FieldError Field="Expiry" Errors="row.Errors" />
            }
        </div>

        <div class="form-grid mt-3">
            <div class="form-field">
                <label for="@(prefix)-qty">تعداد (جعبه) <span class="required">*</span></label>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-quiet" aria-label="کم کن" disabled="@(row.Quantity <= 1)" @onclick="() => row.Quantity = Math.Max(1, row.Quantity - 1)">−</button>
                    <input id="@(prefix)-qty" type="number" min="1" step="1" class="form-control" dir="ltr" style="max-width:110px;text-align:center;" @bind="row.Quantity" />
                    <button type="button" class="btn btn-quiet" aria-label="زیاد کن" @onclick="() => row.Quantity++">+</button>
                </div>
                <FieldError Field="Quantity" Errors="row.Errors" />
            </div>
            <div class="form-field">
                <label for="@(prefix)-note">یادداشت</label>
                <input id="@(prefix)-note" class="form-control" autocomplete="off" @bind="row.Note" />
                <FieldError Field="Note" Errors="row.Errors" />
            </div>
        </div>
        <FieldError Field="ProductId" Errors="row.Errors" />

        <div class="mt-3">
            <button type="button" class="btn btn-sm btn-quiet" @onclick="() => AddSiblingBatch(row)"><AppIcon Name="plus" Size="15" /> بچ دیگر از همین قلم</button>
        </div>
    };

    [SupplyParameterFromQuery(Name = "productId")] public Guid? ProductId { get; set; }

    private ProductCombobox? _search;
    private readonly List<ReceiveRow> _rows = [];
    private List<StorageLocationItem> _locations = [];
    private Guid? _openKey;
    private Guid? _loadedProductId;
    private string? _scanError;
    private string? _formError;
    private bool _busy;
    private bool _draftLoaded;
    private Draft<List<ReceiveRow>>? _draft;


    // تاریخ انقضای گذشته خطا نیست (ممکن است داده‌ی قدیمی را ثبت کنند) ولی بی‌صدا هم نمی‌ماند.
    private static string? PastExpiryWarning(ReceiveRow row) =>
        ExpiryDate.Parse(row.Expiry) is { Value: { } value } && ExpiryDate.IsExpired(value.Date, LocalDay.Today(DateTime.UtcNow))
            ? "تاریخ انقضا گذشته است؛ این بچ منقضی ثبت می‌شود و فقط با اسقاط خارج می‌شود."
            : null;

    private static string Summary(ReceiveRow row)
    {
        if (row.Detail is null) return "در حال بارگذاری…";

        if (row.SelectedBatch is { } batch)
        {
            return string.Join(" · ", new[] { batch.BatchNumber, batch.ExpiryText, batch.LocationPath }.Where(s => !string.IsNullOrEmpty(s)));
        }

        var batchText = string.IsNullOrWhiteSpace(row.BatchNumber) ? "بچ وارد نشده" : row.BatchNumber;
        var expiry = ExpiryDate.Parse(row.Expiry) is { Value: { } value } ? ExpiryDate.Display(value) : row.Detail.RequiresExpiry ? "بدون تاریخ" : null;
        return string.Join(" · ", new[] { batchText, expiry, row.Detail.Summary.LocationPath }.Where(s => !string.IsNullOrEmpty(s)));
    }

    protected override async Task OnInitializedAsync()
    {
        var locations = await LocationsApi.ListAsync();
        if (locations.IsSuccess) _locations = locations.Value!.Where(l => l.IsActive && l.IsUsable).ToList();
        await LoadDraftAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ProductId is not { } id || id == _loadedProductId) return;

        // آمدن از جزئیات قلم: ردیف موجود باز می‌شود و تعدادش زیاد نمی‌شود.
        _loadedProductId = id;
        if (_rows.FirstOrDefault(r => r.ProductId == id) is { } existing)
        {
            _openKey = existing.Key;
            return;
        }

        var result = await ProductsApi.GetAsync(id);
        if (!result.IsSuccess)
        {
            _scanError = result.Outcome == ApiOutcome.NotFound ? "این قلم پیدا نشد." : result.ErrorMessage;
            return;
        }

        _openKey = AddRow(result.Value!).Key;
    }

    // فهرست هر بار که عوض شود ذخیره می‌شود؛ مقایسه‌ی متن در Draft جلوی نوشتن بی‌دلیل را می‌گیرد.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_draftLoaded || _draft is null) return;

        var before = _draft.Saved;
        await _draft.SaveAsync(_rows.Count == 0 ? null : _rows);
        if (_draft.Saved != before) StateHasChanged();
    }

    private async Task LoadDraftAsync()
    {
        _draft = Drafts.Open<List<ReceiveRow>>("receive", legacyKey: $"pw-receive-draft-{Session.CurrentUser?.Id}");
        if (await _draft.LoadAsync() is { } rows) _rows.AddRange(rows);

        foreach (var row in _rows) await RefreshRowAsync(row);
        _draftLoaded = true;
    }

    private async Task ClearDraftAsync()
    {
        ClearAll();
        if (_draft is not null) await _draft.ClearAsync();
    }

    // Version و موجودی بچ‌ها همیشه از سرور تازه می‌شود؛ پیش‌نویس فقط ورودی کاربر را نگه می‌دارد.
    private async Task RefreshRowAsync(ReceiveRow row)
    {
        var result = await ProductsApi.GetAsync(row.ProductId);
        if (!result.IsSuccess)
        {
            row.RowError = result.Outcome == ApiOutcome.NotFound ? "این قلم دیگر وجود ندارد؛ ردیف را حذف کنید." : result.ErrorMessage;
            return;
        }

        row.Detail = result.Value!;
        row.ProductName = row.Detail.Summary.Name;
        if (row.BatchId is { } id && row.Detail.Batches.All(b => b.Id != id)) row.BatchId = null;
    }

    private async Task OnPickAsync(ProductListItem item)
    {
        _scanError = null;
        _formError = null;

        if (!item.IsActive)
        {
            _scanError = $"«{item.Name}» غیرفعال است و ورود جنس ندارد.";
            return;
        }

        // اسکن پشت‌سرهم یک جعبه: تعداد ردیف همان قلم زیاد می‌شود. بچ دوم با «بچ دیگر» از داخل ردیف.
        if (_rows.LastOrDefault(r => r.ProductId == item.Id) is { } existing)
        {
            existing.Quantity++;
            Toasts.Show($"{item.Name}: تعداد {JalaliDate.ToPersianDigits(existing.Quantity.ToString())} جعبه شد.");
            return;
        }

        var result = await ProductsApi.GetAsync(item.Id);
        if (!result.IsSuccess)
        {
            _scanError = result.Outcome == ApiOutcome.NotFound ? "این قلم پیدا نشد." : result.ErrorMessage;
            return;
        }

        // میان این انتظار ممکن است اسکن دیگری همین قلم را اضافه کرده باشد.
        if (_rows.LastOrDefault(r => r.ProductId == item.Id) is { } added)
        {
            added.Quantity++;
            return;
        }

        AddRow(result.Value!);
    }

    private ReceiveRow AddRow(ProductDetail detail)
    {
        var row = new ReceiveRow { ProductId = detail.Summary.Id, ProductName = detail.Summary.Name, Detail = detail };
        _rows.Add(row);
        return row;
    }

    private void AddSiblingBatch(ReceiveRow source)
    {
        var row = new ReceiveRow { ProductId = source.ProductId, ProductName = source.ProductName, Detail = source.Detail };
        _rows.Insert(_rows.IndexOf(source) + 1, row);
        _openKey = row.Key;
    }

    private void Toggle(ReceiveRow row) => _openKey = _openKey == row.Key ? null : row.Key;

    private void SelectBatch(ReceiveRow row, Guid? id)
    {
        row.BatchId = id;
        row.ClearErrors();
    }

    private void Remove(ReceiveRow row)
    {
        _rows.Remove(row);
        if (_openKey == row.Key) _openKey = null;
    }

    private void ClearAll()
    {
        _rows.Clear();
        _openKey = null;
        _formError = null;
    }

    // خطای قابل‌تشخیص پیش از ارسال: تعداد، قیمت و شماره‌ی بچی که قبلاً هست. false یعنی ارسال نشود.
    private static bool PrepareLine(ReceiveRow row, out ReceiptRequest request)
    {
        request = new ReceiptRequest
        {
            ProductId = row.ProductId,
            Quantity = row.Quantity,
            Note = string.IsNullOrWhiteSpace(row.Note) ? null : row.Note
        };

        if (row.Detail is null)
        {
            row.RowError ??= "این ردیف بارگذاری نشده است.";
            return false;
        }

        if (row.Quantity < 1)
        {
            row.Errors["Quantity"] = ["تعداد باید حداقل ۱ باشد."];
            return false;
        }

        if (row.SelectedBatch is { } existing)
        {
            // بچ موجود: تاریخ، محل و قیمت نمی‌رود؛ سرور هم نادیده می‌گیرد.
            request.BatchNumber = existing.BatchNumber;
            request.BatchVersion = existing.Version;
            return true;
        }

        // شماره‌ی بچ موجود در حالت «بچ تازه»: فقط اگر تاریخ خالی یا برابر باشد به بچ موجود می‌رویم، بدون ثبت خودکار
        // تا کاربر تأیید کند؛ تاریخ متفاوت هرگز بی‌صدا دور ریخته نمی‌شود (ReceiptBatchMatcher در Domain).
        var match = ReceiptBatchMatcher.Resolve(row.BatchNumber, row.Expiry, row.Detail.Batches);
        switch (match.Kind)
        {
            case BatchMatchKind.UseExisting:
                row.BatchId = match.Batch!.Id;
                row.BatchNumber = "";
                row.Expiry = null;
                row.RowError = "این بچ قبلاً ثبت شده؛ فقط تعداد به آن اضافه می‌شود. بررسی کنید و دوباره ثبت کنید.";
                return false;
            case BatchMatchKind.DateMismatch:
                row.RowError = match.Message;
                return false;
            case BatchMatchKind.InvalidExpiry:
                row.Errors["Expiry"] = [match.Message!];
                return false;
        }

        request.BatchNumber = row.BatchNumber;
        request.Expiry = row.Expiry;
        request.LocationId = row.LocationId;

        var cost = TextNormalizer.ToAsciiDigits(row.CostText).Replace(",", "").Replace("٬", "").Trim();
        if (cost.Length > 0)
        {
            if (!long.TryParse(cost, out var parsed) || parsed < 0)
            {
                row.Errors["UnitCost"] = ["قیمت باید عدد باشد."];
                return false;
            }

            request.UnitCost = parsed;
        }

        return true;
    }

    private async Task SubmitAsync()
    {
        if (_busy || _rows.Count == 0) return;

        _formError = null;
        foreach (var row in _rows) row.ClearErrors();

        var lines = new List<ReceiptRequest>(_rows.Count);
        foreach (var row in _rows)
        {
            if (PrepareLine(row, out var line)) lines.Add(line);
        }

        if (lines.Count != _rows.Count)
        {
            _openKey = _rows.First(r => r.HasError).Key;
            _formError = "ردیف‌های مشخص‌شده را اصلاح کنید؛ چیزی ثبت نشد.";
            return;
        }

        _busy = true;
        var result = await ProductsApi.ReceiveBulkAsync(new BulkReceiptRequest { Lines = lines });
        _busy = false;

        if (result.IsSuccess)
        {
            var saved = result.Value!.Lines;
            var message = $"ثبت شد: {JalaliDate.ToPersianDigits(saved.Count.ToString())} ردیف، {JalaliDate.ToPersianDigits(lines.Sum(l => l.Quantity).ToString())} جعبه";
            var warnings = saved.SelectMany(l => l.Warnings).Distinct().Select(WarningText).ToList();
            if (warnings.Count > 0) message += " — " + string.Join(" ", warnings);
            Toasts.Show(message);
            ClearAll();
            if (_search is not null) await _search.FocusAsync();
            return;
        }

        _formError = result.ErrorMessage;
        ApplyErrors(result.Problem);

        if (result.Problem?.Type == ProblemTypes.VersionConflict)
        {
            // بچ را کس دیگری عوض کرده: Version ها تازه می‌شوند و ورودی کاربر می‌ماند.
            foreach (var row in _rows) await RefreshRowAsync(row);
        }

        if (_rows.FirstOrDefault(r => r.HasError) is { } first) _openKey = first.Key;
    }

    private void ApplyErrors(ApiProblem? problem)
    {
        if (problem is null) return;

        foreach (var (key, messages) in problem.Errors)
        {
            if (BulkReceiptErrors.TryParse(key, out var line, out var field) && line >= 0 && line < _rows.Count)
            {
                _rows[line].Errors[field] = messages;
            }
        }
    }

    private static string WarningText(ExpiryWarning warning) => warning switch
    {
        ExpiryWarning.ConvertedFromJalali => "تاریخ شمسی به میلادی تبدیل شد.",
        ExpiryWarning.MonthOnly => "تاریخ فقط ماه داشت؛ آخر ماه ثبت شد.",
        ExpiryWarning.DayClampedToMonthEnd => "روز از طول ماه بیشتر بود؛ آخر ماه ثبت شد.",
        _ => ""
    };
}
