@inject EquipmentClient EquipmentApi
@inject CatalogClient Catalog
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject EquipmentListState ListState
@inject ApiAuthenticationStateProvider Session

@if (_loadError is not null)
{
    <div class="form-alert" role="alert"><AppIcon Name="warning" /> <span>@_loadError</span></div>
}
else if (!_ready)
{
    <div class="loading-line">در حال بارگذاری…</div>
}
else
{
    <div class="content-narrow">
        <a class="breadcrumb-link" href="@(IsEdit ? $"equipment/{EditId}" : "equipment/new")">
            <AppIcon Name="chevron" Size="14" /> @(IsEdit ? "بازگشت به دستگاه" : "انتخاب نوع دیگر")
        </a>

        <div class="device-head">
            <span class="type-chip"><AppIcon Name="@_model.Type.ToString()" Size="26" /></span>
            <div class="device-head-text">
                <h1>@(IsEdit ? "ویرایش" : "ثبت") @AuditLabels.Type(_model.Type)</h1>
                <div class="device-head-meta">
                    @if (IsEdit)
                    {
                        <span>نوع دستگاه بعد از ثبت عوض نمی‌شود. محل و وضعیت هم از صفحه‌ی دستگاه تغییر می‌کنند.</span>
                    }
                    else
                    {
                        <span>فیلدهای ستاره‌دار اجباری‌اند.@(CopyFromId is null ? "" : " مشخصات از دستگاه قبلی کپی شد؛ شماره اموال، سریال و نام کامپیوتر را وارد کنید.")</span>
                    }
                </div>
            </div>
        </div>

        @if (_alert is not null)
        {
            <div class="form-alert" role="alert">
                <AppIcon Name="warning" />
                <span>@_alert</span>
                @if (_versionConflict)
                {
                    <a class="btn btn-sm btn-quiet" href="equipment/@EditId" target="_self">دیدن نسخه‌ی تازه</a>
                }
            </div>
        }

        <EditForm Model="_model" OnSubmit="() => SubmitAsync(stayForNext: false)">
            <section class="card-emu">
                <div class="card-emu-head"><h2>شناسه</h2></div>
                <div class="card-emu-body form-grid">
                    <div class="form-field">
                        <label for="asset">شماره اموال <span class="required">*</span></label>
                        <input id="asset" class="form-control" dir="ltr" autocomplete="off" disabled="@_model.UseTemporaryAssetNumber"
                               placeholder="@(_model.UseTemporaryAssetNumber ? _currentTemporary ?? "برنامه می‌سازد" : "")"
                               @bind="_model.AssetNumber" @bind:after="CheckAssetNumberAsync" @ref="_assetInput" />
                        @if (_duplicate is not null)
                        {
                            <div class="field-error" role="alert">
                                این شماره قبلاً ثبت شده:
                                <a href="equipment/@_duplicate.Value.Id" target="_blank">@_duplicate.Value.Summary</a>
                            </div>
                        }
                        <FieldError Field="AssetNumber" Errors="_errors" />
                        <div class="form-check mt-1">
                            <input id="no-asset" class="form-check-input" type="checkbox"
                                   @bind="_model.UseTemporaryAssetNumber" @bind:after="OnNoAssetChanged" />
                            <label class="form-check-label" for="no-asset" style="font-weight:400;">شماره اموال ندارد؛ موقت بساز</label>
                        </div>
                        @if (_currentTemporary is not null)
                        {
                            <div class="form-hint">برای ثبت شماره‌ی واقعی، تیک را بردارید.</div>
                        }
                    </div>

                    <div class="form-field">
                        <label for="serial">سریال</label>
                        <input id="serial" class="form-control" dir="ltr" autocomplete="off" @bind="_model.SerialNumber" />
                        <FieldError Field="SerialNumber" Errors="_errors" />
                    </div>

                    @if (EquipmentRules.IsHub(_model.Type))
                    {
                        <div class="form-field">
                            <label for="computer">نام کامپیوتر</label>
                            <input id="computer" class="form-control" dir="ltr" autocomplete="off" @bind="_model.ComputerName" />
                            <FieldError Field="ComputerName" Errors="_errors" />
                        </div>
                    }
                </div>
            </section>

            <section class="card-emu">
                <div class="card-emu-head"><h2>مشخصات</h2></div>
                <div class="card-emu-body form-grid">
                    @if (_model.Type == EquipmentType.Peripheral)
                    {
                        <div class="form-field">
                            <label for="kind">نوع جانبی <span class="required">*</span></label>
                            <input id="kind" class="form-control" placeholder="مثلاً اسپیکر یا بارکدخوان" @bind="_model.PeripheralKind" />
                            <FieldError Field="PeripheralKind" Errors="_errors" />
                        </div>
                    }

                    <div class="form-field">
                        <label for="brand">برند @if (BrandRequired) { <span class="required">*</span> }</label>
                        <input id="brand" class="form-control" dir="auto" @bind="_model.Brand" @bind:after="SuggestComponentsAsync" />
                        <FieldError Field="Brand" Errors="_errors" />
                    </div>

                    <div class="form-field">
                        <label for="model">مدل @if (BrandRequired) { <span class="required">*</span> }</label>
                        <input id="model" class="form-control" dir="auto" @bind="_model.Model" @bind:after="SuggestComponentsAsync" />
                        <FieldError Field="Model" Errors="_errors" />
                    </div>

                    @* درست زیر برند و مدل، همان‌جا که کاربر تایپ می‌کند؛ بخش قطعات پایین‌تر است و دیده نمی‌شد. *@
                    @if (_suggestion is { } suggestion)
                    {
                        <div class="copy-suggestion">
                            <AppIcon Name="copy" Size="16" />
                            <span>دستگاه دیگری با همین برند و مدل ثبت شده (<bdi class="mono">@suggestion.AssetNumber</bdi>، @Number(suggestion.Count) قطعه). قطعاتش را بیاورم؟</span>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => CopyComponentsAsync(suggestion.Id)">بیاور</button>
                            <button type="button" class="btn btn-sm btn-quiet" @onclick="() => _suggestion = null">نه</button>
                        </div>
                    }

                    @if (EquipmentRules.ShowsSize(_model.Type))
                    {
                        <div class="form-field">
                            <label for="size">
                                @(_model.Type == EquipmentType.Monitor ? "سایز (اینچ)" : "سایز")
                                @if (_model.Type == EquipmentType.Monitor)
                                {
                                    <span class="required">*</span>
                                }
                            </label>
                            <input id="size" class="form-control" dir="ltr"
                                   placeholder="@(_model.Type == EquipmentType.Monitor ? "22" : "A4")" @bind="_model.SizeText" />
                            <FieldError Field="SizeText" Errors="_errors" />
                        </div>
                    }
                </div>
            </section>

            <section class="card-emu">
                <div class="card-emu-head">
                    <h2>@(IsEdit ? "صاحب اموال" : "صاحب اموال و محل")</h2>
                    @if (IsEdit)
                    {
                        <p>برای عوض کردن محل، از دکمه‌ی «جابه‌جایی» در صفحه‌ی دستگاه استفاده کنید.</p>
                    }
                </div>
                <div class="card-emu-body">
                    <div class="form-grid mb-3">
                        <div class="form-field">
                            <label for="owner">واحد صاحب اموال <span class="required">*</span></label>
                            <select id="owner" class="form-select" @bind="_model.OwnerUnitId" @bind:after="OnOwnerChanged">
                                <option value="@Guid.Empty">انتخاب کنید…</option>
                                @foreach (var unit in _units.Where(u => u.IsActive || u.Id == _originalOwnerId))
                                {
                                    <option value="@unit.Id">@unit.Name</option>
                                }
                            </select>
                            <FieldError Field="OwnerUnitId" Errors="_errors" />
                        </div>
                    </div>

                    @if (!IsEdit)
                    {
                        <LocationFields Buildings="_buildings" Floors="_floors" Units="_units" Errors="_errors"
                                        @bind-BuildingId="_model.BuildingId"
                                        @bind-FloorId="_model.FloorId"
                                        @bind-LocationUnitId="_model.LocationUnitId"
                                        @bind-Room="_model.Room"
                                        @bind-Station="_model.Station"
                                        @bind-StationPosition="_model.StationPosition" />
                    }
                </div>
            </section>

            @if (EquipmentRules.IsHub(_model.Type))
            {
                <FoldSection Title="قطعات" Hint="@ComponentsHint" StartOpen="@(_model.Components.Count > 0)" ForceOpen="@(_errors.ContainsKey("Components") || _copyNote is not null)">
                        @if (_copyNote is not null)
                        {
                            <div class="muted-line">@_copyNote</div>
                        }

                        @foreach (var component in _model.Components)
                        {
                            <div class="component-row" @key="component">
                                <span class="component-kind">@AuditLabels.Kind(component.Kind)</span>
                                <input class="form-control form-control-sm" dir="auto" placeholder="برند" aria-label="برند @AuditLabels.Kind(component.Kind)" @bind="component.Brand" />
                                <input class="form-control form-control-sm" dir="auto" placeholder="مدل" aria-label="مدل @AuditLabels.Kind(component.Kind)" @bind="component.Model" />
                                @if (EquipmentRules.AllowsCapacity(component.Kind))
                                {
                                    <input class="form-control form-control-sm" dir="ltr" placeholder="ظرفیت" aria-label="ظرفیت @AuditLabels.Kind(component.Kind)" @bind="component.Capacity" />
                                }
                                else
                                {
                                    <span></span>
                                }
                                <button type="button" class="icon-button danger" title="حذف" aria-label="حذف @AuditLabels.Kind(component.Kind)"
                                        @onclick="() => _model.Components.Remove(component)">
                                    <AppIcon Name="close" Size="16" />
                                </button>
                            </div>
                        }

                        <FieldError Field="Components" Errors="_errors" />

                        <div class="chip-row">
                            @foreach (var kind in Enum.GetValues<ComponentKind>())
                            {
                                <button type="button" class="chip-add" disabled="@(!CanAdd(kind))"
                                        @onclick="() => _model.Components.Add(new ComponentInput { Kind = kind })">
                                    <AppIcon Name="plus" Size="13" /> @AuditLabels.Kind(kind)
                                </button>
                            }
                            <button type="button" class="chip-add" @onclick="ToggleCopySearchAsync">
                                <AppIcon Name="copy" Size="13" /> کپی از دستگاه دیگر
                            </button>
                        </div>

                        @if (_copyOpen)
                        {
                            <input class="form-control mt-2" autocomplete="off" aria-label="جست‌وجوی دستگاه برای کپی قطعات"
                                   placeholder="شماره اموال، برند یا مدل کیس یا لپ‌تاپ نمونه…" value="@_copyText" @oninput="OnCopySearchAsync" />
                            <div class="result-list">
                                @foreach (var candidate in _copyResults)
                                {
                                    <button type="button" class="result-item" @key="candidate.Id" @onclick="() => CopyComponentsAsync(candidate.Id)">
                                        <span class="type-chip"><AppIcon Name="@candidate.Type.ToString()" /></span>
                                        <span>
                                            @EquipmentText.Title(candidate)
                                            <span class="cell-sub">
                                                @AuditLabels.Type(candidate.Type) <bdi class="mono">@candidate.AssetNumber</bdi>،
                                                @EquipmentText.Place(candidate.LocationUnitName, candidate.Room)
                                            </span>
                                        </span>
                                    </button>
                                }
                                @if (_copySearched && _copyResults.Count == 0)
                                {
                                    <div class="muted p-2">کیس یا لپ‌تاپی پیدا نشد.</div>
                                }
                            </div>
                        }
                </FoldSection>

                <FoldSection Title="موس، کیبورد و جانبی‌ها" Hint="@AccessoriesHint"
                             StartOpen="@(_model.HasMouse || _model.HasKeyboard || !string.IsNullOrEmpty(_model.OtherAccessories))"
                             ForceOpen="@(_errors.ContainsKey("MouseModel") || _errors.ContainsKey("KeyboardModel") || _errors.ContainsKey("OtherAccessories"))">
                    <div class="form-grid">
                        <div class="form-field">
                            <div class="form-check mb-1">
                                <input id="mouse" class="form-check-input" type="checkbox" @bind="_model.HasMouse" />
                                <label class="form-check-label" for="mouse" style="font-weight:400;margin:0;">موس</label>
                            </div>
                            @if (_model.HasMouse)
                            {
                                <input class="form-control" dir="auto" placeholder="مدل موس" aria-label="مدل موس" @bind="_model.MouseModel" />
                                <FieldError Field="MouseModel" Errors="_errors" />
                            }
                        </div>
                        <div class="form-field">
                            <div class="form-check mb-1">
                                <input id="keyboard" class="form-check-input" type="checkbox" @bind="_model.HasKeyboard" />
                                <label class="form-check-label" for="keyboard" style="font-weight:400;margin:0;">کیبورد</label>
                            </div>
                            @if (_model.HasKeyboard)
                            {
                                <input class="form-control" dir="auto" placeholder="مدل کیبورد" aria-label="مدل کیبورد" @bind="_model.KeyboardModel" />
                                <FieldError Field="KeyboardModel" Errors="_errors" />
                            }
                        </div>
                        <div class="form-field">
                            <label for="accessories">جانبی‌های دیگر</label>
                            <input id="accessories" class="form-control" @bind="_model.OtherAccessories" />
                            <FieldError Field="OtherAccessories" Errors="_errors" />
                        </div>
                    </div>
                </FoldSection>
            }


            @if (!IsEdit && Session.Can(Permissions.EquipmentLink))
            {
                <FoldSection Title="@(EquipmentRules.IsHub(_model.Type) ? "دستگاه‌های متصل" : "اتصال به کیس یا لپ‌تاپ")"
                             Hint="@LinkHint" StartOpen="@(_linked.Count > 0)" ForceOpen="@_errors.ContainsKey("Link")">
                        @foreach (var picked in _linked)
                        {
                            <div class="linked-item" @key="picked.Id">
                                <span class="type-chip"><AppIcon Name="@picked.Type.ToString()" /></span>
                                <span style="flex:1;">
                                    @EquipmentText.Title(picked)
                                    <span class="cell-sub">@AuditLabels.Type(picked.Type) <bdi class="mono">@picked.AssetNumber</bdi></span>
                                </span>
                                <button type="button" class="icon-button danger" title="برداشتن" aria-label="برداشتن" @onclick="() => _linked.Remove(picked)">
                                    <AppIcon Name="close" Size="16" />
                                </button>
                            </div>
                        }

                        @if (EquipmentRules.IsHub(_model.Type) || _linked.Count == 0)
                        {
                            <input class="form-control mt-2" autocomplete="off" aria-label="جست‌وجوی دستگاه"
                                   placeholder="@(EquipmentRules.IsHub(_model.Type) ? "جست‌وجو در دستگاه‌های آزاد…" : "جست‌وجوی کیس یا لپ‌تاپ…")"
                                   value="@_linkText" @oninput="OnLinkSearchAsync" />

                            <div class="result-list">
                                @foreach (var candidate in _linkResults.Where(c => _linked.All(p => p.Id != c.Id)))
                                {
                                    <button type="button" class="result-item" @key="candidate.Id" @onclick="() => PickLink(candidate)">
                                        <span class="type-chip"><AppIcon Name="@candidate.Type.ToString()" /></span>
                                        <span>
                                            @EquipmentText.Title(candidate)
                                            <span class="cell-sub">
                                                @AuditLabels.Type(candidate.Type) <bdi class="mono">@candidate.AssetNumber</bdi>،
                                                @EquipmentText.Place(candidate.LocationUnitName, candidate.Room)
                                            </span>
                                        </span>
                                    </button>
                                }
                                @if (_linkSearched && _linkResults.Count == 0)
                                {
                                    <div class="muted p-2">دستگاهی پیدا نشد.</div>
                                }
                            </div>
                        }

                        @if (EquipmentRules.IsHub(_model.Type) && _linked.Count > 0)
                        {
                            <div class="form-check mt-3">
                                <input id="move-linked" class="form-check-input" type="checkbox" @bind="_model.MoveLinkedToSameLocation" />
                                <label class="form-check-label" for="move-linked">محل این دستگاه‌ها هم مثل این @AuditLabels.Type(_model.Type) شود</label>
                            </div>
                        }

                        <FieldError Field="Link" Errors="_errors" />
                </FoldSection>
            }

            <FoldSection Title="یادداشت" Hint="اختیاری" StartOpen="@(!string.IsNullOrEmpty(_model.Notes))" ForceOpen="@_errors.ContainsKey("Notes")">
                <textarea class="form-control" rows="3" aria-label="یادداشت" @bind="_model.Notes"></textarea>
                <FieldError Field="Notes" Errors="_errors" />
            </FoldSection>

            <div class="form-footer">
                <button type="submit" class="btn btn-primary" disabled="@_busy">
                    @(_busy ? "در حال ذخیره…" : IsEdit ? "ذخیره‌ی تغییرات" : "ثبت دستگاه")
                </button>
                @if (!IsEdit)
                {
                    <button type="button" class="btn btn-quiet" disabled="@_busy" title="مالک و محل برای دستگاه بعدی می‌ماند"
                            @onclick="() => SubmitAsync(stayForNext: true)">
                        ثبت و دستگاه بعدی
                    </button>
                    <button type="button" class="btn btn-quiet" disabled="@_busy" title="چند دستگاه مشابه با یک بار پر کردن فرم" @onclick="OpenBulk">
                        ثبت چندتایی
                    </button>
                }
                <span class="spacer"></span>
                <a class="btn btn-quiet" href="@(IsEdit ? $"equipment/{EditId}" : "")">انصراف</a>
            </div>
        </EditForm>
    </div>

    @if (_bulkBase is not null)
    {
        <BulkCreateDialog Base="_bulkBase" Buildings="_buildings" Floors="_floors" Units="_units"
                          OnClose="() => _bulkBase = null" OnCreated="OnBulkCreated" />
    }
}

@code {
    [Parameter] public EquipmentType Type { get; set; }
    [Parameter] public Guid? EditId { get; set; }

    // «ثبت مشابه»: فرم جدید از روی دستگاه موجود پر می‌شود، بدون شناسه‌های یکتا.
    [Parameter] public Guid? CopyFromId { get; set; }

    private readonly UpdateEquipmentRequest _model = new();
    private List<BuildingItem> _buildings = [];
    private List<FloorItem> _floors = [];
    private List<UnitItem> _units = [];
    private Guid _originalOwnerId;
    private ElementReference _assetInput;
    private bool _ready;
    private bool _busy;
    private bool _versionConflict;
    private bool _focusAssetNext;
    private string? _loadError;
    private string? _alert;
    private (Guid Id, string Summary)? _duplicate;
    private string? _currentTemporary;
    private EquipmentInput? _bulkBase;
    private readonly List<EquipmentListItem> _linked = [];
    private List<EquipmentListItem> _linkResults = [];

    // کپی قطعات از دستگاه نمونه: جست‌وجوی دستی، یا پیشنهاد خودکار وقتی برند و مدل با دستگاه دیگری یکی است.
    private bool _copyOpen;
    private string _copyText = "";
    private List<EquipmentListItem> _copyResults = [];
    private bool _copySearched;
    private int _copyRequest;
    private string? _copyNote;
    private (Guid Id, string? AssetNumber, int Count)? _suggestion;
    private string? _suggestedFor;
    private string _linkText = "";
    private bool _linkSearched;
    private int _linkRequest;
    private Dictionary<string, string[]> _errors = [];

    private bool IsEdit => EditId is not null;

    // خلاصه‌ی بخش بسته، تا لازم نباشد برای دیدن محتوا بازش کرد.
    private string ComponentsHint => _model.Components.Count == 0
        ? "اختیاری"
        : string.Join("، ", _model.Components.Select(c => AuditLabels.Kind(c.Kind)));

    private string AccessoriesHint
    {
        get
        {
            var parts = new List<string>();
            if (_model.HasMouse) parts.Add("موس");
            if (_model.HasKeyboard) parts.Add("کیبورد");
            if (!string.IsNullOrEmpty(_model.OtherAccessories)) parts.Add("جانبی دیگر");
            return parts.Count == 0 ? "اختیاری" : string.Join("، ", parts);
        }
    }

    private string LinkHint => _linked.Count == 0
        ? "اختیاری"
        : string.Join("، ", _linked.Select(l => l.AssetNumber));
    private bool BrandRequired => EquipmentRules.RequiresBrandAndModel(_model.Type);

    private bool CanAdd(ComponentKind kind) =>
        EquipmentRules.AllowsMultiple(kind) || _model.Components.All(c => c.Kind != kind);

    protected override async Task OnInitializedAsync()
    {
        var buildings = await Catalog.BuildingsAsync();
        var floors = await Catalog.FloorsAsync();
        var units = await Catalog.UnitsAsync();

        if (!buildings.IsSuccess || !floors.IsSuccess || !units.IsSuccess)
        {
            _loadError = units.ErrorMessage;
            return;
        }

        _buildings = buildings.Value!;
        _floors = floors.Value!;
        _units = units.Value!;

        if (EditId is { } id)
        {
            var result = await EquipmentApi.GetAsync(id);
            if (!result.IsSuccess)
            {
                _loadError = result.ErrorMessage;
                return;
            }

            CopyFrom(result.Value!);
        }
        else if (CopyFromId is { } sourceId)
        {
            var result = await EquipmentApi.GetAsync(sourceId);
            if (!result.IsSuccess)
            {
                _loadError = result.ErrorMessage;
                return;
            }

            CopyFrom(result.Value!);
            ClearIdentity();
            _focusAssetNext = true;
            await SearchLinkAsync("");
        }
        else
        {
            _model.Type = Type;
            PreselectSingleChoices();
            await SearchLinkAsync("");
        }

        _ready = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAssetNext && _ready)
        {
            _focusAssetNext = false;
            await _assetInput.FocusAsync();
        }
    }

    private void PreselectSingleChoices()
    {
        var activeBuildings = _buildings.Where(b => b.IsActive).ToList();
        if (activeBuildings.Count == 1)
        {
            _model.BuildingId = activeBuildings[0].Id;
            var floors = _floors.Where(f => f.BuildingId == _model.BuildingId && f.IsActive).ToList();
            if (floors.Count == 1) _model.FloorId = floors[0].Id;
        }

        _focusAssetNext = true;
    }

    private void CopyFrom(EquipmentDetail d)
    {
        _model.Type = d.Type;
        _model.AssetNumber = d.HasTemporaryAssetNumber ? null : d.AssetNumber;
        _model.UseTemporaryAssetNumber = d.HasTemporaryAssetNumber;
        _currentTemporary = d.HasTemporaryAssetNumber ? d.AssetNumber : null;
        _model.MouseModel = d.MouseModel;
        _model.KeyboardModel = d.KeyboardModel;
        _model.SerialNumber = d.SerialNumber;
        _model.Brand = d.Brand;
        _model.Model = d.Model;
        _model.SizeText = d.SizeText;
        _model.ComputerName = d.ComputerName;
        _model.PeripheralKind = d.PeripheralKind;
        _model.HasMouse = d.HasMouse;
        _model.HasKeyboard = d.HasKeyboard;
        _model.OtherAccessories = d.OtherAccessories;
        _model.OwnerUnitId = d.OwnerUnitId;
        _model.BuildingId = d.BuildingId;
        _model.FloorId = d.FloorId;
        _model.LocationUnitId = d.LocationUnitId;
        _model.Notes = d.Notes;
        _model.Version = d.Version;
        _model.Components = d.Components
            .Select(c => new ComponentInput { Id = c.Id, Kind = c.Kind, Brand = c.Brand, Model = c.Model, Capacity = EquipmentRules.AllowsCapacity(c.Kind) ? c.Capacity : null })
            .ToList();
        _originalOwnerId = d.OwnerUnitId;
    }

    // آنچه برای هر دستگاه یکتاست یا به همان یک دستگاه تعلق دارد، کپی نمی‌شود.
    private void ClearIdentity()
    {
        _model.AssetNumber = null;
        _model.UseTemporaryAssetNumber = false;
        _currentTemporary = null;
        _model.SerialNumber = null;
        _model.ComputerName = null;
        _model.Notes = null;
        _model.Version = 0;
        foreach (var component in _model.Components) component.Id = null;
    }

    // بیشتر دستگاه‌ها در همان واحدی‌اند که صاحبشان است؛ یک انتخاب کمتر.
    private void OnOwnerChanged()
    {
        if (!IsEdit && _model.LocationUnitId == Guid.Empty) _model.LocationUnitId = _model.OwnerUnitId;
    }

    private void OnNoAssetChanged()
    {
        if (_model.UseTemporaryAssetNumber)
        {
            _model.AssetNumber = null;
            _duplicate = null;
        }
    }

    // هشدار زودهنگام هنگام خروج از فیلد؛ سرور همچنان مرجع است.
    private async Task CheckAssetNumberAsync()
    {
        _duplicate = null;
        if (string.IsNullOrWhiteSpace(_model.AssetNumber)) return;

        var result = await EquipmentApi.LookupByAssetNumberAsync(_model.AssetNumber);
        var other = result.Value?.FirstOrDefault(e => e.Id != EditId);
        if (other is not null)
        {
            _duplicate = (other.Id, $"{AuditLabels.Type(other.Type)} {EquipmentText.Title(other)}");
        }
    }

    private static string Number(int value) => JalaliDate.ToPersianDigits(value.ToString());

    private async Task ToggleCopySearchAsync()
    {
        _copyOpen = !_copyOpen;
        if (_copyOpen && !_copySearched) await SearchCopyAsync("");
    }

    private Task OnCopySearchAsync(ChangeEventArgs e)
    {
        _copyText = e.Value?.ToString() ?? "";
        return SearchCopyAsync(_copyText);
    }

    // فقط کیس و لپ‌تاپ قطعه دارند. اسقاطی‌ها هم نمونه‌ی خوبی‌اند، پس کنار گذاشته نمی‌شوند.
    private async Task SearchCopyAsync(string text)
    {
        var number = ++_copyRequest;
        var result = await EquipmentApi.ListAsync(new EquipmentQuery
        {
            Q = text, IncludeRetired = true, PageSize = 30, Sort = EquipmentSort.Updated, Descending = true
        });
        if (number != _copyRequest) return;

        _copyResults = (result.Value?.Items ?? [])
            .Where(e => EquipmentRules.IsHub(e.Type) && e.Id != EditId)
            .ToList();
        _copySearched = true;
    }

    // قطعات فعلی جایگزین می‌شوند، نه اضافه؛ کپی دو بار پشت سر هم نباید قطعه‌ها را دوبرابر کند.
    private async Task CopyComponentsAsync(Guid sourceId)
    {
        var result = await EquipmentApi.GetAsync(sourceId);
        if (!result.IsSuccess)
        {
            _copyNote = result.ErrorMessage;
            return;
        }

        var source = result.Value!;
        if (source.Components.Count == 0)
        {
            _copyNote = $"دستگاه {source.AssetNumber} قطعه‌ی ثبت‌شده ندارد.";
            return;
        }

        var replaced = _model.Components.Count > 0;
        _model.Components = source.Components
            .Select(c => new ComponentInput
            {
                Kind = c.Kind, Brand = c.Brand, Model = c.Model,
                Capacity = EquipmentRules.AllowsCapacity(c.Kind) ? c.Capacity : null
            })
            .ToList();

        _copyNote = $"{Number(source.Components.Count)} قطعه از {source.AssetNumber} کپی شد{(replaced ? " و جای قطعات قبلی را گرفت" : "")}. اگر فرق دارند، همین‌جا ویرایش کنید.";
        _suggestion = null;
        _copyOpen = false;
        Toasts.Show(_copyNote);
    }

    // وقتی برند و مدل هر دو پر شد و هنوز قطعه‌ای وارد نشده، جدیدترین دستگاه هم‌مدل را پیشنهاد می‌دهیم.
    private async Task SuggestComponentsAsync()
    {
        if (!EquipmentRules.IsHub(_model.Type) || _model.Components.Count > 0) return;

        var brandKey = TextNormalizer.Key(_model.Brand);
        var modelKey = TextNormalizer.Key(_model.Model);
        if (brandKey is null || modelKey is null) return;

        var lookupKey = brandKey + "|" + modelKey;
        if (lookupKey == _suggestedFor) return;
        _suggestedFor = lookupKey;
        _suggestion = null;

        var result = await EquipmentApi.ListAsync(new EquipmentQuery
        {
            Q = _model.Model, Type = _model.Type, IncludeRetired = true, PageSize = 20, Sort = EquipmentSort.Updated, Descending = true
        });

        var sameModel = (result.Value?.Items ?? [])
            .Where(e => e.Id != EditId && TextNormalizer.Key(e.Brand) == brandKey && TextNormalizer.Key(e.Model) == modelKey)
            .Take(5);

        foreach (var candidate in sameModel)
        {
            var detail = await EquipmentApi.GetAsync(candidate.Id);
            if (detail.Value is { Components.Count: > 0 } d && _model.Components.Count == 0)
            {
                _suggestion = (d.Id, d.AssetNumber, d.Components.Count);
                return;
            }
        }
    }

    // کیس فقط دستگاه‌های آزاد غیرمرکز را می‌بیند؛ بقیه فقط کیس و لپ‌تاپ را.
    private Task OnLinkSearchAsync(ChangeEventArgs e)
    {
        _linkText = e.Value?.ToString() ?? "";
        return SearchLinkAsync(_linkText);
    }

    private async Task SearchLinkAsync(string text)
    {
        if (!Session.Can(Permissions.EquipmentLink)) return;

        var number = ++_linkRequest;
        var result = await EquipmentApi.ListAsync(new EquipmentQuery { Q = text, PageSize = 40 });
        if (number != _linkRequest) return;

        var wantHubs = !EquipmentRules.IsHub(_model.Type);
        _linkResults = (result.Value?.Items ?? [])
            .Where(e => wantHubs ? EquipmentRules.IsHub(e.Type) : !EquipmentRules.IsHub(e.Type) && e.ParentId is null)
            .ToList();
        _linkSearched = true;
    }

    private void PickLink(EquipmentListItem item)
    {
        _linked.Add(item);

        // دستگاهی که به کیس وصل می‌شود معمولاً همان‌جاست؛ محل را هم پیشنهاد می‌دهیم، قابل تغییر.
        if (!EquipmentRules.IsHub(_model.Type))
        {
            _model.BuildingId = item.BuildingId;
            _model.FloorId = item.FloorId;
            _model.LocationUnitId = item.LocationUnitId;
            _model.Room = item.Room;
        }
    }

    // شماره اموال در هر ردیف جداست، پس خالی بودنش در این مرحله خطا نیست؛ بقیه‌ی فرم باید کامل باشد.
    private void OpenBulk()
    {
        _alert = null;
        _errors = [];

        var hub = EquipmentRules.IsHub(_model.Type);
        _model.LinkChildIds = hub ? _linked.Select(l => l.Id).ToList() : [];
        _model.LinkParentId = hub ? null : _linked.FirstOrDefault()?.Id;

        var check = _model.Copy();
        check.AssetNumber = null;
        check.UseTemporaryAssetNumber = true;

        var problems = EquipmentRules.Validate(check);
        if (problems.Count > 0)
        {
            _errors = problems.GroupBy(p => p.Field).ToDictionary(g => g.Key, g => g.Select(p => p.Message).ToArray());
            _alert = "اول مشخصات دستگاه اول را کامل کنید.";
            return;
        }

        _bulkBase = _model.Copy();
        _bulkBase.LinkChildIds = _model.LinkChildIds.ToList();
    }

    private void OnBulkCreated(BulkCreateResponse response)
    {
        _bulkBase = null;
        foreach (var warning in response.Warnings) Toasts.Show(warning, isWarning: true);
        Toasts.Show($"{JalaliDate.ToPersianDigits(response.Created.ToString())} دستگاه ثبت شد.");

        // دستگاه‌های تازه بالای فهرست دیده شوند.
        ListState.Query.Q = null;
        ListState.Query.Page = 1;
        ListState.Query.Sort = EquipmentSort.Updated;
        ListState.Query.Descending = true;
        Navigation.NavigateTo("");
    }

    private async Task SubmitAsync(bool stayForNext)
    {
        if (_busy) return;

        _alert = null;
        _versionConflict = false;
        _errors = [];

        if (!IsEdit)
        {
            var hub = EquipmentRules.IsHub(_model.Type);
            _model.LinkChildIds = hub ? _linked.Select(l => l.Id).ToList() : [];
            _model.LinkParentId = hub ? null : _linked.FirstOrDefault()?.Id;
        }

        var problems = EquipmentRules.Validate(_model);
        if (problems.Count > 0)
        {
            _errors = problems.GroupBy(p => p.Field).ToDictionary(g => g.Key, g => g.Select(p => p.Message).ToArray());
            _alert = "چند فیلد نیاز به اصلاح دارد.";
            return;
        }

        _busy = true;
        ApiResult<EquipmentDetail> result;
        try
        {
            result = EditId is { } id
                ? await EquipmentApi.UpdateAsync(id, _model)
                : await EquipmentApi.CreateAsync(_model);
        }
        finally
        {
            _busy = false;
        }

        if (result.IsSuccess)
        {
            var saved = result.Value!;
            foreach (var warning in saved.Warnings) Toasts.Show(warning, isWarning: true);

            if (stayForNext)
            {
                Toasts.Show($"ثبت شد: {saved.AssetNumber ?? EquipmentText.Title(saved)}");
                ResetForNext();
            }
            else
            {
                Toasts.Show(IsEdit ? "تغییرات ذخیره شد." : "دستگاه ثبت شد.");
                Navigation.NavigateTo($"equipment/{saved.Id}");
            }

            return;
        }

        ShowFailure(result);
    }

    private void ShowFailure(ApiResult<EquipmentDetail> result)
    {
        var problem = result.Problem;

        if (problem?.Type == ProblemTypes.DuplicateAssetNumber)
        {
            if (problem.ExistingId is { } existing)
            {
                _duplicate = (existing, problem.ExistingSummary ?? "دستگاه موجود");
            }
            else
            {
                _errors = new() { ["AssetNumber"] = [problem.Title ?? "این شماره اموال قبلاً ثبت شده است."] };
            }

            _alert = problem.Title;
            return;
        }

        if (problem?.Type == ProblemTypes.VersionConflict) _versionConflict = true;

        if (problem?.Errors is { Count: > 0 } errors) _errors = errors;

        _alert = result.ErrorMessage;
    }

    // نوع، مالک و محل می‌مانند تا ثبت چند دستگاه یک اتاق سریع باشد.
    private void ResetForNext()
    {
        _model.AssetNumber = null;
        _model.UseTemporaryAssetNumber = false;
        _model.SerialNumber = null;
        _linked.Clear();
        _linkText = "";
        _ = SearchLinkAsync("");
        _model.ComputerName = null;
        _model.Notes = null;
        _model.Components = [];
        _duplicate = null;
        _focusAssetNext = true;
    }
}
