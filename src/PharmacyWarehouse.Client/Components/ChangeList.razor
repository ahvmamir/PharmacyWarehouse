@using System.Text.Json
@using PharmacyWarehouse.Domain.Stock

@* تاریخچه‌ی یک قلم: هر کار یک خط خلاصه است و با کلیک جزئیاتش باز می‌شود. دکمه روی کل ردیف کشیده شده، پس صفحه‌کلید هم کار می‌کند. *@
<div class="table-card">
    <table class="data-table change-table">
        <thead>
            <tr><th>زمان</th><th>کاربر</th><th>کار</th><th>مورد</th><th>خلاصه</th></tr>
        </thead>
        <tbody>
            @foreach (var group in Groups)
            {
                var isOpen = _open.Contains(group.Key);
                <tr class="row-link" @key="group.Key">
                    <td class="nowrap">
                        <button type="button" class="row-link-main change-toggle" aria-expanded="@(isOpen ? "true" : "false")" @onclick="() => Toggle(group.Key)">
                            <AppIcon Name="chevron" Size="14" Class="@(isOpen ? "change-chevron open" : "change-chevron")" />
                            @JalaliDate.Format(group.First.AtUtc)
                        </button>
                    </td>
                    <td><bdi>@group.First.UserName</bdi></td>
                    <td>@AuditLabels.Action(group.First.Action)</td>
                    <td>@AuditLabels.Entity(group.First.EntityType)</td>
                    <td><bdi>@group.Summary</bdi></td>
                </tr>
                @if (isOpen)
                {
                    <tr class="change-detail" @key="@($"{group.Key}:detail")">
                        <td colspan="5">
                            @if (group.First.Reason is { Length: > 0 } reason)
                            {
                                <div><span class="cell-sub d-inline">دلیل:</span> @reason</div>
                            }
                            @foreach (var line in group.Lines)
                            {
                                <div><span class="cell-sub d-inline">@line.Label:</span> <bdi>@line.Value</bdi></div>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private const int SummaryFields = 3;

    [Parameter, EditorRequired] public IReadOnlyList<AuditEntryItem> Changes { get; set; } = [];

    private readonly HashSet<string> _open = [];

    private readonly record struct Line(string Label, string Value);

    private sealed record ChangeGroup(string Key, AuditEntryItem First, string Summary, List<Line> Lines);

    private void Toggle(string key)
    {
        if (!_open.Add(key)) _open.Remove(key);
    }

    // یک ذخیره روی یک رکورد یک خط است، هرچند چند فیلد عوض شده باشد.
    private IEnumerable<ChangeGroup> Groups => Changes
        .GroupBy(c => (c.ChangeSetId, c.EntityId, c.Action))
        .Select(g =>
        {
            var first = g.First();
            var key = $"{g.Key.ChangeSetId}:{g.Key.EntityId}:{g.Key.Action}";
            if (first.Action == "Updated")
            {
                var lines = g.Select(c => new Line(AuditLabels.Field(c.Field),
                    $"{c.OldText ?? AuditLabels.Value(c.Field, c.OldValue)} ← {c.NewText ?? AuditLabels.Value(c.Field, c.NewValue)}")).ToList();
                var summary = lines.Count == 1
                    ? $"{lines[0].Label}: {lines[0].Value}"
                    : string.Join("، ", lines.Select(l => l.Label));
                return new ChangeGroup(key, first, summary, lines);
            }

            var values = Lines(first.Action == "Created" ? first.NewValue : first.OldValue);
            return new ChangeGroup(key, first, string.Join(" · ", values.Take(SummaryFields).Select(l => l.Value)), values);
        });

    // مشتق‌ها و کلیدها خبر نیستند. OnHand در ردیف‌های قدیمی هست؛ تاریخچه‌ی موجودی همان جدول حرکت‌هاست.
    // ProductId در تاریخچه‌ی خود قلم تکراری است.
    private static bool Skip(string name) =>
        name is "Id" or "Version" or "SearchText" or "CreatedAtUtc" or "UpdatedAtUtc" or "OnHand" or "ProductId"
        || name.EndsWith("Key", StringComparison.Ordinal);

    private static List<Line> Lines(string? json)
    {
        var lines = new List<Line>();
        if (string.IsNullOrEmpty(json)) return lines;

        Dictionary<string, string?>? values;
        try
        {
            values = JsonSerializer.Deserialize<Dictionary<string, string?>>(json);
        }
        catch (JsonException)
        {
            lines.Add(new Line("مقدار", json));
            return lines;
        }

        if (values is null) return lines;

        foreach (var (name, raw) in values)
        {
            if (Skip(name)) continue;

            // تاریخ انقضا با دقت و تقویم ورودی یک خط می‌شود.
            if (name is "ExpiryPrecision" or "ExpiryCalendar") continue;
            if (name == "ExpiryDate")
            {
                lines.Add(new Line(AuditLabels.Field(name),
                    AuditLabels.Expiry(raw, values.GetValueOrDefault("ExpiryPrecision"), values.GetValueOrDefault("ExpiryCalendar"))));
                continue;
            }

            lines.Add(new Line(AuditLabels.Field(name), AuditLabels.Value(name, raw)));
        }

        return lines;
    }
}
