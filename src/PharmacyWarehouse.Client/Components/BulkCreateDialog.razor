@inject EquipmentClient EquipmentApi

@* ثبت چندتایی: تعداد و فیلدهای متفاوت ← جدول پرشده از دستگاه اول ← ثبت نهایی همه‌یا‌هیچ. *@
<ModalDialog Title="@(_step == 1 ? "ثبت چندتایی" : $"ثبت چندتایی: {AuditLabels.Type(Base.Type)}")" ExtraWide="@(_step == 2)" OnClose="() => OnClose.InvokeAsync()">
    @if (_step == 1)
    {
        <div class="form-field mb-3" style="max-width:220px;">
            <label for="bulk-count">تعداد <span class="required">*</span></label>
            <input id="bulk-count" class="form-control" type="number" dir="ltr" min="@BulkRules.MinCount" max="@BulkRules.MaxCount" @bind="_count" @ref="_countInput" />
            <FieldError Field="Count" Errors="_errors" />
        </div>

        <h3 class="bulk-subtitle">کدام فیلدها با هم فرق دارند؟</h3>
        <p class="muted" style="font-size:.86rem;">
            شماره اموال همیشه جدا وارد می‌شود. هر چه تیک نزنید برای همه مثل دستگاهی است که پر کردید. قطعات برای همه یکسان است.
        </p>

        <div class="choice-grid">
            @foreach (var field in _fields)
            {
                var locked = IsLocked(field);
                <label class="choice @(_selected.Contains(field.Key) ? "selected" : "") @(locked ? "disabled" : "")" @key="field.Key">
                    <input class="form-check-input mt-0" type="checkbox" disabled="@locked" checked="@_selected.Contains(field.Key)"
                           @onchange="e => Toggle(field.Key, e.Value is true)" />
                    <span>@field.Label</span>
                </label>
            }
        </div>

        @if (Base.LinkChildIds.Count > 0)
        {
            <div class="form-alert warning mt-3 mb-0">
                <AppIcon Name="warning" />
                <span>دستگاه‌های متصلی که انتخاب کرده‌اید در ثبت چندتایی وصل نمی‌شوند؛ هر دستگاه فقط به یک کیس وصل می‌شود.</span>
            </div>
        }

        <div class="modal-actions">
            <button type="button" class="btn btn-primary" @onclick="GoToTable">ادامه</button>
            <button type="button" class="btn btn-quiet" @onclick="() => OnClose.InvokeAsync()">انصراف</button>
        </div>
    }
    else
    {
        <div class="toolbar">
            <div>
                <label for="bulk-count-table">تعداد</label>
                <input id="bulk-count-table" class="form-control form-control-sm" style="width:90px;" type="number" dir="ltr"
                       min="@BulkRules.MinCount" max="@BulkRules.MaxCount" @bind="_count" @bind:after="ApplyCount" />
            </div>
            <button type="button" class="btn btn-sm btn-quiet" disabled="@(_rows.Count >= BulkRules.MaxCount)" @onclick="AddRow"><AppIcon Name="plus" Size="15" /> یک ردیف</button>
            <span class="spacer"></span>
            <span class="muted" style="font-size:.84rem;">مقادیر از دستگاه اول آمده‌اند؛ هر کدام فرق دارد را عوض کنید.</span>
        </div>

        <FieldError Field="Count" Errors="_errors" />

        @if (_error is not null)
        {
            <div class="form-alert" role="alert"><AppIcon Name="warning" /> <span>@_error</span></div>
        }

        <div class="table-card bulk-table">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>شماره اموال <span class="required">*</span></th>
                        @foreach (var field in Chosen)
                        {
                            <th>@field.Label</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        var number = _rows.IndexOf(row) + 1;
                        <tr @key="row" class="@(row.Errors is null ? "" : "row-error")">
                            <td class="muted">@Persian(number)</td>
                            <td class="bulk-asset">
                                <input class="form-control form-control-sm" dir="ltr" autocomplete="off" aria-label="شماره اموال ردیف @number"
                                       disabled="@row.Temporary" placeholder="@(row.Temporary ? "برنامه می‌سازد" : "")"
                                       value="@row.AssetNumber" @onchange="e => OnAssetChanged(row, e.Value?.ToString())" />
                                <label class="bulk-temp">
                                    <input class="form-check-input mt-0" type="checkbox" checked="@row.Temporary" @onchange="e => SetTemporary(row, e.Value is true)" />
                                    موقت
                                </label>
                            </td>
                            @foreach (var field in Chosen)
                            {
                                <td>
                                    @if (field.Kind == FieldKind.Text)
                                    {
                                        <input class="form-control form-control-sm" dir="@(field.Ltr ? "ltr" : "auto")" autocomplete="off"
                                               aria-label="@field.Label ردیف @number"
                                               value="@row.Values[field.Key]" @onchange="e => row.Values[field.Key] = e.Value?.ToString()" />
                                    }
                                    else
                                    {
                                        <select class="form-select form-select-sm" aria-label="@field.Label ردیف @number"
                                                value="@row.Values[field.Key]" @onchange="e => OnSelect(row, field, e.Value?.ToString())">
                                            <option value="@Guid.Empty">انتخاب کنید…</option>
                                            @foreach (var option in OptionsFor(field, row))
                                            {
                                                <option value="@option.Value">@option.Label</option>
                                            }
                                        </select>
                                    }
                                </td>
                            }
                            <td>
                                <button type="button" class="icon-button danger" title="حذف ردیف" aria-label="حذف ردیف @number"
                                        disabled="@(_rows.Count <= BulkRules.MinCount)" @onclick="() => RemoveRow(row)">
                                    <AppIcon Name="close" Size="16" />
                                </button>
                            </td>
                        </tr>
                        @if (row.Errors is not null)
                        {
                            <tr class="row-error-text" @key="row.Errors">
                                <td></td>
                                <td colspan="@(Chosen.Count + 2)" role="alert">@string.Join(" ", row.Errors)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="modal-actions">
            <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SubmitAsync">
                @(_busy ? "در حال ثبت…" : $"ثبت نهایی {Persian(_rows.Count)} دستگاه")
            </button>
            <button type="button" class="btn btn-quiet" disabled="@_busy" @onclick="() => _step = 1">بازگشت به انتخاب فیلدها</button>
        </div>
    }
</ModalDialog>

@code {
    private const string BuildingKey = nameof(EquipmentInput.BuildingId);
    private const string FloorKey = nameof(EquipmentInput.FloorId);

    private enum FieldKind { Text, Unit, Building, Floor }

    private sealed record Option(string Value, string Label);

    private sealed record BulkField(
        string Key,
        string Label,
        Func<EquipmentInput, string?> Get,
        Action<EquipmentInput, string?> Set,
        FieldKind Kind = FieldKind.Text,
        bool Ltr = false);

    private sealed class BulkRow
    {
        public string? AssetNumber { get; set; }
        public bool Temporary { get; set; }
        public Dictionary<string, string?> Values { get; } = [];
        public string[]? Errors { get; set; }
    }

    [Parameter, EditorRequired] public EquipmentInput Base { get; set; } = null!;
    [Parameter] public IReadOnlyList<BuildingItem> Buildings { get; set; } = [];
    [Parameter] public IReadOnlyList<FloorItem> Floors { get; set; } = [];
    [Parameter] public IReadOnlyList<UnitItem> Units { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<BulkCreateResponse> OnCreated { get; set; }

    private List<BulkField> _fields = [];
    private readonly HashSet<string> _selected = [];
    private readonly List<BulkRow> _rows = [];
    private Dictionary<string, string[]> _errors = [];
    private ElementReference _countInput;
    private int _count = 5;
    private int _step = 1;
    private bool _busy;
    private bool _focused;
    private string? _error;

    private List<BulkField> Chosen => _fields.Where(f => _selected.Contains(f.Key)).ToList();

    private static string Persian(int value) => JalaliDate.ToPersianDigits(value.ToString());

    private static Guid ToGuid(string? value) => Guid.TryParse(value, out var id) ? id : Guid.Empty;

    // طبقه مال ساختمان است؛ اگر ساختمان فرق کند طبقه هم باید فرق کند.
    private bool IsLocked(BulkField field) => field.Key == FloorKey && _selected.Contains(BuildingKey);

    protected override void OnInitialized()
    {
        var hub = EquipmentRules.IsHub(Base.Type);

        // شماره اموال در این فهرست نیست: همیشه ستون خودش را دارد.
        var fields = new List<BulkField>
        {
            new(nameof(EquipmentInput.SerialNumber), "سریال", i => i.SerialNumber, (i, v) => i.SerialNumber = v, Ltr: true)
        };

        if (hub) fields.Add(new(nameof(EquipmentInput.ComputerName), "نام کامپیوتر", i => i.ComputerName, (i, v) => i.ComputerName = v, Ltr: true));
        if (Base.Type == EquipmentType.Peripheral) fields.Add(new(nameof(EquipmentInput.PeripheralKind), "نوع جانبی", i => i.PeripheralKind, (i, v) => i.PeripheralKind = v));

        fields.Add(new(nameof(EquipmentInput.Brand), "برند", i => i.Brand, (i, v) => i.Brand = v));
        fields.Add(new(nameof(EquipmentInput.Model), "مدل", i => i.Model, (i, v) => i.Model = v));

        if (EquipmentRules.ShowsSize(Base.Type)) fields.Add(new(nameof(EquipmentInput.SizeText), "سایز", i => i.SizeText, (i, v) => i.SizeText = v, Ltr: true));

        if (Base.HasMouse) fields.Add(new(nameof(EquipmentInput.MouseModel), "مدل موس", i => i.MouseModel, (i, v) => i.MouseModel = v));
        if (Base.HasKeyboard) fields.Add(new(nameof(EquipmentInput.KeyboardModel), "مدل کیبورد", i => i.KeyboardModel, (i, v) => i.KeyboardModel = v));
        if (hub) fields.Add(new(nameof(EquipmentInput.OtherAccessories), "جانبی‌های دیگر", i => i.OtherAccessories, (i, v) => i.OtherAccessories = v));

        fields.Add(new(nameof(EquipmentInput.OwnerUnitId), "واحد صاحب اموال", i => i.OwnerUnitId.ToString(), (i, v) => i.OwnerUnitId = ToGuid(v), FieldKind.Unit));
        fields.Add(new(BuildingKey, "ساختمان", i => i.BuildingId.ToString(), (i, v) => i.BuildingId = ToGuid(v), FieldKind.Building));
        fields.Add(new(FloorKey, "طبقه", i => i.FloorId.ToString(), (i, v) => i.FloorId = ToGuid(v), FieldKind.Floor));
        fields.Add(new(nameof(EquipmentInput.LocationUnitId), "واحد محل", i => i.LocationUnitId.ToString(), (i, v) => i.LocationUnitId = ToGuid(v), FieldKind.Unit));
        fields.Add(new(nameof(EquipmentInput.Room), "اتاق", i => i.Room, (i, v) => i.Room = v));
        fields.Add(new(nameof(EquipmentInput.Station), "استیشن", i => i.Station, (i, v) => i.Station = v));
        fields.Add(new(nameof(EquipmentInput.StationPosition), "جای دقیق", i => i.StationPosition, (i, v) => i.StationPosition = v));
        fields.Add(new(nameof(EquipmentInput.Notes), "یادداشت", i => i.Notes, (i, v) => i.Notes = v));

        _fields = fields;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focused && _step == 1)
        {
            _focused = true;
            await _countInput.FocusAsync();
        }
    }

    private IEnumerable<Option> OptionsFor(BulkField field, BulkRow row) => field.Kind switch
    {
        FieldKind.Building => Buildings
            .Where(b => b.IsActive || b.Id == ToGuid(row.Values[BuildingKey]))
            .Select(b => new Option(b.Id.ToString(), b.Name)),
        FieldKind.Floor => Floors
            .Where(f => f.BuildingId == ToGuid(row.Values[BuildingKey]) && (f.IsActive || f.Id == ToGuid(row.Values[FloorKey])))
            .Select(f => new Option(f.Id.ToString(), f.Name)),
        _ => Units
            .Where(u => u.IsActive || u.Id == ToGuid(row.Values[field.Key]))
            .Select(u => new Option(u.Id.ToString(), u.Name))
    };

    private void OnSelect(BulkRow row, BulkField field, string? value)
    {
        row.Values[field.Key] = value;

        // طبقه‌ی ساختمان قبلی دیگر معتبر نیست. اگر فقط یک طبقه هست، همان را انتخاب می‌کنیم.
        if (field.Kind == FieldKind.Building)
        {
            var floors = Floors.Where(f => f.BuildingId == ToGuid(value) && f.IsActive).ToList();
            row.Values[FloorKey] = floors.Count == 1 ? floors[0].Id.ToString() : Guid.Empty.ToString();
        }
    }

    private void Toggle(string key, bool on)
    {
        if (on)
        {
            _selected.Add(key);
            if (key == BuildingKey) _selected.Add(FloorKey);
        }
        else
        {
            _selected.Remove(key);
        }

        // ستونی که تیکش برداشته شد دوباره از دستگاه اول می‌آید؛ پس «تیک‌نخورده یعنی همه یکی» همیشه درست است.
        if (!on)
        {
            var field = _fields.First(f => f.Key == key);
            foreach (var row in _rows) row.Values[key] = field.Get(Base);
        }
    }

    private BulkRow NewRow(bool isFirst)
    {
        var row = new BulkRow
        {
            // ردیف اول همان شماره‌ای است که کاربر در فرم نوشته؛ برنامه شماره پیشنهاد نمی‌دهد.
            AssetNumber = isFirst ? Base.AssetNumber : null,
            Temporary = Base.UseTemporaryAssetNumber
        };

        foreach (var field in _fields) row.Values[field.Key] = field.Get(Base);

        return row;
    }

    private void SetTemporary(BulkRow row, bool on)
    {
        row.Temporary = on;
        row.Errors = null;
        if (on) row.AssetNumber = null;
    }

    // خطای قدیمی بعد از اصلاح همان ردیف نباید بماند.
    private static void OnAssetChanged(BulkRow row, string? value)
    {
        row.AssetNumber = value;
        row.Errors = null;
    }

    private bool CheckCount()
    {
        _errors = [];

        if (_count >= BulkRules.MinCount && _count <= BulkRules.MaxCount) return true;

        _errors = new() { ["Count"] = [$"تعداد باید بین {Persian(BulkRules.MinCount)} و {Persian(BulkRules.MaxCount)} باشد."] };
        return false;
    }

    private void GoToTable()
    {
        if (!CheckCount()) return;

        ApplyCount();
        _error = null;
        _step = 2;
    }

    // کم و زیاد کردن تعداد، ردیف‌های پرشده را نگه می‌دارد؛ فقط از انتها کم یا به انتها اضافه می‌کند.
    private void ApplyCount()
    {
        if (!CheckCount()) return;

        while (_rows.Count > _count) _rows.RemoveAt(_rows.Count - 1);
        while (_rows.Count < _count) _rows.Add(NewRow(_rows.Count == 0));
    }

    private void AddRow()
    {
        _errors = [];
        _rows.Add(NewRow(_rows.Count == 0));
        _count = _rows.Count;
    }

    private void RemoveRow(BulkRow row)
    {
        _errors = [];
        _rows.Remove(row);
        _count = _rows.Count;
    }

    private EquipmentInput BuildRow(BulkRow row)
    {
        var input = Base.Copy();

        foreach (var field in Chosen) field.Set(input, row.Values[field.Key]);

        input.UseTemporaryAssetNumber = row.Temporary;
        input.AssetNumber = row.Temporary ? null : row.AssetNumber;

        return input;
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;

        _error = null;
        foreach (var row in _rows) row.Errors = null;

        var items = _rows.Select(BuildRow).ToList();

        for (var i = 0; i < items.Count; i++)
        {
            var problems = EquipmentRules.Validate(items[i]);
            if (problems.Count > 0) _rows[i].Errors = problems.Select(p => p.Message).ToArray();
        }

        if (_rows.Any(r => r.Errors is not null))
        {
            _error = "چند ردیف نیاز به اصلاح دارد؛ چیزی ثبت نشد.";
            return;
        }

        _busy = true;
        try
        {
            var result = await EquipmentApi.CreateBulkAsync(new BulkCreateRequest { Items = items });
            if (result.IsSuccess)
            {
                await OnCreated.InvokeAsync(result.Value!);
                return;
            }

            // کلید خطاها از سرور: «شماره‌ی ردیف:فیلد». چیزی ذخیره نشده است.
            foreach (var (key, messages) in result.Problem?.Errors ?? [])
            {
                var separator = key.IndexOf(':');
                if (separator > 0 && int.TryParse(key[..separator], out var index) && index >= 0 && index < _rows.Count)
                {
                    _rows[index].Errors = [.. _rows[index].Errors ?? [], .. messages];
                }
            }

            _error = result.ErrorMessage;
        }
        finally
        {
            _busy = false;
        }
    }
}
