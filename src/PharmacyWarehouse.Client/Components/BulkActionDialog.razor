@* جابه‌جایی یا تغییر وضعیت چند دستگاه انتخاب‌شده در فهرست؛ همه یا هیچ، با تاریخچه‌ی جدا برای هر دستگاه. *@
@inject EquipmentClient EquipmentApi
@inject ApiAuthenticationStateProvider Session

<ModalDialog Title="@Title" Wide="@(Mode == "move")" OnClose="OnClose">
    <p class="muted-line">@JalaliDate.ToPersianDigits(Items.Count.ToString()) دستگاه انتخاب شده: <bdi>@Preview</bdi></p>

    @if (Mode == "move")
    {
        <LocationFields Buildings="Buildings" Floors="Floors" Units="Units" Errors="_errors"
                        @bind-BuildingId="_move.BuildingId"
                        @bind-FloorId="_move.FloorId"
                        @bind-LocationUnitId="_move.LocationUnitId"
                        @bind-Room="_move.Room"
                        @bind-Station="_move.Station"
                        @bind-StationPosition="_move.StationPosition" />

        <div class="form-check mt-3">
            <input id="bulk-move-linked" class="form-check-input" type="checkbox" @bind="_move.MoveLinked" />
            <label class="form-check-label" for="bulk-move-linked">دستگاه‌های متصل به این‌ها هم جابه‌جا شوند</label>
        </div>
    }
    else
    {
        <div class="choice-list" role="radiogroup" aria-label="وضعیت">
            @foreach (var status in Enum.GetValues<EquipmentStatus>())
            {
                <label class="choice @(_status == status ? "selected" : "")">
                    <input class="form-check-input mt-0" type="radio" name="bulk-status" checked="@(_status == status)" @onchange="() => _status = status" />
                    <StatusBadge Status="status" />
                </label>
            }
        </div>
        @if (_status == EquipmentStatus.Retired)
        {
            <div class="form-alert warning mt-3 mb-0">
                <AppIcon Name="warning" />
                <span>با اسقاط، اتصال این دستگاه‌ها به دستگاه‌های دیگر خودکار قطع می‌شود.</span>
            </div>
        }
    }

    <div class="form-field mt-3">
        <label for="bulk-reason">دلیل @(Mode == "status" && _status == EquipmentStatus.Retired ? "(لازم برای اسقاط)" : "(اختیاری)")</label>
        <input id="bulk-reason" class="form-control" @bind="_reason" />
        <FieldError Field="Reason" Errors="_errors" />
    </div>

    @if (_alert is not null)
    {
        <div class="form-alert mt-3" role="alert"><AppIcon Name="warning" /> <span>@_alert</span></div>
    }

    <div class="modal-actions">
        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SubmitAsync">
            @(_busy ? "در حال ذخیره…" : Mode == "move" ? $"جابه‌جایی {JalaliDate.ToPersianDigits(Items.Count.ToString())} دستگاه" : $"تغییر وضعیت {JalaliDate.ToPersianDigits(Items.Count.ToString())} دستگاه")
        </button>
        <button type="button" class="btn btn-quiet" @onclick="OnClose">انصراف</button>
    </div>
</ModalDialog>

@code {
    [Parameter, EditorRequired] public string Mode { get; set; } = "move";
    [Parameter, EditorRequired] public IReadOnlyList<EquipmentListItem> Items { get; set; } = [];
    [Parameter] public IReadOnlyList<BuildingItem> Buildings { get; set; } = [];
    [Parameter] public IReadOnlyList<FloorItem> Floors { get; set; } = [];
    [Parameter] public IReadOnlyList<UnitItem> Units { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnDone { get; set; }

    private readonly BulkMoveRequest _move = new();
    private EquipmentStatus _status = EquipmentStatus.InStorage;
    private string? _reason;
    private bool _busy;
    private string? _alert;
    private Dictionary<string, string[]> _errors = [];

    private string Title => Mode == "move" ? "جابه‌جایی گروهی" : "تغییر وضعیت گروهی";

    private string Preview => string.Join("، ", Items.Take(6).Select(i => i.AssetNumber)) + (Items.Count > 6 ? "، …" : "");

    private List<BulkItem> Selection => Items.Select(i => new BulkItem { Id = i.Id, Version = i.Version }).ToList();

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _busy = true;
        _alert = null;
        _errors = [];

        try
        {
            ApiResult<BulkActionResult> result;
            if (Mode == "move")
            {
                _move.Items = Selection;
                _move.Reason = _reason;
                result = await EquipmentApi.BulkMoveAsync(_move);
            }
            else
            {
                result = await EquipmentApi.BulkStatusAsync(new BulkStatusRequest { Items = Selection, Status = _status, Reason = _reason });
            }

            if (result.IsSuccess)
            {
                await OnDone.InvokeAsync(result.Value!.Changed);
                return;
            }

            _errors = result.Problem?.Errors ?? [];
            _alert = result.Outcome == ApiOutcome.Conflict
                ? "دست‌کم یکی از این دستگاه‌ها هم‌زمان تغییر کرده است. فهرست را تازه کنید و دوباره انتخاب کنید."
                : string.Join(" ", new[] { result.ErrorMessage }.Concat(_errors.Where(e => e.Key == "Items").SelectMany(e => e.Value)));
        }
        finally
        {
            _busy = false;
        }
    }
}
