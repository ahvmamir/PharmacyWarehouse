@implements IDisposable
@inject ApiAuthenticationStateProvider Session
@inject AppInfoState AppInfo
@inject IJSRuntime JS

@* نوار کناری شناور (سمت راست). حالت جمع‌شده (فقط آیکون) و گروه‌های بازشده در localStorage می‌مانند.
   در موبایل کشوی کنار صفحه است و با TopBar باز و بسته می‌شود. *@
@if (_drawerOpen)
{
    <div class="sidebar-backdrop" @onclick="CloseDrawer"></div>
}

<aside class="sidebar @(_collapsed ? "collapsed" : "") @(_drawerOpen ? "drawer-open" : "")" aria-label="منوی اصلی">
    <a class="sidebar-brand" href="" title="@AppInfoResponse.ProductName" @onclick="CloseDrawer">
        <BrandMark />
        <div class="nav-text">
            <strong>@AppInfoResponse.ProductName</strong>
            @if (_organization is not null)
            {
                <small>@_organization</small>
            }
        </div>
    </a>

    <nav class="sidebar-nav">
        @if (Session.CurrentUser is { MustChangePassword: false })
        {
            @* پرکاربردها: بدون عنوان *@
            @if (CanStockIo)
            {
                @Item("stock-io", "upload", "ورود و خروج")
            }
            @if (Session.Can(Permissions.StockView))
            {
                @Item("", "box", "اقلام", NavLinkMatch.All)
            }
            @if (Session.Can(Permissions.DashboardView))
            {
                @Item("dashboard", "dashboard", "داشبورد")
            }

            @if (Session.Can(Permissions.WithdrawalReview) || Session.Can(Permissions.StockReceive) || Session.Can(Permissions.ReportsView))
            {
                @GroupStart("review", "بررسی")
                @if (IsOpen("review"))
                {
                    @if (Session.Can(Permissions.WithdrawalReview))
                    {
                        @Item("review", "check", "بررسی برداشت‌ها")
                    }
                    @if (Session.Can(Permissions.StockReceive))
                    {
                        @Item("receipts/review", "verified", "بررسی ورودها")
                    }
                    @if (Session.Can(Permissions.ReportsView))
                    {
                        @Item("reports", "report", "گزارش‌ها")
                    }
                }
            }

            @if (Session.Can(Permissions.StockView) || Session.Can(Permissions.StockAdjust) || Session.Can(Permissions.ProductsManage) || Session.Can(Permissions.StockReceive) || Session.Can(Permissions.WithdrawalCreate))
            {
                @GroupStart("stock", "انبار")
                @if (IsOpen("stock"))
                {
                    @if (Session.Can(Permissions.StockView))
                    {
                        @Item("locations", "location", "محل‌ها")
                    }
                    @if (Session.Can(Permissions.StockAdjust))
                    {
                        @Item("stocktakes", "scan", "انبارگردانی")
                    }
                    @if (Session.Can(Permissions.ProductsManage))
                    {
                        @Item("labels", "barcode", "برچسب")
                    }
                    @if (Session.Can(Permissions.StockReceive))
                    {
                        @Item("receive", "download", "ورود جنس کامل")
                    }
                    @if (Session.Can(Permissions.WithdrawalCreate))
                    {
                        @Item("my-withdrawals", "history", "برداشت‌های من")
                    }
                }
            }
        }
    </nav>

    <button type="button" class="sidebar-collapse-btn" title="@(_collapsed ? "باز کردن منو" : "جمع کردن منو")"
            aria-label="@(_collapsed ? "باز کردن منو" : "جمع کردن منو")" aria-expanded="@(!_collapsed)" @onclick="ToggleCollapsed">
        <AppIcon Name="chevron" Size="16" />
        <span class="nav-text">جمع کردن منو</span>
    </button>
</aside>

@code {
    private const string ReceiptSubmit = "receipt.submit"; // ثابت Permissions.ReceiptSubmit در بسته‌ی A ساخته می‌شود

    [Parameter] public bool DrawerOpen { get; set; }
    [Parameter] public EventCallback<bool> DrawerOpenChanged { get; set; }

    private bool _drawerOpen;
    private bool _collapsed;
    private string? _organization;
    private readonly HashSet<string> _closedGroups = [];

    private bool CanStockIo => Session.Can(Permissions.WithdrawalCreate) || Session.Can(ReceiptSubmit);

    // در حالت جمع‌شده همه‌ی آیتم‌ها دیده می‌شوند (عنوان گروه نیست که بازش کنند).
    private bool IsOpen(string group) => _collapsed || !_closedGroups.Contains(group);

    private RenderFragment Item(string href, string icon, string text, NavLinkMatch match = NavLinkMatch.Prefix) => __builder =>
    {
        <NavLink class="sidebar-link" href="@href" Match="match" title="@text" aria-label="@text" @onclick="CloseDrawer">
            <AppIcon Name="@icon" /> <span class="nav-text">@text</span>
        </NavLink>
    };

    private RenderFragment GroupStart(string key, string title) => __builder =>
    {
        if (_collapsed)
        {
            <div class="nav-divider" role="separator"></div>
        }
        else
        {
            var open = IsOpen(key);
            <button type="button" class="nav-section" aria-expanded="@open" @onclick="() => ToggleGroupAsync(key)">
                <span>@title</span>
                <AppIcon Name="chevron" Size="14" Class="@(open ? "nav-section-open" : "")" />
            </button>
        }
    };

    protected override void OnParametersSet() => _drawerOpen = DrawerOpen;

    protected override void OnInitialized()
    {
        Session.StatusChanged += OnStatusChanged;
        _ = InvokeAsync(async () =>
        {
            var info = await AppInfo.LoadAsync();
            _organization = info.Organization;
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _collapsed = await JS.InvokeAsync<string?>("localStorage.getItem", "pw-nav-collapsed") == "1";
            var closed = await JS.InvokeAsync<string?>("localStorage.getItem", "pw-nav-closed");
            foreach (var g in (closed ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries)) _closedGroups.Add(g);
            StateHasChanged();
        }
        catch (JSException) { }
    }

    private void OnStatusChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ToggleCollapsed()
    {
        _collapsed = !_collapsed;
        await SaveAsync("pw-nav-collapsed", _collapsed ? "1" : "0");
    }

    private async Task ToggleGroupAsync(string key)
    {
        if (!_closedGroups.Remove(key)) _closedGroups.Add(key);
        await SaveAsync("pw-nav-closed", string.Join(',', _closedGroups));
    }

    private async Task SaveAsync(string key, string value)
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", key, value); }
        catch (JSException) { }
    }

    private async Task CloseDrawer()
    {
        if (!_drawerOpen) return;
        _drawerOpen = false;
        await DrawerOpenChanged.InvokeAsync(false);
    }

    public void Dispose() => Session.StatusChanged -= OnStatusChanged;
}
